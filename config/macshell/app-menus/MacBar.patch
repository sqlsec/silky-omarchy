+            var item = mi(entry[0], shortcut, function () {
+                if (target && target === root.activeTl && validTarget)
+                    root.hlx('hl.dsp.send_shortcut({ mods = "' + parts.join(" ").toUpperCase()
+                             + '", key = "' + key + '", window = "address:' + address + '" })');
+            });
+            item.profileLabel = true;
+            return dis(item, !validTarget);
+        });
