# Silky Omarchy zsh: Oh My Zsh + ys theme, kept fast.
# Installed by scripts/install-zsh.sh as ~/.zshrc. Personal additions go in ~/.zshrc.local.

# ── Omarchy environment (OMARCHY_PATH, PATH, mise shims, ~/.local/bin) ──
[[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap
[[ -r /usr/share/omarchy/default/bash/envs ]] && source /usr/share/omarchy/default/bash/envs

# ── Oh My Zsh ──
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="ys"
# Speed: no update check on start (run `omz update` yourself), no paste/url magic, no compaudit scan.
zstyle ':omz:update' mode disabled
DISABLE_MAGIC_FUNCTIONS=true
ZSH_DISABLE_COMPFIX=true
COMPLETION_WAITING_DOTS=true
HIST_STAMPS="yyyy-mm-dd"
ZSH_COMPDUMP="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-$ZSH_VERSION"
mkdir -p "${ZSH_COMPDUMP:h}"

# Suggestions from history first, then from completion; drawn in a soft grey.
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=40
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=8"
ZSH_AUTOSUGGEST_USE_ASYNC=1

# zsh-completions only adds completion definitions: put them on fpath before compinit (inside oh-my-zsh.sh).
fpath=("${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-completions/src" $fpath)

# zsh-syntax-highlighting must stay last.
plugins=(git sudo zsh-autosuggestions zsh-syntax-highlighting)
source "$ZSH/oh-my-zsh.sh"

# ── Completion feel: case-insensitive, menu with arrow keys, coloured like ls ──
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ── History ──
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS SHARE_HISTORY INC_APPEND_HISTORY

# Right arrow / End accepts the grey suggestion (default); Ctrl+Space too.
bindkey '^ ' autosuggest-accept

# ── Omarchy tools, zsh flavour ──
command -v mise   >/dev/null && eval "$(mise activate zsh)"
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
[[ -r /usr/share/fzf/key-bindings.zsh ]] && source /usr/share/fzf/key-bindings.zsh   # Ctrl+R, Ctrl+T, Alt+C

if command -v eza >/dev/null; then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias lsa='ls -a'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
fi
alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
command -v bat >/dev/null && alias cat='bat --paging=never --style=plain'
alias ..='cd ..'
alias ...='cd ../..'

if [[ -r ~/.zshrc.local ]]; then source ~/.zshrc.local; fi   # an if, so a missing file does not leave the shell starting with status 1
