#!/bin/sh
# Launch Remmina in Simplified Chinese with the Silky macOS stylesheet.
# The theme follows the current MacTahoe appearance at launch; with any other
# GTK theme Remmina keeps the system theme and only the language changes.
set -eu

case $(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null || true) in
  "'MacTahoe-Dark'") GTK_THEME=Silky-Remmina-Dark; export GTK_THEME ;;
  "'MacTahoe-Light'") GTK_THEME=Silky-Remmina-Light; export GTK_THEME ;;
esac

unset LC_ALL
LANGUAGE=zh_CN:en
LC_MESSAGES=zh_CN.UTF-8
export LANGUAGE LC_MESSAGES

# remmina-file-wrapper handles rdp:// and remmina:// links, then runs remmina.
exec /usr/bin/remmina-file-wrapper "$@"
