diff --git i/src/FileAppDialog.qml w/src/FileAppDialog.qml
new file mode 100644
index 0000000..b2793a5
--- /dev/null
+++ w/src/FileAppDialog.qml
@@ -0,0 +1,138 @@
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+
+FolioDialog {
+    id: dialog
+
+    property var target: null
+    property bool makeDefault: false
+    property var apps: []
+    readonly property var filtered: {
+        const query = search.text.trim().toLocaleLowerCase()
+        return query ? apps.filter(app => app.name.toLocaleLowerCase().includes(query)) : apps
+    }
+
+    title: makeDefault ? qsTr("Set Default App") : qsTr("Open With")
+    visible: target !== null
+    onScrimClicked: close()
+    Keys.onEscapePressed: close()
+
+    function open(item, asDefault) {
+        makeDefault = asDefault
+        const recommended = fileOps.appsFor(item.path)
+        const ids = new Set(recommended.map(app => app.id))
+        const others = fileOps.installedFileApps().filter(app => !ids.has(app.id))
+        others.sort((a, b) => a.name.localeCompare(b.name))
+        apps = recommended.concat(others)
+        search.clear()
+        target = item
+        appList.currentIndex = filtered.length > 0 ? 0 : -1
+        appList.positionViewAtBeginning()
+        search.forceActiveFocus()
+    }
+
+    function close() {
+        target = null
+        apps = []
+    }
+
+    function accept() {
+        const app = filtered[appList.currentIndex]
+        if (!target || !app)
+            return
+        const path = target.path
+        close()
+        if (makeDefault)
+            fileOps.setDefaultApp(path, app.id)
+        else
+            fileOps.openWith(path, app.id)
+    }
+
+    Text {
+        Layout.fillWidth: true
+        text: dialog.target ? (dialog.makeDefault ? qsTr("File type: %1").arg(backend.typeName(dialog.target.mime)) : dialog.target.name) : ""
+        color: theme.secondaryForeground
+        elide: Text.ElideMiddle
+    }
+    PlainField {
+        id: search
+        Layout.fillWidth: true
+        placeholderText: qsTr("Search apps")
+        onTextChanged: {
+            appList.currentIndex = dialog.filtered.length > 0 ? 0 : -1
+            appList.positionViewAtBeginning()
+        }
+        onAccepted: dialog.accept()
+        Keys.onDownPressed: appList.incrementCurrentIndex()
+        Keys.onUpPressed: appList.decrementCurrentIndex()
+    }
+    ListView {
+        id: appList
+        Layout.fillWidth: true
+        Layout.preferredHeight: Math.max(64, Math.min(232, dialog.height - 220))
+        clip: true
+        model: dialog.filtered
+        onCurrentIndexChanged: if (currentIndex >= 0) positionViewAtIndex(currentIndex, ListView.Contain)
+        ScrollBar.vertical: FolioScrollBar { }
+        delegate: ItemDelegate {
+            id: entry
+            required property var modelData
+            required property int index
+            width: appList.width
+            height: 34
+            hoverEnabled: true
+            focusPolicy: Qt.NoFocus
+            highlighted: ListView.isCurrentItem
+            text: modelData.isDefault ? qsTr("%1 (default)").arg(modelData.name) : modelData.name
+            onClicked: appList.currentIndex = index
+            background: Rectangle {
+                radius: Math.min(5, theme.radius)
+                color: entry.highlighted ? Qt.alpha(theme.accent, 0.18)
+                       : entry.hovered ? Qt.alpha(theme.foreground, 0.06) : "transparent"
+            }
+            contentItem: RowLayout {
+                spacing: 10
+                Image {
+                    Layout.preferredWidth: 20
+                    Layout.preferredHeight: 20
+                    sourceSize: Qt.size(40, 40)
+                    fillMode: Image.PreserveAspectFit
+                    smooth: true
+                    mipmap: true
+                    asynchronous: true
+                    source: entry.modelData.icon ? "image://app-icon/" + encodeURIComponent(entry.modelData.icon) : ""
+                }
+                Text {
+                    Layout.fillWidth: true
+                    text: entry.text
+                    color: entry.highlighted ? theme.brightForeground : theme.foreground
+                    verticalAlignment: Text.AlignVCenter
+                    elide: Text.ElideRight
+                }
+            }
+        }
+        Text {
+            anchors.centerIn: parent
+            visible: appList.count === 0
+            text: dialog.apps.length === 0 ? qsTr("No apps available") : qsTr("No matches")
+            color: theme.secondaryForeground
+        }
+    }
+
+    RowLayout {
+        Layout.alignment: Qt.AlignRight
+        spacing: 10
+        PlainButton {
+            text: qsTr("Cancel")
+            onClicked: dialog.close()
+        }
+        PlainButton {
+            primary: true
+            enabled: appList.currentIndex >= 0
+            opacity: enabled ? 1 : 0.45
+            text: dialog.makeDefault ? qsTr("Set as Default") : qsTr("Open")
+            onClicked: dialog.accept()
+        }
+    }
+}
