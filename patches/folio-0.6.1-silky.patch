+    "exe": ["terminal-file", "slate"], "appimage": ["terminal-file", "slate"],
+    "deb": ["archive-file", "orange"], "rpm": ["archive-file", "orange"]
+}
+
+function fileAppearance(name, extension, mime, kind) {
+    switch (name.toLowerCase()) {
+    case "dockerfile": return ["terminal-file", "blue"]
+    case "makefile": case "cmakelists.txt": return ["config-file", "teal"]
+    case ".gitignore": case ".gitattributes": return ["config-file", "orange"]
+    case ".editorconfig": return ["config-file", "purple"]
+    case ".env": return ["config-file", "green"]
+    }
+    const suffix = extension.toLowerCase()
+    if (Object.prototype.hasOwnProperty.call(fileAppearances, suffix))
+        return fileAppearances[suffix]
+    if (mime.startsWith("font/") || mime.startsWith("application/x-font-"))
+        return ["font-file", "purple"]
+    if (mime.includes("spreadsheet"))
+        return ["table-file", "green"]
+    if (mime.includes("presentation"))
+        return ["slide-file", "orange"]
+    switch (kind) {
+    case "image": return ["pictures", "teal"]
+    case "video": return ["play", "orange"]
+    case "audio": return ["music", "rose"]
+    case "archive": return ["archive-file", "gold"]
+    case "pdf": return ["text-file", "red"]
+    case "text": return ["text-file", "slate"]
+    default: return ["data-file", "slate"]
+    }
+}
+
+
+function codeInitials(extension) {
+    switch (extension.toLowerCase()) {
+    case "js": case "mjs": case "cjs": return "JS"
+    case "jsx": return "JS"
+    case "ts": case "tsx": return "TS"
+    case "py": case "pyw": return "Py"
+    case "go": return "Go"
+    case "rs": return "Rs"
+    case "rb": return "Rb"
+    case "c": case "h": return "C"
+    case "cpp": case "cc": case "hpp": return "C+"
+    case "cs": return "C#"
+    case "java": return "Ja"
+    case "kt": return "Kt"
+    default: return ""
+    }
+}
