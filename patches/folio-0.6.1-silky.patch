+QPixmap AppIconProvider::requestPixmap(const QString &id, QSize *size, const QSize &requestedSize) {
+    const QString name = QUrl::fromPercentEncoding(id.toUtf8()).trimmed();
+    const QSize target = requestedSize.isValid() && !requestedSize.isEmpty() ? requestedSize : QSize(20, 20);
+    if (name.isEmpty())
+        return {};
+
+    QIcon icon;
+    if (QFileInfo::exists(name)) {
+        icon = QIcon(name);
+    } else {
+        static const QStringList exts = {QStringLiteral(".svg"), QStringLiteral(".png"), QStringLiteral(".xpm")};
+        const QString dataHome = QStandardPaths::writableLocation(QStandardPaths::GenericDataLocation);
+        const QStringList preferredDirs = {
+            dataHome + QStringLiteral("/icons/silky-apps"),
+            dataHome + QStringLiteral("/icons/MacTahoe/apps/scalable"),
+            dataHome + QStringLiteral("/icons/MacTahoe/apps/32"),
+            dataHome + QStringLiteral("/icons/MacTahoe/apps/24"),
+            dataHome + QStringLiteral("/icons/MacTahoe/mimetypes/scalable"),
+        };
+        QStringList nameVariants{name};
+        const QString lower = name.toLower();
+        if (lower != name)
+            nameVariants << lower;
+
+        for (const QString &dir : preferredDirs) {
+            for (const QString &cand : nameVariants) {
+                for (const QString &ext : exts) {
+                    const QString file = dir + QLatin1Char('/') + cand + ext;
+                    if (QFileInfo::exists(file)) {
+                        icon = QIcon(file);
+                        break;
+                    }
+                }
+                if (!icon.isNull())
+                    break;
+            }
+            if (!icon.isNull())
+                break;
+        }
+        if (icon.isNull())
+            icon = QIcon::fromTheme(name);
+        if (icon.isNull()) {
+            const QStringList pixmapDirs = QStandardPaths::locateAll(
+                QStandardPaths::GenericDataLocation, QStringLiteral("pixmaps"), QStandardPaths::LocateDirectory);
+            for (const QString &dir : pixmapDirs) {
+                for (const QString &ext : exts) {
+                    const QString file = dir + QLatin1Char('/') + name + ext;
+                    if (QFileInfo::exists(file)) {
+                        icon = QIcon(file);
+                        break;
+                    }
+                }
+                if (!icon.isNull())
+                    break;
+            }
+        }
+        if (icon.isNull())
+            icon = QIcon::fromTheme(QStringLiteral("application-x-executable"));
+    }
+
+    QPixmap pix = icon.pixmap(target);
+    if (size)
+        *size = pix.size();
+    return pix;
+}
