+#pragma once
+
+#include <QString>
+#include <QStringList>
+#include <QVariantList>
+#include <QVariantMap>
+#include <QVector>
+
+// Native, zero-subprocess parsers for OOXML/ODF/CSV office files and
+// disk-cache helpers for high-fidelity LibreOffice PDF/XLSX conversions.
+namespace OfficePreview {
+
+struct SheetData {
+    QString name;
+    QVector<QStringList> rows;
+    int colCount = 0;
+    QVector<int> colWidths;
+    bool truncated = false;
+};
+
+struct SpreadsheetResult {
+    QVector<SheetData> sheets;
+    QString error;
+};
+
+struct DocumentResult {
+    QString html;
+    bool truncated = false;
+    QString error;
+};
+
+// Classifies an Office/table file by MIME type and file extension fallback.
+// Returns one of: "sheet", "office-doc", "office-xls", "office-pdf", or "".
+QString classify(const QString &mime, const QString &path);
+
+// Fast native parsers (typical runtime: 1-20 ms).
+SpreadsheetResult parseSpreadsheet(const QString &path, const QString &mime = {});
+DocumentResult parseDocument(const QString &path, const QString &mime = {});
+// Compact HTML snippet for the column-view right-hand PreviewPane (1-5 ms).
+QString quickSnippetHtml(const QString &path, const QString &mime = {});
+
+// Converts a parsed spreadsheet into a QML-friendly QVariantList of sheet maps:
+// [{ name, colCount, rowCount, colWidths: [int], rows: [[str]], truncated }]
+QVariantList toVariantSheets(const SpreadsheetResult &result);
+
+// Cache helpers under ~/.cache/folio/office-preview/.
+QString cacheDir();
+QString loProfileDir();
+QString cachePathFor(const QString &sourcePath, const QString &targetExt);
+void pruneCache(qint64 maxBytes = 256LL * 1024 * 1024);
+
+// Returns the path to `soffice` if installed, otherwise empty.
+QString findSoffice();
+
+} // namespace OfficePreview
