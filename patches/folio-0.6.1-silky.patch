+    void listRightClickHitsItemUnderCursorWhenScrolledOrMargined()
+    {
+        QTemporaryDir dir;
+        for (int i = 0; i < 20; ++i)
+            QVERIFY(QDir(dir.path()).mkdir(QString("dir-%1").arg(i, 2, 10, QChar('0'))));
+
+        Backend backend(dir.path());
+        backend.navigate(dir.path());
+        QTRY_COMPARE(backend.folder()->rowCount(), 20);
+        Theme theme(dir.filePath("theme"));
+        FileOps fileOps;
+        Translator translator;
+        Plugins plugins({});
+
+        QQmlEngine engine;
+        engine.rootContext()->setContextProperty("backend", &backend);
+        engine.rootContext()->setContextProperty("theme", &theme);
+        engine.rootContext()->setContextProperty("fileOps", &fileOps);
+        engine.rootContext()->setContextProperty("translator", &translator);
+        engine.rootContext()->setContextProperty("plugins", &plugins);
+        QQmlComponent component(&engine);
+        component.setData(R"(
+            import QtQuick
+            Window {
+                width: 420; height: 240; visible: true
+                property string menuPath: ""
+                property int menuCount: 0
+                property alias list: listView
+                FolderList {
+                    id: listView
+                    anchors.fill: parent
+                    topMargin: 16
+                    onContextMenu: (item, folder, at) => {
+                        menuPath = item ? item.path : ""
+                        menuCount++
+                    }
+                }
+            }
+        )", QUrl::fromLocalFile(sourceFolder() + "/ListRightClickTest.qml"));
+        QVERIFY2(component.isReady(), qPrintable(component.errorString()));
+        std::unique_ptr<QQuickWindow> window(qobject_cast<QQuickWindow *>(component.create()));
+        QVERIFY(window);
+        QVERIFY(QTest::qWaitForWindowExposed(window.get()));
+        auto *list = window->property("list").value<QQuickItem *>();
+        QVERIFY(list);
+
+        // Pre-select row 1, then right-click the upper half of row 2:
+        // with topMargin=16, contentY is -16, so row 2 sits at y=[80, 112).
+        backend.folder()->selectOnly(1);
+        QTest::mouseClick(window.get(), Qt::RightButton, {}, QPoint(120, 84));
+        QTRY_COMPARE(window->property("menuCount").toInt(), 1);
+        QCOMPARE(window->property("menuPath").toString(), dir.filePath("dir-02"));
+        QVERIFY(backend.folder()->isSelected(2));
+
+        // Scroll down and right-click the row visually under y=84:
+        // contentY = 128 puts row 6 (y=192..224 in contentItem) at viewport y=[64, 96).
+        list->setProperty("contentY", 128.0);
+        QTest::mouseClick(window.get(), Qt::RightButton, {}, QPoint(120, 84));
+        QTRY_COMPARE(window->property("menuCount").toInt(), 2);
+        QCOMPARE(window->property("menuPath").toString(), dir.filePath("dir-06"));
+        QVERIFY(backend.folder()->isSelected(6));
+    }
