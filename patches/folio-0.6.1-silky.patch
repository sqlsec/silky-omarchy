+                                radius: 6
+                                color: active
+                                       ? Qt.alpha(theme.accent, 0.18)
+                                       : (tabMouse.containsMouse ? Qt.alpha(theme.foreground, 0.08) : "transparent")
+                                border.width: active ? 1 : 0
+                                border.color: Qt.alpha(theme.accent, 0.4)
+
+                                Text {
+                                    id: tabText
