+void Previewer::prefetchAdjacentOffice() {
+    if (m_officeConverting || m_prefetchProc || m_index < 0 || m_entries.size() < 2)
+        return;
+    const QString soffice = OfficePreview::findSoffice();
+    if (soffice.isEmpty())
+        return;
