+    void officePreviewParsesDocxXlsxCsvAndPptx()
+    {
+        QTemporaryDir dir;
+        auto makeZip = [](const QString &zipPath, const QMap<QString, QByteArray> &files) {
+            QTemporaryDir staging;
+            QStringList rels;
+            for (auto it = files.constBegin(); it != files.constEnd(); ++it) {
+                const QString full = staging.filePath(it.key());
+                QDir().mkpath(QFileInfo(full).absolutePath());
+                QFile f(full);
+                QVERIFY(f.open(QIODevice::WriteOnly));
+                f.write(it.value());
+                rels.append(it.key());
+            }
+            QProcess tar;
+            tar.start("bsdtar", QStringList{"-a", "-cf", zipPath, "--format=zip", "-C", staging.path()} + rels);
+            QVERIFY(tar.waitForFinished() && tar.exitCode() == 0);
+        };
+
+        // 1) DOCX with heading, bold text, and table.
+        const QString docxPath = dir.filePath("sample.docx");
+        makeZip(docxPath, {
+            {"word/document.xml",
+             "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
+             "<w:document xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\">"
+             "<w:body>"
+             "<w:p><w:pPr><w:pStyle w:val=\"Heading1\"/></w:pPr><w:r><w:t>测试标题</w:t></w:r></w:p>"
+             "<w:p><w:r><w:rPr><w:b/></w:rPr><w:t>重点内容</w:t></w:r></w:p>"
+             "<w:tbl><w:tr><w:tc><w:p><w:r><w:t>列一</w:t></w:r></w:p></w:tc>"
+             "<w:tc><w:p><w:r><w:t>列二</w:t></w:r></w:p></w:tc></w:tr></w:tbl>"
+             "</w:body></w:document>"}
+        });
