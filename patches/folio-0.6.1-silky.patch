diff --git i/src/OfficeDocPreview.qml w/src/OfficeDocPreview.qml
new file mode 100644
index 0000000..9e69f47
--- /dev/null
+++ w/src/OfficeDocPreview.qml
@@ -0,0 +1,109 @@
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+
+// Fast native rich-text preview for .docx / .odt / .pptx documents.
+Flickable {
+    id: flick
+    clip: true
+    boundsBehavior: Flickable.StopAtBounds
+
+    property real fontScale: 1.0
+
+    function scroll(direction) {
+        contentY = Math.max(0, Math.min(Math.max(0, contentHeight - height), contentY + direction * 96))
+    }
+    function page(direction) {
+        contentY = Math.max(0, Math.min(Math.max(0, contentHeight - height), contentY + direction * Math.max(160, height - 72)))
+    }
+    function zoomBy(factor) {
+        fontScale = Math.max(0.75, Math.min(2.0, fontScale * factor))
+    }
+    function fit() {
+        fontScale = 1.0
+    }
+
+    WheelHandler {
+        acceptedModifiers: Qt.ControlModifier
+        onWheel: event => {
+            if (event.angleDelta.y !== 0) {
+                flick.zoomBy(event.angleDelta.y > 0 ? 1.1 : 1 / 1.1)
+                event.accepted = true
+            }
+        }
+    }
+
+    contentWidth: width
+    contentHeight: paper.implicitHeight + 48
+
+    Connections {
+        target: previewer
+        function onChanged() {
+            flick.contentY = 0
+        }
+    }
+
+    Rectangle {
+        id: paper
+        width: Math.min(flick.width - 64, 860)
+        x: Math.round((flick.width - width) / 2)
+        y: 24
+        implicitHeight: bodyCol.implicitHeight + 56
+        radius: Math.min(10, theme.radius + 2)
+        color: theme.background
+        border.width: 1
+        border.color: Qt.alpha(theme.foreground, 0.10)
+
+        ColumnLayout {
+            id: bodyCol
+            anchors.left: parent.left
+            anchors.right: parent.right
+            anchors.top: parent.top
+            anchors.margins: 32
+            anchors.topMargin: 28
+            spacing: 16
+
+            TextEdit {
+                id: docText
+                Layout.fillWidth: true
+                readOnly: true
+                selectByMouse: true
+                activeFocusOnPress: false
+                wrapMode: TextEdit.Wrap
+                textFormat: TextEdit.RichText
+                text: previewer.docHtml
+                color: theme.foreground
+                selectionColor: theme.accent
+                selectedTextColor: theme.accentForeground
+                font.pixelSize: Math.round(13.5 * flick.fontScale)
+            }
+
+            Rectangle {
+                Layout.fillWidth: true
+                visible: previewer.docTruncated
+                implicitHeight: truncRow.implicitHeight + 16
+                radius: 6
+                color: Qt.alpha(theme.accent, 0.10)
+
+                RowLayout {
+                    id: truncRow
+                    anchors.fill: parent
+                    anchors.margins: 8
+                    anchors.leftMargin: 12
+                    anchors.rightMargin: 12
+                    spacing: 10
+
+                    Text {
+                        Layout.fillWidth: true
+                        text: qsTr("Showing the opening part for instant preview. Press ⏎ to open.")
+                        color: theme.secondaryForeground
+                        font.pixelSize: 12
+                        wrapMode: Text.Wrap
+                    }
+                }
+            }
+        }
+    }
+
+    ScrollBar.vertical: FolioScrollBar { }
+}
