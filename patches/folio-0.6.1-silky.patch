+    void officePreviewParsesDocxXlsxCsvAndPptx()
+    {
+        QTemporaryDir dir;
+        auto makeZip = [](const QString &zipPath, const QMap<QString, QByteArray> &files) {
+            QTemporaryDir staging;
+            QStringList rels;
+            for (auto it = files.constBegin(); it != files.constEnd(); ++it) {
+                const QString full = staging.filePath(it.key());
+                QDir().mkpath(QFileInfo(full).absolutePath());
+                QFile f(full);
+                QVERIFY(f.open(QIODevice::WriteOnly));
+                f.write(it.value());
+                rels.append(it.key());
+            }
+            QProcess tar;
+            tar.start("bsdtar", QStringList{"-a", "-cf", zipPath, "--format=zip", "-C", staging.path()} + rels);
+            QVERIFY(tar.waitForFinished() && tar.exitCode() == 0);
+        };
+
+        // 1) DOCX with heading, bold text, and table.
+        const QString docxPath = dir.filePath("sample.docx");
+        makeZip(docxPath, {
+            {"word/document.xml",
+             "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
+             "<w:document xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\">"
+             "<w:body>"
+             "<w:p><w:pPr><w:pStyle w:val=\"Heading1\"/></w:pPr><w:r><w:t>测试标题</w:t></w:r></w:p>"
+             "<w:p><w:r><w:rPr><w:b/></w:rPr><w:t>重点内容</w:t></w:r></w:p>"
+             "<w:tbl><w:tr><w:tc><w:p><w:r><w:t>列一</w:t></w:r></w:p></w:tc>"
+             "<w:tc><w:p><w:r><w:t>列二</w:t></w:r></w:p></w:tc></w:tr></w:tbl>"
+             "</w:body></w:document>"}
+        });
+        const auto docRes = OfficePreview::parseDocument(docxPath);
+        QVERIFY(docRes.error.isEmpty());
+        QVERIFY(docRes.html.contains("测试标题"));
+        QVERIFY(docRes.html.contains("<b>重点内容</b>"));
+        QVERIFY(docRes.html.contains("<table"));
+        QVERIFY(docRes.html.contains("列二"));
+
+        // 2) XLSX with shared strings, numbers, Excel serial date, and two sheets.
+        const QString xlsxPath = dir.filePath("sample.xlsx");
+        makeZip(xlsxPath, {
+            {"xl/workbook.xml",
+             "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
+             "<workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" "
+             "xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">"
+             "<sheets>"
+             "<sheet name=\"汇总\" sheetId=\"1\" r:id=\"rId1\"/>"
+             "<sheet name=\"明细\" sheetId=\"2\" r:id=\"rId2\"/>"
+             "</sheets></workbook>"},
+            {"xl/_rels/workbook.xml.rels",
+             "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
+             "<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">"
+             "<Relationship Id=\"rId1\" Target=\"worksheets/sheet1.xml\"/>"
+             "<Relationship Id=\"rId2\" Target=\"worksheets/sheet2.xml\"/>"
+             "</Relationships>"},
+            {"xl/sharedStrings.xml",
+             "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
+             "<sst xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\">"
+             "<si><t>项目</t></si><si><t>日期</t></si><si><t>支付系统</t></si>"
+             "</sst>"},
+            {"xl/styles.xml",
+             "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
+             "<styleSheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\">"
+             "<cellXfs count=\"2\"><xf numFmtId=\"0\"/><xf numFmtId=\"14\"/></cellXfs>"
+             "</styleSheet>"},
+            {"xl/worksheets/sheet1.xml",
+             "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
+             "<worksheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\"><sheetData>"
+             "<row r=\"1\"><c r=\"A1\" t=\"s\"><v>0</v></c><c r=\"B1\" t=\"s\"><v>1</v></c></row>"
+             "<row r=\"2\"><c r=\"A2\" t=\"s\"><v>2</v></c><c r=\"B2\" s=\"1\"><v>46349</v></c></row>"
+             "</sheetData></worksheet>"},
+            {"xl/worksheets/sheet2.xml",
+             "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
+             "<worksheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\"><sheetData>"
+             "<row r=\"1\"><c r=\"A1\" t=\"inlineStr\"><is><t>OK</t></is></c></row>"
+             "</sheetData></worksheet>"}
+        });
+        const auto sheetRes = OfficePreview::parseSpreadsheet(xlsxPath);
+        QVERIFY(sheetRes.error.isEmpty());
+        QCOMPARE(sheetRes.sheets.size(), 2);
+        QCOMPARE(sheetRes.sheets[0].name, QString("汇总"));
+        QCOMPARE(sheetRes.sheets[0].rows[0], QStringList({"项目", "日期"}));
+        QCOMPARE(sheetRes.sheets[0].rows[1], QStringList({"支付系统", "2026-11-23"}));
+        QCOMPARE(sheetRes.sheets[1].name, QString("明细"));
+        QCOMPARE(sheetRes.sheets[1].rows[0], QStringList({"OK"}));
+
+        // 3) CSV with quoted fields and UTF-8 BOM.
+        const QString csvPath = dir.filePath("sample.csv");
+        write(csvPath, "\xEF\xBB\xBF\"Name\",\"Note\"\n\"Alpha\",\"hello, world\"\n");
+        const auto csvRes = OfficePreview::parseSpreadsheet(csvPath);
+        QCOMPARE(csvRes.sheets.size(), 1);
+        QCOMPARE(csvRes.sheets[0].rows.size(), 2);
+        QCOMPARE(csvRes.sheets[0].rows[1], QStringList({"Alpha", "hello, world"}));
+
+        // 4) Previewer loads spreadsheet & docx asynchronously without blocking.
+        Previewer previewer;
+        previewer.start(xlsxPath, false, "name");
+        QTRY_COMPARE(previewer.viewer(), QString("sheet"));
+        QTRY_COMPARE(previewer.sheets().size(), 2);
+
+        previewer.show(docxPath);
+        QTRY_COMPARE(previewer.viewer(), QString("office-doc"));
+        QTRY_VERIFY(previewer.docHtml().contains("测试标题"));
+    }
