+    void newFolderEmitsFolderCreatedForInlineRename()
+    {
+        QTemporaryDir dir;
+        FileOps ops;
+        QSignalSpy created(&ops, &FileOps::folderCreated);
+        ops.newFolder(dir.path());
+        QCOMPARE(created.count(), 1);
+        QCOMPARE(created.at(0).at(0).toString(), dir.path());
+        const QString name = created.at(0).at(1).toString();
+        QVERIFY(!name.isEmpty());
+        QVERIFY(QFileInfo(QDir(dir.path()).filePath(name)).isDir());
+    }
+
+    void renamingOrRemovingExpandedFolderEmitsNoError()
+    {
+        QTemporaryDir dir;
+        const QString alpha = dir.filePath("alpha");
+        QVERIFY(QDir().mkpath(alpha));
+        write(alpha + "/child.txt", "hello");
+
+        FolderModel model;
+        QSignalSpy loaded(&model, &FolderModel::loaded);
+        QSignalSpy failed(&model, &FolderModel::expandFailed);
+        model.setPath(dir.path());
+        QTRY_VERIFY(loaded.count() >= 1);
+
+        const int alphaRow = model.indexOf("alpha");
+        QVERIFY(alphaRow >= 0);
+        model.setExpanded(alphaRow, true);
+        QTRY_VERIFY(model.indexOfPath(alpha + "/child.txt") >= 0);
+
+        FileOps ops;
+        const QString renamed = dir.filePath("alpha-renamed");
+        QCOMPARE(ops.rename(alpha, "alpha-renamed"), QString());
+        model.renamed(alpha, renamed);
+
+        const int beforeReload = loaded.count();
+        model.reload();
+        QTRY_VERIFY(loaded.count() > beforeReload);
+        QCOMPARE(failed.count(), 0);
+        const int renamedRow = model.indexOf("alpha-renamed");
+        QVERIFY(renamedRow >= 0);
+        QVERIFY(model.isExpanded(renamedRow));
+        QVERIFY(model.indexOfPath(renamed + "/child.txt") >= 0);
+
+        // Removing an expanded folder externally closes it quietly without
+        // surfacing a stale "This folder no longer exists." banner.
+        QVERIFY(QDir(renamed).removeRecursively());
+        const int beforeDeleteReload = loaded.count();
+        model.reload();
+        QTRY_VERIFY(loaded.count() > beforeDeleteReload);
+        QCOMPARE(failed.count(), 0);
+        QCOMPARE(model.indexOfPath(renamed), -1);
+    }
