+static QString iconForApp(GAppInfo *app) {
+    GIcon *icon = g_app_info_get_icon(app);
+    if (!icon)
+        return {};
+    if (G_IS_THEMED_ICON(icon)) {
+        const char *const *names = g_themed_icon_get_names(G_THEMED_ICON(icon));
+        QString first;
+        for (int i = 0; names && names[i]; ++i) {
+            const QString candidate = QString::fromUtf8(names[i]);
+            if (first.isEmpty())
+                first = candidate;
+            if (QIcon::hasThemeIcon(candidate))
+                return candidate;
+        }
+        return first;
+    }
+    if (G_IS_FILE_ICON(icon)) {
+        if (GFile *file = g_file_icon_get_file(G_FILE_ICON(icon))) {
+            if (char *path = g_file_get_path(file)) {
+                QString out = QString::fromUtf8(path);
+                g_free(path);
+                return out;
+            }
+        }
+    }
+    if (char *str = g_icon_to_string(icon)) {
+        QString out = QString::fromUtf8(str);
+        g_free(str);
+        return out;
+    }
+    return {};
+}
