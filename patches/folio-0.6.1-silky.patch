+    writer.setQuality(100);
+    if (!writer.write(image))
+        return {};
+    snapshot->close();
+
+    const QString name = QStringLiteral("silky-folio-dock-snapshot");
+    if (auto *previous = window->findChild<QTemporaryFile *>(name, Qt::FindDirectChildrenOnly))
+        previous->deleteLater();
+    snapshot->setObjectName(name);
+    snapshot->setParent(window);
+    return snapshot.release()->fileName();
+}
+
+bool Windows::windowLayoutsAvailable() const {
+    return !qEnvironmentVariableIsEmpty("HYPRLAND_INSTANCE_SIGNATURE")
+        && !QStandardPaths::findExecutable("hyprctl").isEmpty();
+}
+
+void Windows::startWindowDrag(QObject *window) {
+    auto *target = qobject_cast<QQuickWindow *>(window);
+    if (!target || !target->startSystemMove() || !windowLayoutsAvailable())
+        return;
+
+    QProcess::startDetached("hyprctl", {"eval", QStringLiteral("o.silky_folio_begin_drag(%1)")
+        .arg(QCoreApplication::applicationPid())});
+}
+
+void Windows::controlWindow(QObject *window, const QString &action) {
+    auto *target = qobject_cast<QQuickWindow *>(window);
+    if (!target || !target->isActive())
+        return;
+
+    const bool minimize = action == "minimize";
+    const bool fullScreen = action == "fullscreen";
+    static const QStringList placements{
+        "left", "right", "top", "bottom", "top-left", "top-right", "bottom-left", "bottom-right"
+    };
+    const bool placement = placements.contains(action);
+    if ((!minimize && !fullScreen && !placement && action != "maximized")
+            || ((minimize || placement) && target->visibility() == QWindow::FullScreen))
+        return;
+
+    const QString hyprctl = qEnvironmentVariableIsEmpty("HYPRLAND_INSTANCE_SIGNATURE")
+        ? QString() : QStandardPaths::findExecutable("hyprctl");
+    if (hyprctl.isEmpty()) {
+        if (placement)
+            return;
+        if (minimize)
+            target->showMinimized();
+        else if (target->visibility() == (fullScreen ? QWindow::FullScreen : QWindow::Maximized))
+            target->showNormal();
+        else if (fullScreen)
+            target->showFullScreen();
+        else
+            target->showMaximized();
+        return;
+    }
+
+    // Hyprland handles placement itself. Use the compositor's address for
+    // the clicked, still-focused Folio window to avoid acting on another app.
+    auto *query = new QProcess(this);
+    connect(query, &QProcess::errorOccurred, query, &QObject::deleteLater);
+    connect(query, &QProcess::finished, query,
+            [query, target = QPointer<QQuickWindow>(target), hyprctl, action, minimize, fullScreen, placement](int code, QProcess::ExitStatus status) {
+        query->deleteLater();
+        if (code != 0 || status != QProcess::NormalExit || !target || !target->isActive())
+            return;
+        const auto client = QJsonDocument::fromJson(query->readAllStandardOutput()).object();
+        const auto address = client.value("address").toString();
+        static const QRegularExpression validAddress(QStringLiteral("^0x[0-9a-fA-F]+$"));
+        if (client.value("pid").toInteger() != QCoreApplication::applicationPid()
+                || client.value("class").toString() != QStringLiteral("folio")
+                || !validAddress.match(address).hasMatch())
+            return;
+
+        if ((minimize || placement) && client.value("fullscreen").toInt() >= 2)
+            return;
+
+        if (placement) {
+            QProcess::startDetached(hyprctl, {"eval",
+                QStringLiteral("o.silky_folio_place(\"%1\", \"%2\")").arg(address, action)});
+        } else if (minimize) {
+            auto *request = new QProcess(query->parent());
+            // Leave recovery to the regular Omarchy Dock when MacShell is absent.
+            const auto fallback = [address] {
+                QProcess::startDetached("omarchy-hyprland-window-minimize", {address});
+            };
+            connect(request, &QProcess::errorOccurred, request, [request, fallback](QProcess::ProcessError error) {
+                if (error != QProcess::FailedToStart)
+                    return;
+                fallback();
+                request->deleteLater();
+            });
+            connect(request, &QProcess::finished, request, [request, fallback](int exitCode, QProcess::ExitStatus exitStatus) {
+                if (exitCode != 0 || exitStatus != QProcess::NormalExit || request->readAllStandardOutput().trimmed() != "true")
+                    fallback();
+                request->deleteLater();
+            });
+            auto submitted = std::make_shared<bool>(false);
+            const auto send = [request, address, target, submitted](const QImage &image = {}) {
+                if (std::exchange(*submitted, true))
+                    return;
+                if (!target || !target->isActive()) {
+                    request->deleteLater();
+                    return;
+                }
+                const QString snapshot = snapshotForDock(target, image);
+                QStringList args{"-c", "MacShell", "ipc", "call", "window"};
+                if (snapshot.isEmpty())
+                    args << "minimizeFolio" << address;
+                else
+                    args << "minimizeFolioSnapshot" << address << snapshot;
+                request->start("qs", args);
+                QTimer::singleShot(1000, request, [request] {
+                    if (request->state() != QProcess::NotRunning)
+                        request->kill();
+                });
+            };
+
+            // Capture a bounded frame asynchronously, without grabbing an
+            // entire high-DPI window on the GUI thread.
+            QSize captureSize = target->size();
+            const qreal scale = target->effectiveDevicePixelRatio();
+            const QSize limit(qRound(1152 / scale), qRound(768 / scale));
+            if (captureSize.width() > limit.width() || captureSize.height() > limit.height())
+                captureSize.scale(limit, Qt::KeepAspectRatio);
+            const auto capture = target->contentItem()->grabToImage(captureSize);
+            if (capture) {
+                connect(capture.data(), &QQuickItemGrabResult::ready, request, [capture, send, submitted] {
+                    if (!*submitted)
+                        send(capture->image());
+                });
+                QTimer::singleShot(220, request, [send] { send(); });
+            } else {
+                send();
+            }
+        } else {
+            QProcess::startDetached(hyprctl, {"dispatch",
+                QStringLiteral("hl.dsp.window.fullscreen({ mode = \"%1\", action = \"toggle\", window = \"address:%2\" })")
+                    .arg(fullScreen ? QStringLiteral("fullscreen") : QStringLiteral("maximized"), address)});
+        }
+    });
+    query->start(hyprctl, {"activewindow", "-j"});
+    QTimer::singleShot(500, query, [query] { if (query->state() != QProcess::NotRunning) query->kill(); });
+}
