+// Legacy Windows ZIP archives often store non-ASCII filenames in a local code
+// page (such as GB18030/GBK) without setting ZIP's UTF-8 flag (bit 11). On a
+// UTF-8 Linux system, bsdtar writes those raw bytes verbatim, producing invalid
+// UTF-8 filenames that Qt's QDir::entryList() then skips. Inspect the ZIP
+// central directory and pick a matching hdrcharset only when non-UTF-8 legacy
+// entry names are actually present.
+static QString detectZipHeaderCharset(const QString &archive) {
+    QFile file(archive);
+    if (!file.open(QIODevice::ReadOnly))
+        return {};
+    const qint64 fileSize = file.size();
+    if (fileSize < 22)
+        return {};
+
+    const qint64 tailSize = qMin<qint64>(fileSize, 65557);
+    if (!file.seek(fileSize - tailSize))
+        return {};
+    const QByteArray tail = file.read(tailSize);
+    if (tail.size() < 22)
+        return {};
+
+    qsizetype eocdPos = -1;
+    for (qsizetype pos = tail.size() - 22; pos >= 0; --pos) {
+        if (readLe<quint32>(tail, pos) == 0x06054b50u) {
+            const quint16 commentLen = readLe<quint16>(tail, pos + 20);
+            if (pos + 22 + commentLen == tail.size()) {
+                eocdPos = pos;
+                break;
+            }
+        }
+    }
+    if (eocdPos < 0)
+        return {};
+
+    quint64 cdSize = readLe<quint32>(tail, eocdPos + 12);
+    quint64 cdOffset = readLe<quint32>(tail, eocdPos + 16);
+    if (cdSize == 0xFFFFFFFFu || cdOffset == 0xFFFFFFFFu) {
+        if (eocdPos < 20 || readLe<quint32>(tail, eocdPos - 20) != 0x07064b50u)
+            return {};
+        const quint64 zip64EocdOffset = readLe<quint64>(tail, eocdPos - 12);
+        if (zip64EocdOffset > quint64(fileSize) || quint64(fileSize) - zip64EocdOffset < 56)
+            return {};
+        if (!file.seek(qint64(zip64EocdOffset)))
+            return {};
+        const QByteArray zip64 = file.read(56);
+        if (zip64.size() < 56 || readLe<quint32>(zip64, 0) != 0x06064b50u)
+            return {};
+        cdSize = readLe<quint64>(zip64, 40);
+        cdOffset = readLe<quint64>(zip64, 48);
+    }
+
+    if (cdOffset > quint64(fileSize) || cdSize > quint64(fileSize) - cdOffset || cdSize > 16u * 1024u * 1024u)
+        return {};
+    if (!file.seek(qint64(cdOffset)))
+        return {};
+    const QByteArray cd = file.read(qint64(cdSize));
+    if (quint64(cd.size()) != cdSize)
+        return {};
+
+    QList<QByteArray> samples;
+    bool hasInvalidUtf8 = false;
+    qsizetype pos = 0;
+    while (pos + 46 <= cd.size()) {
+        if (readLe<quint32>(cd, pos) != 0x02014b50u)
+            break;
+        const quint16 flags = readLe<quint16>(cd, pos + 8);
+        const quint16 nameLen = readLe<quint16>(cd, pos + 28);
+        const quint16 extraLen = readLe<quint16>(cd, pos + 30);
+        const quint16 commentLen = readLe<quint16>(cd, pos + 32);
+        const qsizetype next = pos + 46 + nameLen + extraLen + commentLen;
+        if (next > cd.size())
+            break;
+        if ((flags & 0x0800u) == 0 && nameLen > 0) {
+            const QByteArray raw = cd.mid(pos + 46, nameLen);
+            bool hasNonAscii = false;
+            for (char c : raw) {
+                if (static_cast<uchar>(c) >= 0x80) {
+                    hasNonAscii = true;
+                    break;
+                }
+            }
+            if (hasNonAscii) {
+                if (!isValidUtf8(raw))
+                    hasInvalidUtf8 = true;
+                if (samples.size() < 256)
+                    samples << raw;
+                if (hasInvalidUtf8 && samples.size() >= 256)
+                    break;
+            }
+        }
+        pos = next;
+    }
+
+    if (!hasInvalidUtf8 || samples.isEmpty())
+        return {};
+
+    const QString locale = QLocale::system().name();
+    QList<const char *> candidates;
+    if (locale.startsWith("zh_TW") || locale.startsWith("zh_HK") || locale.startsWith("zh_MO"))
+        candidates = {"BIG5", "GB18030", "SHIFT_JIS", "EUC-KR", "CP1252", "CP437"};
+    else if (locale.startsWith("ja"))
+        candidates = {"SHIFT_JIS", "GB18030", "BIG5", "EUC-KR", "CP1252", "CP437"};
+    else if (locale.startsWith("ko"))
+        candidates = {"EUC-KR", "GB18030", "BIG5", "SHIFT_JIS", "CP1252", "CP437"};
+    else
+        candidates = {"GB18030", "BIG5", "SHIFT_JIS", "EUC-KR", "CP1252", "CP437"};
+
+    for (const char *charset : candidates) {
+        if (canConvertCharset(charset, samples))
+            return QString::fromLatin1(charset);
+    }
+    return {};
+}
