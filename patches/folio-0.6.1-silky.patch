+template <typename T>
+static T readLe(const QByteArray &bytes, qsizetype offset) {
+    T value{};
+    if (offset >= 0 && offset + qsizetype(sizeof(T)) <= bytes.size()) {
+        std::memcpy(&value, bytes.constData() + offset, sizeof(T));
+        value = qFromLittleEndian(value);
