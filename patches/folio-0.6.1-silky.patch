--- /dev/null
+++ w/src/menu_glass.frag
@@ -0,0 +1,86 @@
+#version 440
+
+layout(location = 0) in vec2 qt_TexCoord0;
+layout(location = 0) out vec4 fragColor;
+
+layout(std140, binding = 0) uniform buf {
+    mat4 qt_Matrix;
+    float qt_Opacity;
+    vec2 uSize;     // logical px of the menu
+    float uPad;     // logical px padding around the menu inside source texture
+    float uRadius;  // logical corner radius
+    float uDark;    // 0.0 light, 1.0 dark
+    float uScale;   // device pixel ratio
+};
+
+layout(binding = 1) uniform sampler2D uBack;
+
+const int TAPS = 24;
+const float GOLDEN = 2.39996323;
+
+vec3 sampleBack(vec2 menuPos) {
+    vec2 srcSize = uSize + vec2(uPad * 2.0);
+    vec2 uv = (menuPos + vec2(uPad)) / max(srcSize, vec2(1.0));
+    return texture(uBack, clamp(uv, vec2(0.001), vec2(0.999))).rgb;
+}
+
+float ign(vec2 p) {
+    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
+}
+
+float hash12(vec2 p) {
+    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
+    p3 += dot(p3, p3.yzx + 33.33);
+    return fract((p3.x + p3.y) * p3.z);
+}
+
+float roundBox(vec2 q, vec2 hs, float r) {
+    vec2 d = abs(q) - (hs - r);
+    return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0) - r;
+}
+
+void main() {
+    vec2 pos = qt_TexCoord0 * uSize;
+    vec2 hs = uSize * 0.5;
+    vec2 q = pos - hs;
+    float r = min(uRadius, min(hs.x, hs.y));
+    float sd = roundBox(q, hs, r);
+    float cov = clamp(0.5 - sd * max(uScale, 1.0), 0.0, 1.0);
+    if (cov <= 0.0) {
+        fragColor = vec4(0.0);
+        return;
+    }
+
+    // Pure, distortion-free Gaussian frosted blur matching Folio's translucent sidebar.
+    float blurR = 20.0;
+    float rot = ign(pos * uScale) * 6.2831853;
+    vec3 acc = vec3(0.0);
+    float ws = 0.0;
+    for (int i = 0; i < TAPS; ++i) {
+        float fi = float(i) + 0.5;
+        float rad = sqrt(fi / float(TAPS));
+        float ang = fi * GOLDEN + rot;
+        float w = exp(-2.0 * rad * rad);
+        vec2 o = vec2(cos(ang), sin(ang)) * rad * blurR;
+        acc += sampleBack(pos + o) * w;
+        ws += w;
+    }
+    vec3 col = acc / ws;
+
+    // Gentle vibrancy and clean sidebar-matched tint so text stays effortlessly readable.
+    float lum = dot(col, vec3(0.2126, 0.7152, 0.0722));
+    col = mix(vec3(lum), col, 1.12);
+    vec3 tintC = mix(vec3(0.975, 0.978, 0.985), vec3(0.145, 0.148, 0.160), uDark);
+    col = mix(col, tintC, mix(0.76, 0.76, uDark));
+
+    // Crisp, understated 1 px hairline border without heavy glow or outer slabs.
+    float t = max(-sd, 0.0);
+    float edge = exp(-pow((t - 0.5) / 0.42, 2.0));
+    vec3 borderCol = mix(vec3(0.0, 0.0, 0.0), vec3(1.0, 1.0, 1.0), uDark);
+    col = mix(col, borderCol, edge * mix(0.10, 0.14, uDark));
+
+    float gn = hash12(pos * uScale) + hash12(pos * uScale * 1.7 + 17.0) - 1.0;
+    col = clamp(col + gn * 0.0025, 0.0, 1.0);
+    float a = cov * qt_Opacity;
+    fragColor = vec4(col * a, a);
+}
