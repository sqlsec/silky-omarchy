diff --git i/src/FileTypeIcon.qml w/src/FileTypeIcon.qml
new file mode 100644
index 0000000..6b4e8ce
--- /dev/null
+++ w/src/FileTypeIcon.qml
@@ -0,0 +1,89 @@
+import QtQuick
+import QtQuick.Shapes
+import "Format.js" as Format
+
+// A neutral folded sheet with a colored symbol for its file type.
+Item {
+    id: icon
+
+    property string fileName: ""
+    property string extension: ""
+    property string mime: ""
+    property string kind: ""
+    property real size: 20
+    readonly property var appearance: Format.fileAppearance(fileName, extension, mime, kind)
+    readonly property color ink: {
+        const tones = {
+            blue:   ["#2660A5", "#8ABCFF"],
+            teal:   ["#146C72", "#71D5D7"],
+            green:  ["#276B49", "#85D6AB"],
+            purple: ["#6546AA", "#C2ACFF"],
+            rose:   ["#A03969", "#FFA7CC"],
+            red:    ["#AE383E", "#FFA0A0"],
+            orange: ["#994713", "#FFB780"],
+            gold:   ["#85600D", "#E9CA74"],
+            slate:  ["#536176", "#B4C3D8"]
+        }
+        return tones[appearance[1]][theme.light ? 0 : 1]
+    }
+    readonly property bool labeled: size >= 48 && extension.length > 0
+    readonly property string initials: size < 48 && appearance[0] === "code-file"
+                                       ? Format.codeInitials(extension) : ""
+
+    implicitWidth: size
+    implicitHeight: size
+
+    Shape {
+        anchors.fill: parent
+        preferredRendererType: Shape.CurveRenderer
+        ShapePath {
+            scale: Qt.size(icon.size / 24, icon.size / 24)
+            strokeWidth: icon.size <= 24 ? 1 : 1.3
+            strokeColor: Qt.alpha(icon.ink, theme.light ? 0.62 : 0.66)
+            fillColor: Qt.tint(theme.background, Qt.alpha(icon.ink, theme.light ? 0.085 : 0.12))
+            joinStyle: ShapePath.RoundJoin
+            PathSvg { path: "M6.5 2H14.2L19 6.8V20.2Q19 22 17.2 22H6.8Q5 22 5 20.2V3.5Q5 2 6.5 2Z" }
+        }
+        ShapePath {
+            scale: Qt.size(icon.size / 24, icon.size / 24)
+            strokeWidth: icon.size <= 24 ? 0.8 : 1
+            strokeColor: Qt.alpha(icon.ink, 0.6)
+            fillColor: Qt.alpha(icon.ink, 0.2)
+            joinStyle: ShapePath.RoundJoin
+            PathSvg { path: "M14.2 2L19 6.8H15.2Q14.2 6.8 14.2 5.8Z" }
+        }
+    }
+
+    Glyph {
+        anchors.horizontalCenter: parent.horizontalCenter
+        y: icon.size * (icon.labeled ? 0.31 : 0.35)
+        visible: icon.initials.length === 0
+        name: icon.appearance[0]
+        size: icon.size * 0.47
+        stroke: icon.size <= 24 ? 1.05 : 1.75
+        color: icon.ink
+    }
+
+    Text {
+        visible: icon.initials.length > 0
+        anchors.horizontalCenter: parent.horizontalCenter
+        y: icon.size * 0.44
+        text: icon.initials
+        font.pixelSize: icon.size * 0.34
+        font.weight: Font.Bold
+        color: icon.ink
+    }
+
+    Text {
+        visible: icon.labeled
+        anchors.horizontalCenter: parent.horizontalCenter
+        y: icon.size * 0.73
+        width: icon.size * 0.52
+        text: icon.extension.toUpperCase()
+        horizontalAlignment: Text.AlignHCenter
+        elide: Text.ElideRight
+        font.pixelSize: icon.size * 0.105
+        font.weight: Font.DemiBold
+        color: icon.ink
+    }
+}
