+        if (candidate < 0 || candidate >= m_entries.size())
+            continue;
+        const FolderModel::Entry &sib = m_entries.at(candidate);
+        if (sib.isDir)
+            continue;
+        const QString kind = OfficePreview::classify(sib.mime, sib.path);
+        if (kind == QLatin1String("office-pdf")) {
+            const QString cached = OfficePreview::cachePathFor(sib.path, QStringLiteral("pdf"));
+            if (!QFileInfo::exists(cached)) {
+                targetPath = sib.path;
+                targetExt = QStringLiteral("pdf");
+                break;
+            }
+        } else if (kind == QLatin1String("office-xls")) {
+            const QString cached = OfficePreview::cachePathFor(sib.path, QStringLiteral("xlsx"));
+            if (!QFileInfo::exists(cached)) {
+                targetPath = sib.path;
+                targetExt = QStringLiteral("xlsx");
+                break;
+            }
+        }
+    }
+    if (targetPath.isEmpty())
+        return;
+
+    QDir().mkpath(OfficePreview::cacheDir());
+    QDir().mkpath(OfficePreview::loProfileDir());
+    QFile::remove(OfficePreview::loProfileDir() + QStringLiteral("/.lock"));
+
+    QTemporaryDir tempDir(OfficePreview::cacheDir() + QStringLiteral("/pre-XXXXXX"));
+    if (!tempDir.isValid())
+        return;
+    tempDir.setAutoRemove(false);
+    m_prefetchTempDir = tempDir.path();
+
+    const QString outDir = m_prefetchTempDir;
+    const QString cacheTarget = OfficePreview::cachePathFor(targetPath, targetExt);
+    const QString profileUrl = QUrl::fromLocalFile(OfficePreview::loProfileDir()).toString();
+
+    auto *proc = new QProcess(this);
+    proc->setChildProcessModifier([] { ::setsid(); });
+    m_prefetchProc = proc;
+    auto *timeout = new QTimer(proc);
+    timeout->setSingleShot(true);
+    connect(timeout, &QTimer::timeout, proc, [proc] { killProcessGroup(proc); });
+    timeout->start(30000);
+
+    connect(proc, QOverload<int, QProcess::ExitStatus>::of(&QProcess::finished), this,
+            [this, proc, outDir, cacheTarget, targetExt](int exitCode, QProcess::ExitStatus exitStatus) {
+                if (m_prefetchProc == proc)
+                    m_prefetchProc = nullptr;
+                proc->deleteLater();
+                if (exitStatus == QProcess::NormalExit && exitCode == 0) {
+                    const QFileInfoList files = QDir(outDir).entryInfoList(
+                        {QStringLiteral("*.") + targetExt}, QDir::Files);
+                    if (!files.isEmpty()) {
+                        const QString produced = files.first().absoluteFilePath();
+                        QFile::remove(cacheTarget);
+                        if (!QFile::rename(produced, cacheTarget))
+                            QFile::copy(produced, cacheTarget);
+                        QThreadPool::globalInstance()->start([] { OfficePreview::pruneCache(); });
+                    }
+                }
+                QDir(outDir).removeRecursively();
+                if (m_prefetchTempDir == outDir)
+                    m_prefetchTempDir.clear();
+            });
+
+    QStringList args = {
+        QStringLiteral("--headless"),
+        QStringLiteral("--nologo"),
+        QStringLiteral("--nofirststartwizard"),
+        QStringLiteral("--norestore"),
+        QStringLiteral("-env:UserInstallation=") + profileUrl,
+        QStringLiteral("--convert-to"),
+        targetExt,
+        QStringLiteral("--outdir"),
+        outDir,
+        targetPath,
+    };
+    proc->start(soffice, args);
+}
