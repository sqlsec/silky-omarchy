diff --git i/src/FilePropertiesDialog.qml w/src/FilePropertiesDialog.qml
new file mode 100644
index 0000000..799ae8d
--- /dev/null
+++ w/src/FilePropertiesDialog.qml
@@ -0,0 +1,235 @@
+import QtQuick
+import QtQuick.Layouts
+import "Format.js" as Format
+
+FolioDialog {
+    id: dialog
+
+    property var info: null
+    property real folderBytes: -1
+    property int folderFiles: 0
+    property int folderDirs: 0
+    property bool calculating: false
+
+    visible: info !== null
+    title: qsTr("Properties")
+    cardWidth: 460
+    edge: Qt.alpha(theme.foreground, 0.16)
+    spacing: 14
+
+    onScrimClicked: close()
+    Keys.onEscapePressed: close()
+    Keys.onReturnPressed: close()
+    Keys.onEnterPressed: close()
+
+    function open(target) {
+        if (!target || !target.path)
+            return
+        fileOps.cancelFolderSize()
+        folderBytes = -1
+        folderFiles = 0
+        folderDirs = 0
+        info = fileOps.propertiesFor(target.path)
+        calculating = !!info && info.isDir === true
+        if (calculating)
+            fileOps.calculateFolderSize(target.path)
+        forceActiveFocus()
+    }
+
+    function close() {
+        fileOps.cancelFolderSize()
+        calculating = false
+        info = null
+    }
+
+    Connections {
+        target: fileOps
+        function onFolderSizeUpdated(path, bytes, files, dirs, finished) {
+            if (!dialog.info || dialog.info.path !== path)
+                return
+            dialog.folderBytes = bytes
+            dialog.folderFiles = files
+            dialog.folderDirs = dirs
+            dialog.calculating = !finished
+        }
+    }
+
+    component PropRow: RowLayout {
+        property string label
+        property string value
+        property bool middleElide: false
+        visible: value.length > 0
+        Layout.fillWidth: true
+        spacing: 14
+
+        Text {
+            Layout.preferredWidth: 82
+            text: label
+            color: theme.secondaryForeground
+            font.pixelSize: 12
+            horizontalAlignment: Text.AlignRight
+            elide: Text.ElideRight
+        }
+        Text {
+            Layout.fillWidth: true
+            text: value
+            color: theme.foreground
+            font.pixelSize: 12
+            elide: middleElide ? Text.ElideMiddle : Text.ElideRight
+        }
+    }
+
+    RowLayout {
+        Layout.fillWidth: true
+        spacing: 14
+
+        Item {
+            Layout.preferredWidth: 48
+            Layout.preferredHeight: 48
+
+            Image {
+                anchors.fill: parent
+                visible: !!dialog.info && dialog.info.isDir
+                source: theme.silkyFolderIcon
+                sourceSize: Qt.size(96, 96)
+                fillMode: Image.PreserveAspectFit
+                smooth: true
+                mipmap: true
+            }
+            FileTypeIcon {
+                anchors.centerIn: parent
+                visible: !!dialog.info && !dialog.info.isDir
+                size: 44
+                mime: dialog.info ? (dialog.info.mime || "") : ""
+                extension: dialog.info ? (dialog.info.extension || "") : ""
+            }
+        }
+
+        ColumnLayout {
+            Layout.fillWidth: true
+            spacing: 3
+
+            Text {
+                Layout.fillWidth: true
+                text: dialog.info ? (dialog.info.name || "") : ""
+                color: theme.brightForeground
+                font.pixelSize: 15
+                font.weight: Font.DemiBold
+                elide: Text.ElideMiddle
+            }
+            Text {
+                Layout.fillWidth: true
+                text: {
+                    if (!dialog.info)
+                        return ""
+                    if (!dialog.info.isDir)
+                        return Format.size(dialog.info.size || 0)
+                    const itemsText = qsTr("%Ln items", "", dialog.info.itemCount || 0)
+                    if (dialog.folderBytes >= 0)
+                        return Format.size(dialog.folderBytes) + "  ·  " + itemsText
+                    return dialog.calculating ? qsTr("Calculating…") + "  ·  " + itemsText : itemsText
+                }
+                color: theme.secondaryForeground
+                font.pixelSize: 12
+            }
+        }
+    }
+
+    Rectangle {
+        Layout.fillWidth: true
+        implicitHeight: details.implicitHeight + 24
+        radius: Math.min(8, theme.radius)
+        color: theme.darkBackground
+        border.width: 1
+        border.color: Qt.alpha(theme.foreground, 0.1)
+
+        ColumnLayout {
+            id: details
+            anchors.fill: parent
+            anchors.margins: 12
+            spacing: 8
+
+            PropRow {
+                label: qsTr("Kind")
+                value: dialog.info
+                    ? (dialog.info.mime && dialog.info.mime !== dialog.info.kind
+                        ? dialog.info.kind + " (" + dialog.info.mime + ")"
+                        : (dialog.info.kind || ""))
+                    : ""
+            }
+            PropRow {
+                label: qsTr("Location")
+                value: dialog.info ? (dialog.info.parent || "") : ""
+                middleElide: true
+            }
+            PropRow {
+                label: qsTr("Size")
+                value: {
+                    if (!dialog.info)
+                        return ""
+                    if (!dialog.info.isDir)
+                        return Format.size(dialog.info.size || 0) + " (" + Number(dialog.info.size || 0).toLocaleString() + " B)"
+                    if (dialog.folderBytes < 0)
+                        return qsTr("Calculating…")
+                    const formatted = Format.size(dialog.folderBytes) + " (" + Number(dialog.folderBytes).toLocaleString() + " B)"
+                    return dialog.calculating ? formatted + "…" : formatted
+                }
+            }
+            PropRow {
+                label: qsTr("Contents")
+                visible: !!dialog.info && dialog.info.isDir
+                value: {
+                    if (!dialog.info || !dialog.info.isDir)
+                        return ""
+                    const base = qsTr("%Ln items", "", dialog.info.itemCount || 0)
+                    if (dialog.folderBytes < 0)
+                        return base
+                    const total = dialog.folderFiles + dialog.folderDirs
+                    if (total === (dialog.info.itemCount || 0))
+                        return base
+                    return base + " (" + qsTr("%Ln items", "", total) + ")"
+                }
+            }
+            PropRow {
+                label: qsTr("Modified")
+                value: dialog.info && dialog.info.modified ? Format.stamp(dialog.info.modified) : ""
+            }
+            PropRow {
+                label: qsTr("Created")
+                value: dialog.info && dialog.info.created ? Format.stamp(dialog.info.created) : ""
+            }
+            PropRow {
+                label: qsTr("Permissions")
+                value: dialog.info ? (dialog.info.permissions || "") : ""
+            }
+            PropRow {
+                label: qsTr("Owner")
+                value: dialog.info ? (dialog.info.owner || "") : ""
+            }
+            PropRow {
+                label: qsTr("Target")
+                value: dialog.info && dialog.info.isSymlink ? (dialog.info.symlinkTarget || "") : ""
+                middleElide: true
+            }
+        }
+    }
+
+    RowLayout {
+        Layout.fillWidth: true
+        spacing: 10
+
+        PlainButton {
+            text: qsTr("Copy Path")
+            onClicked: {
+                if (dialog.info && dialog.info.path)
+                    fileOps.yank([dialog.info.path])
+            }
+        }
+        Item { Layout.fillWidth: true }
+        PlainButton {
+            primary: true
+            text: qsTr("Close")
+            onClicked: dialog.close()
+        }
+    }
+}
