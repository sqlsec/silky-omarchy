+    void extractLegacyGbkZip()
+    {
+        // Legacy Windows ZIP archives store Chinese filenames in GB18030/GBK
+        // without the UTF-8 flag bit; Folio should detect the charset and
+        // decode them into UTF-8 rather than failing with "nothing to extract".
+        if (QStandardPaths::findExecutable("bsdtar").isEmpty())
+            QSKIP("Extracting needs bsdtar.");
+        QTemporaryDir dir;
+        const QByteArray dirName("\xD7\xD6\xCC\xE5\xBF\xE2/"); // "字体库/" in GB18030
+        const QByteArray fileName("\xD7\xD6\xCC\xE5\xBF\xE2/\xCB\xB5\xC3\xF7.txt"); // "字体库/说明.txt" in GB18030
+        const QByteArray payload("ok");
+        const auto u16 = [](quint16 v) {
+            QByteArray b(2, '\0');
+            b[0] = char(v & 0xFF);
+            b[1] = char((v >> 8) & 0xFF);
+            return b;
+        };
+        const auto u32 = [](quint32 v) {
+            QByteArray b(4, '\0');
+            b[0] = char(v & 0xFF);
+            b[1] = char((v >> 8) & 0xFF);
+            b[2] = char((v >> 16) & 0xFF);
+            b[3] = char((v >> 24) & 0xFF);
+            return b;
+        };
+        const quint32 crcOk = 0x79DCDD47u; // CRC-32 of "ok"
+        QByteArray zip;
+        const quint32 off1 = 0;
+        zip += QByteArray("PK\x03\x04", 4) + u16(20) + u16(0) + u16(0) + u16(0) + u16(0)
+             + u32(0) + u32(0) + u32(0) + u16(quint16(dirName.size())) + u16(0) + dirName;
+        const quint32 off2 = quint32(zip.size());
+        zip += QByteArray("PK\x03\x04", 4) + u16(20) + u16(0) + u16(0) + u16(0) + u16(0)
+             + u32(crcOk) + u32(quint32(payload.size())) + u32(quint32(payload.size()))
+             + u16(quint16(fileName.size())) + u16(0) + fileName + payload;
+        const quint32 cdOffset = quint32(zip.size());
+        zip += QByteArray("PK\x01\x02", 4) + u16(20) + u16(20) + u16(0) + u16(0) + u16(0) + u16(0)
+             + u32(0) + u32(0) + u32(0) + u16(quint16(dirName.size())) + u16(0) + u16(0)
+             + u16(0) + u16(0) + u32(0x10) + u32(off1) + dirName;
+        zip += QByteArray("PK\x01\x02", 4) + u16(20) + u16(20) + u16(0) + u16(0) + u16(0) + u16(0)
+             + u32(crcOk) + u32(quint32(payload.size())) + u32(quint32(payload.size()))
+             + u16(quint16(fileName.size())) + u16(0) + u16(0)
+             + u16(0) + u16(0) + u32(0) + u32(off2) + fileName;
+        const quint32 cdSize = quint32(zip.size()) - cdOffset;
+        zip += QByteArray("PK\x05\x06", 4) + u16(0) + u16(0) + u16(2) + u16(2)
+             + u32(cdSize) + u32(cdOffset) + u16(0);
+
+        const QString archive = dir.filePath(QString::fromUtf8("字体包.zip"));
+        write(archive, zip);
+        FileOps ops;
+        QSignalSpy done(&ops, &FileOps::done);
+        QSignalSpy failed(&ops, &FileOps::failed);
+        ops.extract({archive});
+        QVERIFY(done.wait(5000));
+        QCOMPARE(failed.size(), 0);
+        QCOMPARE(done.first(), QList<QVariant>({dir.path(), QString::fromUtf8("字体库")}));
+        QCOMPARE(contents(dir.filePath(QString::fromUtf8("字体库/说明.txt"))), payload);
+    }
