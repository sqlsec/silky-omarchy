diff --git c/src/WindowLayoutMenu.qml w/src/WindowLayoutMenu.qml
new file mode 100644
index 0000000..55421c8
--- /dev/null
+++ w/src/WindowLayoutMenu.qml
@@ -0,0 +1,116 @@
+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+
+Popup {
+    id: menu
+
+    required property bool fullScreen
+    required property bool layoutsAvailable
+    signal actionRequested(string action)
+
+    function openAt(button) {
+        parent = button
+        x = Math.min(0, button.width / 2 - 27)
+        y = button.height + 2
+        open()
+    }
+
+    popupType: Popup.Item
+    focus: true
+    width: implicitWidth
+    padding: 8
+    margins: 6
+    background: Rectangle {
+        color: Qt.tint(theme.background, Qt.alpha(theme.foreground, theme.light ? 0.025 : 0.04))
+        border.color: Qt.alpha(theme.foreground, 0.19)
+        radius: 12
+    }
+
+    contentItem: ColumnLayout {
+        spacing: 5
+
+        GridLayout {
+            visible: menu.layoutsAvailable
+            columns: 4
+            rowSpacing: 3
+            columnSpacing: 3
+
+            Repeater {
+                model: [
+                    { action: "left", label: qsTr("Left Half"), region: Qt.rect(0, 0, 0.5, 1) },
+                    { action: "right", label: qsTr("Right Half"), region: Qt.rect(0.5, 0, 0.5, 1) },
+                    { action: "top", label: qsTr("Top Half"), region: Qt.rect(0, 0, 1, 0.5) },
+                    { action: "bottom", label: qsTr("Bottom Half"), region: Qt.rect(0, 0.5, 1, 0.5) },
+                    { action: "top-left", label: qsTr("Top Left Quarter"), region: Qt.rect(0, 0, 0.5, 0.5) },
+                    { action: "top-right", label: qsTr("Top Right Quarter"), region: Qt.rect(0.5, 0, 0.5, 0.5) },
+                    { action: "bottom-left", label: qsTr("Bottom Left Quarter"), region: Qt.rect(0, 0.5, 0.5, 0.5) },
+                    { action: "bottom-right", label: qsTr("Bottom Right Quarter"), region: Qt.rect(0.5, 0.5, 0.5, 0.5) }
+                ]
+                delegate: AbstractButton {
+                    id: tile
+                    required property var modelData
+                    implicitWidth: 44
+                    implicitHeight: 36
+                    hoverEnabled: true
+                    enabled: !menu.fullScreen
+                    text: modelData.label
+                    Accessible.name: text
+                    onClicked: {
+                        menu.close()
+                        menu.actionRequested(modelData.action)
+                    }
+                    ToolTip.visible: hovered
+                    ToolTip.text: text
+                    ToolTip.delay: 550
+
+                    background: Rectangle {
+                        radius: 7
+                        color: tile.down || tile.hovered || tile.visualFocus ? Qt.alpha(theme.accent, 0.18) : "transparent"
+                    }
+                    contentItem: Item {
+                        Rectangle {
+                            id: glyph
+                            anchors.centerIn: parent
+                            width: 24
+                            height: 17
+                            radius: 3
+                            color: "transparent"
+                            border.width: 1.4
+                            border.color: theme.foreground
+                            opacity: tile.enabled ? 1 : 0.35
+
+                            Rectangle {
+                                readonly property rect region: tile.modelData.region
+                                x: 3 + 18 * region.x
+                                y: 3 + 11 * region.y
+                                width: 18 * region.width
+                                height: 11 * region.height
+                                radius: 1.3
+                                color: theme.foreground
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        Rectangle {
+            visible: menu.layoutsAvailable
+            Layout.fillWidth: true
+            Layout.leftMargin: 4
+            Layout.rightMargin: 4
+            implicitHeight: 1
+            color: Qt.alpha(theme.foreground, 0.14)
+        }
+        PlainButton {
+            Layout.fillWidth: true
+            implicitHeight: 30
+            text: menu.fullScreen ? qsTr("Exit Full Screen") : qsTr("Full Screen")
+            onClicked: {
+                menu.close()
+                menu.actionRequested("fullscreen")
+            }
+        }
+    }
+}
