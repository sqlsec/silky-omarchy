+    void smoothMouseWheelScrollsFlickablePredictably()
+    {
+        QQmlApplicationEngine engine;
+        engine.loadData(R"(
+            import QtQuick
+            Window {
+                width: 400; height: 400; visible: true
+                Flickable {
+                    id: v; objectName: "v"
+                    anchors.fill: parent
+                    contentWidth: 2000; contentHeight: 5000
+                    Item { width: 2000; height: 5000 }
+                }
+            }
+        )");
+        QVERIFY(!engine.rootObjects().isEmpty());
+        auto *win = qobject_cast<QQuickWindow *>(engine.rootObjects().first());
+        QVERIFY(win);
+        QVERIFY(QTest::qWaitForWindowExposed(win));
+        auto *flick = win->findChild<QQuickItem *>("v");
+        QVERIFY(flick);
+
+        SmoothMouseWheelFilter filter(nullptr, 240.0);
+        win->installEventFilter(&filter);
+        const auto *dev = QPointingDevice::primaryPointingDevice();
+
+        // 1) One Wayland-like mouse-wheel notch (pixelDelta=-15, angleDelta=-120, NoScrollPhase)
+        //    must glide smoothly to ~240 px (not Qt's 15 px crawl).
+        QWheelEvent notch1(QPointF(200, 200), QPointF(200, 200), QPoint(0, -15), QPoint(0, -120),
+                           Qt::NoButton, Qt::NoModifier, Qt::NoScrollPhase, false,
+                           Qt::MouseEventNotSynthesized, dev);
+        QCoreApplication::sendEvent(win, &notch1);
+        QTRY_VERIFY_WITH_TIMEOUT(std::abs(flick->property("contentY").toReal() - 240.0) < 1.0, 500);
+
+        // 2) Two quick notches accumulate smoothly to ~720 px.
+        QWheelEvent notch2(QPointF(200, 200), QPointF(200, 200), QPoint(0, -15), QPoint(0, -120),
+                           Qt::NoButton, Qt::NoModifier, Qt::NoScrollPhase, false,
+                           Qt::MouseEventNotSynthesized, dev);
+        QWheelEvent notch3(QPointF(200, 200), QPointF(200, 200), QPoint(0, -15), QPoint(0, -120),
+                           Qt::NoButton, Qt::NoModifier, Qt::NoScrollPhase, false,
+                           Qt::MouseEventNotSynthesized, dev);
+        QCoreApplication::sendEvent(win, &notch2);
+        QCoreApplication::sendEvent(win, &notch3);
+        QTRY_VERIFY_WITH_TIMEOUT(std::abs(flick->property("contentY").toReal() - 720.0) < 1.0, 600);
+
+        // 3) Shift + wheel scrolls horizontally by ~240 px.
+        QWheelEvent hNotch(QPointF(200, 200), QPointF(200, 200), QPoint(0, -15), QPoint(0, -120),
+                           Qt::NoButton, Qt::ShiftModifier, Qt::NoScrollPhase, false,
+                           Qt::MouseEventNotSynthesized, dev);
+        QCoreApplication::sendEvent(win, &hNotch);
+        QTRY_VERIFY_WITH_TIMEOUT(std::abs(flick->property("contentX").toReal() - 240.0) < 1.0, 500);
+
+        // 4) Phased touchpad events and Ctrl+wheel zoom are not intercepted.
+        QWheelEvent touchpad(QPointF(200, 200), QPointF(200, 200), QPoint(0, -10), QPoint(0, -40),
+                             Qt::NoButton, Qt::NoModifier, Qt::ScrollUpdate, false,
+                             Qt::MouseEventSynthesizedBySystem, dev);
+        QVERIFY(!filter.eventFilter(win, &touchpad));
+
+        QWheelEvent ctrlZoom(QPointF(200, 200), QPointF(200, 200), QPoint(0, -15), QPoint(0, -120),
+                             Qt::NoButton, Qt::ControlModifier, Qt::NoScrollPhase, false,
+                             Qt::MouseEventNotSynthesized, dev);
+        QVERIFY(!filter.eventFilter(win, &ctrlZoom));
+    }
