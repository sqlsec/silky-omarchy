+
+QString classify(const QString &mime, const QString &path) {
+    const QString ext = extensionLower(path);
+    // Spreadsheets: instant native virtualized grid.
+    if (ext == QLatin1String("xlsx") || ext == QLatin1String("xlsm") || ext == QLatin1String("ods") ||
+        ext == QLatin1String("csv") || ext == QLatin1String("tsv") ||
+        mime == QLatin1String("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet") ||
+        mime == QLatin1String("application/vnd.ms-excel.sheet.macroEnabled.12") ||
+        mime == QLatin1String("application/vnd.oasis.opendocument.spreadsheet") ||
+        mime == QLatin1String("text/csv") || mime == QLatin1String("text/tab-separated-values"))
+        return QStringLiteral("sheet");
+
+    // Modern Office documents: instant native rich preview + cached high-fidelity PDF toggle.
+    if (ext == QLatin1String("docx") || ext == QLatin1String("odt") || ext == QLatin1String("pptx") ||
+        mime == QLatin1String("application/vnd.openxmlformats-officedocument.wordprocessingml.document") ||
+        mime == QLatin1String("application/vnd.oasis.opendocument.text") ||
+        mime == QLatin1String("application/vnd.openxmlformats-officedocument.presentationml.presentation"))
+        return QStringLiteral("office-doc");
+
+    // Legacy Excel (.xls): background convert to cached .xlsx, then render in native grid.
+    if (ext == QLatin1String("xls") || mime == QLatin1String("application/vnd.ms-excel"))
+        return QStringLiteral("office-xls");
+
+    // Legacy Word/PowerPoint/RTF/ODP: background convert to cached PDF, then render in Qt PDF.
+    if (ext == QLatin1String("doc") || ext == QLatin1String("ppt") || ext == QLatin1String("rtf") ||
+        ext == QLatin1String("odp") || ext == QLatin1String("wps") || ext == QLatin1String("et") ||
+        ext == QLatin1String("dps") ||
+        mime == QLatin1String("application/msword") ||
+        mime == QLatin1String("application/vnd.ms-powerpoint") ||
+        mime == QLatin1String("application/rtf") || mime == QLatin1String("text/rtf") ||
+        mime == QLatin1String("application/vnd.oasis.opendocument.presentation"))
+        return QStringLiteral("office-pdf");
+
+    return {};
+}
+
+SpreadsheetResult parseSpreadsheet(const QString &path, const QString &mime) {
+    const QString ext = extensionLower(path);
+    if (ext == QLatin1String("csv") || ext == QLatin1String("tsv") ||
+        mime == QLatin1String("text/csv") || mime == QLatin1String("text/tab-separated-values"))
+        return parseCsv(path);
+    if (ext == QLatin1String("ods") || mime == QLatin1String("application/vnd.oasis.opendocument.spreadsheet"))
+        return parseOds(path);
+    return parseXlsx(path);
+}
+
+DocumentResult parseDocument(const QString &path, const QString &mime) {
+    const QString ext = extensionLower(path);
+    if (ext == QLatin1String("pptx") ||
+        mime == QLatin1String("application/vnd.openxmlformats-officedocument.presentationml.presentation"))
+        return parsePptx(path);
+    if (ext == QLatin1String("odt") || mime == QLatin1String("application/vnd.oasis.opendocument.text"))
+        return parseOdt(path);
+    return parseDocx(path);
+}
+
+QString quickSnippetHtml(const QString &path, const QString &mime) {
+    const QString kind = classify(mime, path);
+    if (kind == QLatin1String("office-doc")) {
+        const DocumentResult doc = parseDocument(path, mime);
+        if (doc.html.isEmpty())
+            return {};
+        // Keep the sidebar card layout fast and avoid cutting inside an HTML tag.
+        if (doc.html.size() > 12000) {
+            QString cut = doc.html.left(12000);
+            const qsizetype lastClose = std::max({cut.lastIndexOf(QLatin1String("</p>")),
+                                                  cut.lastIndexOf(QLatin1String("</table>")),
+                                                  cut.lastIndexOf(QLatin1String("</h1>")),
+                                                  cut.lastIndexOf(QLatin1String("</h2>")),
+                                                  cut.lastIndexOf(QLatin1String("</h3>")),
+                                                  cut.lastIndexOf(QLatin1String("</h4>")),
+                                                  cut.lastIndexOf(QLatin1String("<hr/>"))});
+            if (lastClose > 0) {
+                const qsizetype endTag = cut.indexOf('>', lastClose);
+                if (endTag > 0)
+                    cut.truncate(endTag + 1);
+            }
+            return cut;
+        }
+        return doc.html;
+    }
+    if (kind == QLatin1String("sheet")) {
+        const SpreadsheetResult res = parseSpreadsheet(path, mime);
+        if (res.sheets.isEmpty())
+            return {};
+        const SheetData &s = res.sheets.first();
+        QString html = QStringLiteral("<div style='font-size:10px;opacity:0.7;margin-bottom:6px;'>%1 · %2 × %3</div>")
+                           .arg(htmlEscape(s.name))
+                           .arg(s.rows.size())
+                           .arg(s.colCount);
+        const int maxR = std::min<int>(s.rows.size(), 16);
+        const int maxC = std::min<int>(s.colCount, 6);
+        if (maxR == 0 || maxC == 0)
+            return html;
+        html.append(QStringLiteral("<table border='1' cellspacing='0' cellpadding='3' width='100%' "
+                                   "style='border-collapse:collapse;font-size:9.5px;'>"));
+        for (int r = 0; r < maxR; ++r) {
+            html.append(QStringLiteral("<tr>"));
+            const QStringList &row = s.rows.at(r);
+            for (int c = 0; c < maxC; ++c) {
+                QString val = (c < row.size()) ? row.at(c) : QString();
+                if (val.size() > 24)
+                    val = val.left(23) + QStringLiteral("…");
+                const QString tag = (r == 0) ? QStringLiteral("th") : QStringLiteral("td");
+                const QString style = (r == 0) ? QStringLiteral(" style='font-weight:600;text-align:left;'") : QString();
+                html.append(QStringLiteral("<%1%2>%3</%1>")
+                                .arg(tag, style, val.isEmpty() ? QStringLiteral("&nbsp;") : htmlEscape(val)));
+            }
+            html.append(QStringLiteral("</tr>"));
+        }
+        html.append(QStringLiteral("</table>"));
+        return html;
+    }
+    return {};
+}
+
+QVariantList toVariantSheets(const SpreadsheetResult &result) {
+    QVariantList out;
+    out.reserve(result.sheets.size());
+    for (const SheetData &s : result.sheets) {
+        QVariantList rowsVar;
+        rowsVar.reserve(s.rows.size());
+        for (const QStringList &r : s.rows)
+            rowsVar.append(QVariant::fromValue(r));
+
+        QVariantList widthsVar;
+        widthsVar.reserve(s.colWidths.size());
+        for (int w : s.colWidths)
+            widthsVar.append(w);
+
+        QVariantMap map;
+        map.insert(QStringLiteral("name"), s.name);
+        map.insert(QStringLiteral("colCount"), s.colCount);
+        map.insert(QStringLiteral("rowCount"), s.rows.size());
+        map.insert(QStringLiteral("colWidths"), widthsVar);
+        map.insert(QStringLiteral("rows"), rowsVar);
+        map.insert(QStringLiteral("truncated"), s.truncated);
+        out.append(map);
+    }
+    return out;
+}
