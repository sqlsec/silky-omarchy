+static bool canConvertCharset(const char *charset, const QList<QByteArray> &samples) {
+    iconv_t cd = iconv_open("UTF-8", charset);
+    if (cd == reinterpret_cast<iconv_t>(-1))
+        return false;
+    bool ok = true;
+    for (const QByteArray &sample : samples) {
+        iconv(cd, nullptr, nullptr, nullptr, nullptr);
+        QByteArray out(sample.size() * 4 + 16, '\0');
+        char *inPtr = const_cast<char *>(sample.constData());
+        size_t inLeft = size_t(sample.size());
+        char *outPtr = out.data();
+        size_t outLeft = size_t(out.size());
+        if (iconv(cd, &inPtr, &inLeft, &outPtr, &outLeft) == size_t(-1) || inLeft != 0) {
+            ok = false;
+            break;
+        }
+    }
+    iconv_close(cd);
+    return ok;
+}
