index 0000000..03c2249
--- /dev/null
+++ w/src/smoothwheel.h
@@ -0,0 +1,218 @@
+#pragma once
+
+#include <QEvent>
+#include <QObject>
+#include <QPointer>
+#include <QQuickItem>
+#include <QQuickWindow>
+#include <QTimer>
+#include <QWheelEvent>
+#include <cmath>
+
+// On Wayland, discrete mouse wheels arrive with Qt::NoScrollPhase and a tiny
+// pixelDelta (~15 px), causing Qt Quick Flickables to crawl. This filter
+// intercepts discrete mouse wheels (leaving phased touchpad gestures and Ctrl
+// zoom untouched) and smoothly eases the hovered QQuickFlickable's contentY /
+// contentX at 90 Hz with an exact, predictable distance per notch.
+class SmoothMouseWheelFilter : public QObject {
+public:
+    explicit SmoothMouseWheelFilter(QObject *parent = nullptr, qreal pixelsPerNotch = 240.0)
+        : QObject(parent), m_pixelsPerNotch(pixelsPerNotch) {
+        m_timer.setTimerType(Qt::PreciseTimer);
+        m_timer.setInterval(11); // ~90 Hz
+        connect(&m_timer, &QTimer::timeout, this, &SmoothMouseWheelFilter::tick);
+    }
+
+    bool eventFilter(QObject *watched, QEvent *event) override {
+        if (event->type() != QEvent::Wheel)
+            return false;
+        auto *window = qobject_cast<QQuickWindow *>(watched);
+        if (!window)
+            return false;
+        auto *ev = static_cast<QWheelEvent *>(event);
+
+        // Lock background scrolling while a context menu or popup is open,
+        // unless the pointer is over a scrollable view inside that popup.
+        QQuickItem *popup = topmostVisiblePopup(window->contentItem());
+        if (popup) {
+            const bool horizontalHint = (ev->modifiers() & Qt::ShiftModifier)
+                                        || (ev->angleDelta().x() != 0 && ev->angleDelta().y() == 0);
+            QQuickItem *popupFlick = findScrollableFlickable(popup, ev->position(), horizontalHint);
+            if (!popupFlick) {
+                stop();
+                ev->accept();
+                return true;
+            }
+            if (ev->phase() != Qt::NoScrollPhase) {
+                stop();
+                return false;
+            }
+        }
+
+        // Touchpads on Wayland emit scroll phases (ScrollBegin/Update/End/Momentum);
+        // stop any active mouse-wheel glide and let the touchpad handle it natively.
+        if (ev->phase() != Qt::NoScrollPhase) {
+            stop();
+            return false;
+        }
+        if (ev->modifiers() & Qt::ControlModifier)
+            return false;
+
+        qreal dx = 0;
+        qreal dy = 0;
+        const QPoint angle = ev->angleDelta();
+        const QPoint pixel = ev->pixelDelta();
+        if (!angle.isNull()) {
+            dx = (-angle.x() / 120.0) * m_pixelsPerNotch;
+            dy = (-angle.y() / 120.0) * m_pixelsPerNotch;
+        } else if (!pixel.isNull()) {
+            dx = -pixel.x() * 12.0;
+            dy = -pixel.y() * 12.0;
+        } else {
+            return false;
+        }
+
+        // Shift + vertical wheel scrolls horizontally (tables, column canvas).
+        if ((ev->modifiers() & Qt::ShiftModifier) && dy != 0 && dx == 0) {
+            dx = dy;
+            dy = 0;
+        }
+
+        const bool horizontal = (dx != 0 && dy == 0);
+        QQuickItem *searchRoot = popup ? popup : window->contentItem();
+        QQuickItem *flick = findScrollableFlickable(searchRoot, ev->position(), horizontal);
+        if (!flick) {
+            if (popup) {
+                stop();
+                ev->accept();
+                return true;
+            }
+            return false;
+        }
+
+        if (m_target != flick || m_horizontal != horizontal) {
+            m_target = flick;
+            m_horizontal = horizontal;
+            m_targetPos = currentPos(flick, horizontal);
+        }
+
+        const qreal delta = horizontal ? dx : dy;
+        const auto [minPos, maxPos] = boundsFor(flick, horizontal);
+        const qreal base = m_timer.isActive() ? m_targetPos : currentPos(flick, horizontal);
+        m_targetPos = std::clamp(base + delta, minPos, maxPos);
+
+        tick();
+        if (m_target && std::abs(m_targetPos - currentPos(m_target, m_horizontal)) >= 0.5) {
+            if (!m_timer.isActive())
+                m_timer.start();
+        }
+        return true;
+    }
+
+    void stop() {
+        m_timer.stop();
+        m_target = nullptr;
+    }
+
+private:
+    static QQuickItem *topmostVisiblePopup(QQuickItem *root) {
+        if (!root)
+            return nullptr;
+        const QList<QQuickItem *> children = root->childItems();
+        for (int i = children.size() - 1; i >= 0; --i) {
+            QQuickItem *child = children.at(i);
+            if (!child || !child->isVisible() || child->opacity() <= 0.0)
+                continue;
+            if (child->inherits("QQuickPopupItem")) {
+                QObject *owner = child->parent();
+                if (owner && owner->inherits("QQuickToolTip"))
+                    continue;
+                return child;
+            }
+            if (child->inherits("QQuickOverlay")) {
+                if (QQuickItem *hit = topmostVisiblePopup(child))
+                    return hit;
+            }
+        }
+        return nullptr;
+    }
+
+    static bool isFlickable(const QQuickItem *item) {
+        return item && item->inherits("QQuickFlickable");
+    }
+
+    static std::pair<qreal, qreal> boundsFor(const QQuickItem *flick, bool horizontal) {
+        if (horizontal) {
+            const qreal minX = flick->property("originX").toReal();
+            const qreal maxX = minX + std::max<qreal>(0.0, flick->property("contentWidth").toReal() - flick->width());
+            return {minX, maxX};
+        }
+        const qreal minY = flick->property("originY").toReal();
+        const qreal maxY = minY + std::max<qreal>(0.0, flick->property("contentHeight").toReal() - flick->height());
+        return {minY, maxY};
+    }
+
+    static qreal currentPos(const QQuickItem *flick, bool horizontal) {
+        return flick->property(horizontal ? "contentX" : "contentY").toReal();
+    }
+
+    static void setPos(QQuickItem *flick, bool horizontal, qreal value) {
+        flick->setProperty(horizontal ? "contentX" : "contentY", value);
+    }
+
+    static bool canScroll(const QQuickItem *flick, bool horizontal) {
+        if (!flick->property("interactive").toBool())
+            return false;
+        const auto [minP, maxP] = boundsFor(flick, horizontal);
+        return (maxP - minP) > 1.0;
+    }
+
+    // Finds the deepest visible QQuickFlickable under `windowPos` that can scroll
+    // along `horizontal`. Walks children in reverse stacking order (topmost first).
+    static QQuickItem *findScrollableFlickable(QQuickItem *item, const QPointF &windowPos, bool horizontal) {
+        if (!item || !item->isVisible() || item->opacity() <= 0.0)
+            return nullptr;
+        const QPointF local = item->mapFromScene(windowPos);
+        const bool inside = (local.x() >= 0 && local.y() >= 0 && local.x() <= item->width() && local.y() <= item->height());
+        if (item->clip() && !inside)
+            return nullptr;
+
+        const QList<QQuickItem *> children = item->childItems();
+        for (int i = children.size() - 1; i >= 0; --i) {
+            if (QQuickItem *hit = findScrollableFlickable(children.at(i), windowPos, horizontal))
+                return hit;
+        }
+
+        if (inside && isFlickable(item) && canScroll(item, horizontal))
+            return item;
+        return nullptr;
+    }
+
+    void tick() {
+        if (!m_target || !m_target->isVisible() || m_target->property("dragging").toBool()) {
+            stop();
+            return;
+        }
+        const auto [minPos, maxPos] = boundsFor(m_target, m_horizontal);
+        m_targetPos = std::clamp(m_targetPos, minPos, maxPos);
+
+        const qreal cur = currentPos(m_target, m_horizontal);
+        const qreal diff = m_targetPos - cur;
+        if (std::abs(diff) < 0.75) {
+            setPos(m_target, m_horizontal, m_targetPos);
+            m_timer.stop();
+            return;
+        }
+        // Exponential ease-out: ~30% of remaining distance per 11ms frame (~120ms settle).
+        qreal step = diff * 0.30;
+        if (std::abs(step) < 1.0)
+            step = (diff > 0) ? 1.0 : -1.0;
+        setPos(m_target, m_horizontal, std::clamp(cur + step, minPos, maxPos));
+    }
+
+    QTimer m_timer;
+    QPointer<QQuickItem> m_target;
+    bool m_horizontal = false;
+    qreal m_targetPos = 0;
+    qreal m_pixelsPerNotch = 240.0;
+};
