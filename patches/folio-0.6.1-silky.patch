+    QDir().mkpath(OfficePreview::loProfileDir());
+    // Any stale lock left by a killed soffice process would stall or break the next run.
+    QFile::remove(OfficePreview::loProfileDir() + QStringLiteral("/.lock"));
+
+    QTemporaryDir tempDir(OfficePreview::cacheDir() + QStringLiteral("/tmp-XXXXXX"));
+    if (!tempDir.isValid()) {
