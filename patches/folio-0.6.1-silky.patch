+
+void FileOps::calculateFolderSize(const QString &path) {
+    cancelFolderSize();
+    if (path.isEmpty() || !QFileInfo(path).isDir())
+        return;
+    auto cancel = std::make_shared<std::atomic<bool>>(false);
+    m_sizeCancel = cancel;
+    QPointer<FileOps> guard(this);
+    (void)QtConcurrent::run([guard, path, cancel]() {
+        qint64 totalBytes = 0;
+        int fileCount = 0;
+        int dirCount = 0;
+        QElapsedTimer throttle;
+        throttle.start();
+        QDirIterator it(path, QDir::AllEntries | QDir::NoDotAndDotDot | QDir::Hidden | QDir::System,
+                        QDirIterator::Subdirectories);
+        while (it.hasNext()) {
+            if (cancel->load(std::memory_order_relaxed))
+                return;
+            it.next();
+            const QFileInfo fi = it.fileInfo();
+            if (fi.isSymLink()) {
+                ++fileCount;
+                continue;
+            }
+            if (fi.isDir()) {
+                ++dirCount;
+            } else {
+                ++fileCount;
+                totalBytes += fi.size();
+            }
+            if (throttle.elapsed() >= 100) {
+                throttle.restart();
+                const qint64 b = totalBytes;
+                const int f = fileCount;
+                const int d = dirCount;
+                if (guard && !cancel->load(std::memory_order_relaxed)) {
+                    QMetaObject::invokeMethod(
+                        guard,
+                        [guard, path, b, f, d, cancel] {
+                            if (guard && !cancel->load(std::memory_order_relaxed))
+                                emit guard->folderSizeUpdated(path, b, f, d, false);
+                        },
+                        Qt::QueuedConnection);
+                }
+            }
+        }
+        if (guard && !cancel->load(std::memory_order_relaxed)) {
+            QMetaObject::invokeMethod(
+                guard,
+                [guard, path, totalBytes, fileCount, dirCount, cancel] {
+                    if (guard && !cancel->load(std::memory_order_relaxed))
+                        emit guard->folderSizeUpdated(path, totalBytes, fileCount, dirCount, true);
+                },
+                Qt::QueuedConnection);
+        }
+    });
+}
