+
+QString volumeMountPath(GVolume *volume) {
+    GMount *mount = g_volume_get_mount(volume);
+    if (!mount)
+        return {};
+    GFile *root = g_mount_get_root(mount);
+    char *raw = g_file_get_path(root);
+    const QString path = QString::fromUtf8(raw ? raw : "");
+    g_free(raw);
+    g_object_unref(root);
+    g_object_unref(mount);
+    return path;
+}
+
+void volumeMounted(GObject *source, GAsyncResult *result, gpointer data) {
+    std::unique_ptr<VolumeMount> ctx(static_cast<VolumeMount *>(data));
+    GError *error = nullptr;
+    const bool ok = g_volume_mount_finish(G_VOLUME(source), result, &error);
+    const bool already = error && g_error_matches(error, G_IO_ERROR, G_IO_ERROR_ALREADY_MOUNTED);
+    if (Places *places = ctx->places.data()) {
+        if (ok || already) {
+            const QString path = volumeMountPath(G_VOLUME(source));
+            places->refresh();
+            if (!path.isEmpty())
+                emit places->deviceMounted(path);
+            else
+                emit places->failed(Places::tr("Couldn't mount %1: %2").arg(ctx->name, Places::tr("No mount point was returned.")));
+        } else if (!g_error_matches(error, G_IO_ERROR, G_IO_ERROR_FAILED_HANDLED)
+                   && !g_error_matches(error, G_IO_ERROR, G_IO_ERROR_CANCELLED)) {
+            const QString why = QString::fromUtf8(error ? error->message : "");
+            emit places->failed(Places::tr("Couldn't mount %1: %2").arg(ctx->name, why));
+        }
+    }
+    if (error)
+        g_error_free(error);
+}
+
+QVariantList unmountedVolumes(const QString &systemDevice, const QSet<QString> &mountedDevices) {
+    static GVolumeMonitor *const monitor = g_volume_monitor_get();
+    GList *volumes = g_volume_monitor_get_volumes(monitor);
+    QVariantList result;
+    QSet<QString> seen = mountedDevices;
+    for (GList *l = volumes; l; l = l->next) {
+        GVolume *vol = G_VOLUME(l->data);
+        if (GMount *existing = g_volume_get_mount(vol)) {
+            g_object_unref(existing);
+            continue;
+        }
+        if (!g_volume_can_mount(vol))
+            continue;
+        char *devRaw = g_volume_get_identifier(vol, G_VOLUME_IDENTIFIER_KIND_UNIX_DEVICE);
+        const QString device = QString::fromUtf8(devRaw ? devRaw : "");
+        g_free(devRaw);
+        const bool block = device.startsWith("/dev/") && !device.startsWith("/dev/loop")
+                           && !device.startsWith("/dev/zram");
+        if (!block || device == systemDevice || seen.contains(device))
+            continue;
+        seen.insert(device);
+        char *nameRaw = g_volume_get_name(vol);
+        const QString name = QString::fromUtf8(nameRaw ? nameRaw : "").trimmed();
+        g_free(nameRaw);
+        result << QVariantMap{{"name", name.isEmpty() ? QFileInfo(device).fileName() : name},
