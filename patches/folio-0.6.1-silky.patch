+void FolderModel::renamed(const QString &from, const QString &to) {
+    if (from.isEmpty() || to.isEmpty() || from == to || m_expanded.isEmpty())
+        return;
+    const QString prefix = from + '/';
+    auto remap = [&](const QString &path) -> QString {
+        if (path == from)
+            return to;
+        if (path.startsWith(prefix))
+            return to + path.mid(from.size());
+        return {};
+    };
+
+    bool changed = false;
+    QSet<QString> nextExpanded;
+    nextExpanded.reserve(m_expanded.size());
+    for (const QString &folder : std::as_const(m_expanded)) {
+        const QString moved = remap(folder);
+        if (!moved.isEmpty()) {
+            changed = true;
+            if (folder != m_path)
+                m_watcher.removePath(folder);
+            if (QDir(moved).exists())
+                m_watcher.addPath(moved);
+            nextExpanded.insert(moved);
+        } else {
+            nextExpanded.insert(folder);
+        }
+    }
+    if (!changed)
+        return;
+    m_expanded = std::move(nextExpanded);
+
+    QHash<QString, QVector<Entry>> nextOpen;
+    nextOpen.reserve(m_open.size());
+    for (auto it = m_open.cbegin(); it != m_open.cend(); ++it) {
+        const QString movedKey = remap(it.key());
+        const QString key = movedKey.isEmpty() ? it.key() : movedKey;
+        QVector<Entry> items = it.value();
+        if (!movedKey.isEmpty()) {
+            for (Entry &e : items)
+                if (const QString movedEntry = remap(e.path); !movedEntry.isEmpty())
+                    e.path = movedEntry;
+        }
+        nextOpen.insert(key, std::move(items));
+    }
+    m_open = std::move(nextOpen);
+
+    QHash<QString, quint64> nextOpening;
+    nextOpening.reserve(m_opening.size());
+    for (auto it = m_opening.cbegin(); it != m_opening.cend(); ++it) {
+        const QString movedKey = remap(it.key());
+        nextOpening.insert(movedKey.isEmpty() ? it.key() : movedKey, it.value());
+    }
+    m_opening = std::move(nextOpening);
+}
