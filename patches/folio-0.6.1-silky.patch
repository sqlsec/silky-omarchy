+import QtQuick
+import QtQuick.Controls
+import QtQuick.Layouts
+
+// Fast virtualized spreadsheet viewer for .xlsx / .ods / .csv / .tsv (and cached .xls).
+Item {
+    id: root
+
+    property int sheetIndex: 0
+    property int selectedRow: -1
+    property int selectedCol: -1
+    property bool copiedFeedback: false
+    property real smoothTargetY: 0
+    property real smoothTargetX: 0
+
+    readonly property var allSheets: previewer.sheets || []
+    readonly property var currentSheet: (sheetIndex >= 0 && sheetIndex < allSheets.length) ? allSheets[sheetIndex] : null
+    readonly property var rows: currentSheet ? (currentSheet.rows || []) : []
+    readonly property var colWidths: currentSheet ? (currentSheet.colWidths || []) : []
+    readonly property int colCount: currentSheet ? (currentSheet.colCount || 0) : 0
+    readonly property int rowNumWidth: 52
+    readonly property int rowHeight: 30
+    readonly property int headerHeight: 28
+
+    readonly property int totalColsWidth: {
+        let sum = 0
+        for (let i = 0; i < colWidths.length; ++i)
+            sum += colWidths[i]
+        return sum
+    }
+
+    readonly property string selectedText: {
+        if (selectedRow >= 0 && selectedRow < rows.length && selectedCol >= 0 && selectedCol < colCount)
+            return rows[selectedRow][selectedCol] || ""
+        return ""
+    }
+
+    function colName(index) {
+        let n = index + 1
+        let s = ""
+        while (n > 0) {
+            const rem = (n - 1) % 26
+            s = String.fromCharCode(65 + rem) + s
+            n = Math.floor((n - 1) / 26)
+        }
+        return s
+    }
+
+    function animateScrollY(deltaY) {
+        const maxY = Math.max(0, rowList.contentHeight - rowList.height)
+        const base = smoothAnimY.running ? smoothTargetY : rowList.contentY
+        smoothTargetY = Math.max(0, Math.min(maxY, base + deltaY))
+        smoothAnimY.to = smoothTargetY
+        smoothAnimY.restart()
+    }
+
+    function animateScrollX(deltaX) {
+        const maxX = Math.max(0, hFlick.contentWidth - hFlick.width)
+        const base = smoothAnimX.running ? smoothTargetX : hFlick.contentX
+        smoothTargetX = Math.max(0, Math.min(maxX, base + deltaX))
+        smoothAnimX.to = smoothTargetX
+        smoothAnimX.restart()
+    }
+
+    function scroll(direction) {
+        animateScrollY(direction * 120)
+    }
+
+    function page(direction) {
+        animateScrollY(direction * Math.max(150, rowList.height - 60))
+    }
+
+    function resetSelection() {
+        selectedRow = -1
+        selectedCol = -1
+        copiedFeedback = false
+        smoothAnimX.stop()
+        smoothAnimY.stop()
+        smoothTargetX = 0
+        smoothTargetY = 0
+        hFlick.contentX = 0
+        rowList.contentY = 0
+    }
+
+    NumberAnimation {
+        id: smoothAnimY
+        target: rowList
+        property: "contentY"
+        duration: 140
+        easing.type: Easing.OutCubic
+    }
+
+    NumberAnimation {
+        id: smoothAnimX
+        target: hFlick
+        property: "contentX"
+        duration: 140
+        easing.type: Easing.OutCubic
+    }
+
+    Connections {
+        target: previewer
+        function onChanged() {
+            root.sheetIndex = 0
+            root.resetSelection()
+        }
+    }
+
+    Timer {
+        id: copiedTimer
+        interval: 1200
+        onTriggered: root.copiedFeedback = false
+    }
+
+    ColumnLayout {
+        anchors.fill: parent
+        spacing: 0
+
+        // Selected cell inspector bar: view full multi-line cell text and copy with one click.
+        Rectangle {
+            Layout.fillWidth: true
+            implicitHeight: visible ? 34 : 0
+            visible: root.selectedRow >= 0 && root.selectedCol >= 0
+            color: theme.background
+
+            RowLayout {
+                anchors.fill: parent
+                anchors.leftMargin: 16
+                anchors.rightMargin: 12
+                spacing: 10
+
+                Rectangle {
+                    implicitWidth: refLabel.implicitWidth + 14
+                    implicitHeight: 22
+                    radius: 4
+                    color: Qt.alpha(theme.accent, 0.16)
+                    Text {
+                        id: refLabel
+                        anchors.centerIn: parent
+                        text: root.colName(root.selectedCol) + (root.selectedRow + 1)
+                        color: theme.accent
+                        font.pixelSize: 11
+                        font.weight: Font.DemiBold
+                    }
+                }
+
+                Text {
+                    Layout.fillWidth: true
+                    text: root.selectedText.replace(/\n/g, " ↵ ")
+                    color: theme.foreground
+                    font.pixelSize: 12
+                    elide: Text.ElideRight
+                }
+
+                Rectangle {
+                    implicitWidth: copyLabel.implicitWidth + 16
+                    implicitHeight: 22
+                    radius: 4
+                    color: copyMouse.containsMouse ? Qt.alpha(theme.foreground, 0.12) : Qt.alpha(theme.foreground, 0.06)
+                    Text {
+                        id: copyLabel
+                        anchors.centerIn: parent
+                        text: root.copiedFeedback ? qsTr("Copied") : qsTr("Copy")
+                        color: root.copiedFeedback ? theme.accent : theme.foreground
+                        font.pixelSize: 11
+                        font.weight: Font.Medium
+                    }
+                    MouseArea {
+                        id: copyMouse
+                        anchors.fill: parent
+                        hoverEnabled: true
+                        cursorShape: Qt.PointingHandCursor
+                        onClicked: {
+                            previewer.copyText(root.selectedText)
+                            root.copiedFeedback = true
+                            copiedTimer.restart()
+                        }
+                    }
+                }
+            }
+
+            Rectangle {
+                anchors.bottom: parent.bottom
+                width: parent.width
+                height: 1
+                color: Qt.alpha(theme.foreground, 0.10)
+            }
+        }
+
+        // Main grid viewport: horizontal Flickable around a vertically virtualized ListView.
+        Item {
+            Layout.fillWidth: true
+            Layout.fillHeight: true
+
+            Flickable {
+                id: hFlick
+                anchors.fill: parent
+                clip: true
+                boundsBehavior: Flickable.StopAtBounds
+                flickableDirection: Flickable.HorizontalFlick
+                contentWidth: Math.max(width, root.rowNumWidth + root.totalColsWidth + 16)
+                contentHeight: height
+
+                // Column letters header (A, B, C...)
+                Rectangle {
+                    id: colHeader
+                    x: 0
+                    y: 0
+                    width: hFlick.contentWidth
+                    height: root.headerHeight
+                    color: theme.background
+                    z: 2
+
+                    Row {
+                        anchors.fill: parent
+
+                        Rectangle {
+                            width: root.rowNumWidth
+                            height: parent.height
+                            color: Qt.alpha(theme.foreground, 0.04)
+                            Rectangle {
+                                anchors.right: parent.right
+                                width: 1
+                                height: parent.height
+                                color: Qt.alpha(theme.foreground, 0.10)
+                            }
+                        }
+
+                        Repeater {
+                            model: root.colCount
+                            Rectangle {
+                                required property int index
+                                width: root.colWidths[index] || 96
+                                height: colHeader.height
+                                color: index === root.selectedCol ? Qt.alpha(theme.accent, 0.12) : Qt.alpha(theme.foreground, 0.04)
+
+                                Text {
+                                    anchors.centerIn: parent
+                                    text: root.colName(index)
+                                    color: index === root.selectedCol ? theme.accent : theme.secondaryForeground
+                                    font.pixelSize: 11
+                                    font.weight: Font.DemiBold
+                                }
+                                Rectangle {
+                                    anchors.right: parent.right
+                                    width: 1
+                                    height: parent.height
+                                    color: Qt.alpha(theme.foreground, 0.10)
+                                }
+                            }
+                        }
+                    }
+
+                    Rectangle {
+                        anchors.bottom: parent.bottom
+                        width: parent.width
+                        height: 1
+                        color: Qt.alpha(theme.foreground, 0.14)
+                    }
+                }
+
+                // Virtualized rows
+                ListView {
+                    id: rowList
+                    x: 0
+                    y: root.headerHeight
+                    width: hFlick.contentWidth
+                    height: Math.max(0, hFlick.height - root.headerHeight)
+                    clip: true
+                    boundsBehavior: Flickable.StopAtBounds
+                    cacheBuffer: 600
+                    model: root.rows.length
+
+                    delegate: Rectangle {
+                        id: rowDelegate
+                        required property int index
+                        readonly property var rowData: root.rows[index] || []
+                        readonly property bool isFirstRow: index === 0
+                        width: rowList.width
+                        height: root.rowHeight
+                        color: isFirstRow
+                               ? Qt.alpha(theme.foreground, 0.055)
+                               : (index % 2 === 1 ? Qt.alpha(theme.foreground, 0.022) : theme.background)
+
+                        Row {
+                            anchors.fill: parent
+
+                            // Row number gutter
+                            Rectangle {
+                                width: root.rowNumWidth
+                                height: parent.height
+                                color: rowDelegate.index === root.selectedRow
+                                       ? Qt.alpha(theme.accent, 0.12)
+                                       : Qt.alpha(theme.foreground, 0.03)
+                                Text {
+                                    anchors.centerIn: parent
+                                    text: (rowDelegate.index + 1).toString()
+                                    color: rowDelegate.index === root.selectedRow ? theme.accent : theme.secondaryForeground
+                                    font.pixelSize: 11
+                                }
+                                Rectangle {
+                                    anchors.right: parent.right
+                                    width: 1
+                                    height: parent.height
+                                    color: Qt.alpha(theme.foreground, 0.10)
+                                }
+                            }
+
+                            Repeater {
+                                model: root.colCount
+                                Rectangle {
+                                    id: cellRect
+                                    required property int index
+                                    readonly property bool selected: rowDelegate.index === root.selectedRow && index === root.selectedCol
+                                    readonly property string val: (index < rowDelegate.rowData.length && rowDelegate.rowData[index]) ? rowDelegate.rowData[index] : ""
+                                    width: root.colWidths[index] || 96
+                                    height: rowDelegate.height
+                                    color: selected ? Qt.alpha(theme.accent, 0.14) : "transparent"
+
+                                    Text {
+                                        anchors.fill: parent
+                                        anchors.leftMargin: 8
+                                        anchors.rightMargin: 8
+                                        verticalAlignment: Text.AlignVCenter
+                                        text: cellRect.val.replace(/\n/g, " ")
+                                        color: rowDelegate.isFirstRow ? theme.brightForeground : theme.foreground
+                                        font.pixelSize: 12
+                                        font.weight: rowDelegate.isFirstRow ? Font.DemiBold : Font.Normal
+                                        elide: Text.ElideRight
+                                    }
+
+                                    Rectangle {
+                                        anchors.right: parent.right
+                                        width: 1
+                                        height: parent.height
+                                        color: Qt.alpha(theme.foreground, 0.08)
+                                    }
+
+                                    Rectangle {
+                                        visible: cellRect.selected
+                                        anchors.fill: parent
+                                        color: "transparent"
+                                        border.width: 1.5
+                                        border.color: theme.accent
+                                    }
+
+                                    MouseArea {
+                                        anchors.fill: parent
+                                        onClicked: {
+                                            root.selectedRow = rowDelegate.index
+                                            root.selectedCol = cellRect.index
+                                            root.copiedFeedback = false
+                                        }
+                                    }
+                                }
+                            }
+                        }
+
+                        Rectangle {
+                            anchors.bottom: parent.bottom
+                            width: parent.width
+                            height: 1
+                            color: Qt.alpha(theme.foreground, 0.07)
+                        }
+                    }
+
+                    ScrollBar.vertical: FolioScrollBar { }
+                }
+
+                ScrollBar.horizontal: FolioScrollBar { }
+            }
+
+            // Empty sheet state
+            Text {
+                anchors.centerIn: parent
+                visible: root.rows.length === 0
+                text: qsTr("This sheet is empty.")
+                color: theme.secondaryForeground
+                font.pixelSize: 13
+            }
+        }
+
+        // Bottom sheet tabs & summary bar
+        Rectangle {
+            Layout.fillWidth: true
+            implicitHeight: 38
+            color: theme.background
+
+            Rectangle {
+                anchors.top: parent.top
+                width: parent.width
+                height: 1
+                color: Qt.alpha(theme.foreground, 0.12)
+            }
+
+            RowLayout {
+                anchors.fill: parent
+                anchors.leftMargin: 12
+                anchors.rightMargin: 16
+                spacing: 12
+
+                Flickable {
+                    Layout.fillWidth: true
