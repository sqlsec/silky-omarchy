+constexpr int kMaxSheetRows = 4000;
+constexpr int kMaxSheetCols = 80;
+constexpr int kMaxSheets = 30;
+constexpr qint64 kMaxZipEntryBytes = 16LL * 1024 * 1024;
+constexpr qint64 kMaxZipTotalBytes = 48LL * 1024 * 1024;
+constexpr int kMaxDocChars = 160000;
+constexpr int kMaxDocTableCells = 800;
+
+QString extensionLower(const QString &path) {
+    const QString suffix = QFileInfo(path).suffix().toLower();
+    return suffix;
+}
+
+// Reads selected entries from a ZIP archive using libarchive.
+// `predicate` decides whether an entry path (normalized without leading '/') is kept.
+QHash<QString, QByteArray> readZipEntries(const QString &path,
+                                          const std::function<bool(const QString &)> &predicate,
+                                          QString *errorOut = nullptr) {
+    QHash<QString, QByteArray> entries;
+    archive *a = archive_read_new();
+    if (!a) {
+        if (errorOut)
+            *errorOut = QStringLiteral("Failed to initialize libarchive.");
+        return entries;
+    }
+    archive_read_support_format_zip(a);
+    const QByteArray encodedPath = QFile::encodeName(path);
+    if (archive_read_open_filename(a, encodedPath.constData(), 65536) != ARCHIVE_OK) {
+        if (errorOut)
+            *errorOut = QString::fromUtf8(archive_error_string(a));
+        archive_read_free(a);
+        return entries;
+    }
+
+    qint64 totalRead = 0;
+    archive_entry *entry = nullptr;
+    while (archive_read_next_header(a, &entry) == ARCHIVE_OK) {
+        QString name = QString::fromUtf8(archive_entry_pathname(entry));
+        while (name.startsWith('/'))
+            name.remove(0, 1);
+        if (!predicate(name)) {
+            archive_read_data_skip(a);
+            continue;
+        }
+        QByteArray data;
+        const la_int64_t expected = archive_entry_size(entry);
+        if (expected > 0 && expected < kMaxZipEntryBytes)
+            data.reserve(static_cast<qsizetype>(expected));
+
+        char buf[16384];
+        la_ssize_t n = 0;
+        while ((n = archive_read_data(a, buf, sizeof(buf))) > 0) {
+            if (data.size() + n > kMaxZipEntryBytes || totalRead + n > kMaxZipTotalBytes) {
+                data.append(buf, static_cast<qsizetype>(std::max<qint64>(0, kMaxZipEntryBytes - data.size())));
+                break;
+            }
+            data.append(buf, static_cast<qsizetype>(n));
+            totalRead += n;
+        }
+        entries.insert(name, data);
+        if (totalRead >= kMaxZipTotalBytes)
+            break;
+    }
+    archive_read_free(a);
+    return entries;
+}
+
+int visualWidth(const QString &s) {
+    int w = 0;
+    const int limit = std::min<int>(s.size(), 60);
+    for (int i = 0; i < limit; ++i) {
+        const ushort ch = s.at(i).unicode();
+        // CJK Unified Ideographs, punctuation, fullwidth forms.
+        if ((ch >= 0x2E80 && ch <= 0x9FFF) || (ch >= 0xF900 && ch <= 0xFAFF) || (ch >= 0xFF00 && ch <= 0xFFEF))
+            w += 2;
+        else
+            w += 1;
+    }
+    return w;
+}
+
+void computeColWidths(SheetData &sheet) {
+    sheet.colWidths.fill(78, sheet.colCount);
+    const int sampleRows = std::min<int>(sheet.rows.size(), 100);
+    for (int r = 0; r < sampleRows; ++r) {
+        const QStringList &row = sheet.rows.at(r);
+        const int cols = std::min<int>(row.size(), sheet.colCount);
+        for (int c = 0; c < cols; ++c) {
+            const QString &cell = row.at(c);
+            if (cell.isEmpty())
+                continue;
+            const qsizetype nl = cell.indexOf('\n');
+            const QString firstLine = nl >= 0 ? cell.left(nl) : cell;
+            const int px = std::clamp(visualWidth(firstLine) * 8 + 24, 72, 320);
+            if (px > sheet.colWidths[c])
+                sheet.colWidths[c] = px;
+        }
+    }
+}
+
+int parseColumnRef(QStringView ref) {
+    int col = 0;
+    bool any = false;
+    for (QChar ch : ref) {
+        if (ch >= 'A' && ch <= 'Z') {
+            col = col * 26 + (ch.unicode() - 'A' + 1);
+            any = true;
+        } else if (ch >= 'a' && ch <= 'z') {
+            col = col * 26 + (ch.unicode() - 'a' + 1);
+            any = true;
+        } else {
+            break;
+        }
+    }
+    return any ? (col - 1) : -1;
+}
+
+bool isExcelDateFormatCode(const QString &code) {
+    QString cleaned;
+    cleaned.reserve(code.size());
+    bool inQuotes = false;
+    bool inBrackets = false;
+    for (int i = 0; i < code.size(); ++i) {
+        const QChar c = code.at(i);
+        if (c == '\\' && i + 1 < code.size()) {
+            ++i;
+            continue;
+        }
+        if (c == '"') {
+            inQuotes = !inQuotes;
+            continue;
+        }
+        if (inQuotes)
+            continue;
+        if (c == '[') {
+            inBrackets = true;
+            continue;
+        }
+        if (c == ']') {
+            inBrackets = false;
+            continue;
+        }
+        if (!inBrackets)
+            cleaned.append(c.toLower());
+    }
+    return cleaned.contains('y') || cleaned.contains('d') || cleaned.contains('h') ||
+           (cleaned.contains('m') && (cleaned.contains('/') || cleaned.contains('-') || cleaned.contains(':')));
+}
+
+QSet<int> parseXlsxDateStyles(const QByteArray &stylesXml) {
+    QSet<int> dateStyleIndices;
+    if (stylesXml.isEmpty())
+        return dateStyleIndices;
+
+    QHash<int, QString> customFormats;
+    QXmlStreamReader xml(stylesXml);
+    bool inCellXfs = false;
+    int xfIndex = 0;
+    while (!xml.atEnd()) {
+        xml.readNext();
+        if (xml.isStartElement()) {
+            const QStringView name = xml.name();
+            if (name == u"numFmt") {
+                const int id = xml.attributes().value(u"numFmtId").toInt();
+                const QString code = xml.attributes().value(u"formatCode").toString();
+                customFormats.insert(id, code);
+            } else if (name == u"cellXfs") {
+                inCellXfs = true;
+                xfIndex = 0;
+            } else if (inCellXfs && name == u"xf") {
+                const int numFmtId = xml.attributes().value(u"numFmtId").toInt();
+                const bool builtinDate = (numFmtId >= 14 && numFmtId <= 22) || (numFmtId >= 45 && numFmtId <= 47);
+                if (builtinDate || (customFormats.contains(numFmtId) && isExcelDateFormatCode(customFormats.value(numFmtId))))
+                    dateStyleIndices.insert(xfIndex);
+                ++xfIndex;
+            }
+        } else if (xml.isEndElement() && xml.name() == u"cellXfs") {
+            inCellXfs = false;
+        }
+    }
+    return dateStyleIndices;
+}
+
+QString formatExcelNumber(const QString &raw, bool isDate) {
+    bool ok = false;
+    const double val = raw.toDouble(&ok);
+    if (!ok)
+        return raw;
+    if (isDate && val >= 0.0 && val < 2958466.0) {
+        const qint64 days = static_cast<qint64>(std::floor(val));
+        const double frac = val - static_cast<double>(days);
+        // Excel epoch: 1899-12-30 (accounting for the 1900 leap year bug).
+        const QDate date = QDate(1899, 12, 30).addDays(days);
+        if (date.isValid()) {
+            if (frac > 1e-6) {
+                const int secs = qRound(frac * 86400.0);
+                const QTime time = QTime(0, 0).addSecs(secs % 86400);
+                if (days == 0)
+                    return time.toString(QStringLiteral("HH:mm:ss"));
+                return date.toString(Qt::ISODate) + QLatin1Char(' ') + time.toString(QStringLiteral("HH:mm"));
+            }
+            return date.toString(Qt::ISODate);
+        }
+    }
+    if (std::isfinite(val)) {
+        if (std::abs(val - std::round(val)) < 1e-9 && std::abs(val) < 1e15)
+            return QString::number(static_cast<qint64>(std::llround(val)));
+        QString formatted = QString::number(val, 'g', 12);
+        return formatted;
+    }
+    return raw;
+}
+
+QStringList parseXlsxSharedStrings(const QByteArray &xmlData) {
+    QStringList strings;
+    if (xmlData.isEmpty())
+        return strings;
+    QXmlStreamReader xml(xmlData);
+    while (!xml.atEnd()) {
+        xml.readNext();
+        if (xml.isStartElement() && xml.name() == u"si") {
+            QString text;
+            int depth = 1;
+            while (!xml.atEnd() && depth > 0) {
+                xml.readNext();
+                if (xml.isStartElement()) {
+                    ++depth;
+                    if (xml.name() == u"t") {
+                        text.append(xml.readElementText());
+                        --depth;
+                    }
+                } else if (xml.isEndElement()) {
+                    --depth;
+                }
+            }
+            strings.append(text);
+        }
+    }
+    return strings;
+}
+
+SheetData parseXlsxWorksheet(const QString &name,
+                             const QByteArray &xmlData,
+                             const QStringList &sharedStrings,
+                             const QSet<int> &dateStyles) {
+    SheetData sheet;
+    sheet.name = name;
+    if (xmlData.isEmpty())
+        return sheet;
+
+    QXmlStreamReader xml(xmlData);
+    while (!xml.atEnd()) {
+        xml.readNext();
+        if (xml.isStartElement() && xml.name() == u"row") {
+            if (sheet.rows.size() >= kMaxSheetRows) {
+                sheet.truncated = true;
+                break;
+            }
+            QStringList row;
+            int nextCol = 0;
+            int depth = 1;
+            while (!xml.atEnd() && depth > 0) {
+                xml.readNext();
+                if (xml.isStartElement()) {
+                    ++depth;
+                    if (xml.name() == u"c") {
+                        const auto attrs = xml.attributes();
+                        const int refCol = parseColumnRef(attrs.value(u"r"));
+                        const int col = refCol >= 0 ? refCol : nextCol;
+                        nextCol = col + 1;
+
+                        const QString type = attrs.value(u"t").toString();
+                        const int styleIdx = attrs.hasAttribute(u"s") ? attrs.value(u"s").toInt() : -1;
+                        QString value;
+
+                        int cellDepth = 1;
+                        while (!xml.atEnd() && cellDepth > 0) {
+                            xml.readNext();
+                            if (xml.isStartElement()) {
+                                ++cellDepth;
+                                if (xml.name() == u"v") {
+                                    value = xml.readElementText();
+                                    --cellDepth;
+                                } else if (xml.name() == u"t") {
+                                    value.append(xml.readElementText());
+                                    --cellDepth;
+                                }
+                            } else if (xml.isEndElement()) {
+                                --cellDepth;
+                            }
+                        }
+                        --depth;
+
+                        if (col >= kMaxSheetCols) {
+                            sheet.truncated = true;
+                            continue;
+                        }
+                        QString display;
+                        if (type == QLatin1String("s")) {
+                            bool ok = false;
+                            const int idx = value.toInt(&ok);
+                            if (ok && idx >= 0 && idx < sharedStrings.size())
+                                display = sharedStrings.at(idx);
+                        } else if (type == QLatin1String("b")) {
+                            display = (value == QLatin1String("1")) ? QStringLiteral("TRUE") : QStringLiteral("FALSE");
+                        } else if (type == QLatin1String("inlineStr") || type == QLatin1String("str") || type == QLatin1String("e")) {
+                            display = value;
+                        } else if (!value.isEmpty()) {
+                            display = formatExcelNumber(value, dateStyles.contains(styleIdx));
+                        }
+
+                        if (!display.isEmpty()) {
+                            if (row.size() <= col)
+                                row.resize(col + 1);
+                            row[col] = display;
+                        }
+                    }
+                } else if (xml.isEndElement()) {
+                    --depth;
+                }
+            }
+            // Trim trailing empty cells.
+            while (!row.isEmpty() && row.last().isEmpty())
+                row.removeLast();
+            if (!row.isEmpty() || !sheet.rows.isEmpty()) {
+                sheet.colCount = std::max<int>(sheet.colCount, row.size());
+                sheet.rows.append(std::move(row));
+            }
+        }
+    }
+
+    // Trim trailing completely empty rows.
+    while (!sheet.rows.isEmpty() && sheet.rows.last().isEmpty())
+        sheet.rows.removeLast();
+
+    // Normalize row lengths so QML views can index directly without bounds checks.
+    for (QStringList &row : sheet.rows) {
+        if (row.size() < sheet.colCount)
+            row.resize(sheet.colCount);
+    }
+    computeColWidths(sheet);
+    return sheet;
+}
+
+SpreadsheetResult parseXlsx(const QString &path) {
+    SpreadsheetResult result;
+    QString err;
+    const auto entries = readZipEntries(
+        path,
+        [](const QString &name) {
+            return name == QLatin1String("xl/workbook.xml") ||
+                   name == QLatin1String("xl/_rels/workbook.xml.rels") ||
+                   name == QLatin1String("xl/sharedStrings.xml") ||
+                   name == QLatin1String("xl/styles.xml") ||
+                   (name.startsWith(QLatin1String("xl/worksheets/")) && name.endsWith(QLatin1String(".xml")));
+        },
+        &err);
+    if (!err.isEmpty() && entries.isEmpty()) {
+        result.error = err;
+        return result;
+    }
+
+    const QStringList sharedStrings = parseXlsxSharedStrings(entries.value(QStringLiteral("xl/sharedStrings.xml")));
+    const QSet<int> dateStyles = parseXlsxDateStyles(entries.value(QStringLiteral("xl/styles.xml")));
+
+    // Map rId -> worksheet path from xl/_rels/workbook.xml.rels.
+    QHash<QString, QString> relTargets;
+    if (const QByteArray rels = entries.value(QStringLiteral("xl/_rels/workbook.xml.rels")); !rels.isEmpty()) {
+        QXmlStreamReader xml(rels);
+        while (!xml.atEnd()) {
+            xml.readNext();
+            if (xml.isStartElement() && xml.name() == u"Relationship") {
+                const QString id = xml.attributes().value(u"Id").toString();
+                QString target = xml.attributes().value(u"Target").toString();
+                if (target.startsWith('/'))
+                    target.remove(0, 1);
+                if (!target.startsWith(QLatin1String("xl/")))
+                    target.prepend(QStringLiteral("xl/"));
+                relTargets.insert(id, target);
+            }
+        }
+    }
+
+    struct SheetRef {
+        QString name;
+        QString target;
+    };
+    QVector<SheetRef> sheetRefs;
+    if (const QByteArray wb = entries.value(QStringLiteral("xl/workbook.xml")); !wb.isEmpty()) {
+        QXmlStreamReader xml(wb);
+        while (!xml.atEnd()) {
+            xml.readNext();
+            if (xml.isStartElement() && xml.name() == u"sheet") {
+                const QString name = xml.attributes().value(u"name").toString();
+                QString rid;
+                for (const auto &attr : xml.attributes()) {
+                    if (attr.name() == u"id") {
+                        rid = attr.value().toString();
+                        break;
+                    }
+                }
+                const QString target = relTargets.value(rid);
+                if (!target.isEmpty() && entries.contains(target))
+                    sheetRefs.append({name.isEmpty() ? QStringLiteral("Sheet") : name, target});
+            }
+        }
+    }
+
+    // Fallback: if workbook.xml didn't resolve targets, use worksheet XMLs sorted by name.
+    if (sheetRefs.isEmpty()) {
+        QStringList keys;
+        for (auto it = entries.constBegin(); it != entries.constEnd(); ++it) {
+            if (it.key().startsWith(QLatin1String("xl/worksheets/")))
+                keys.append(it.key());
+        }
+        keys.sort();
+        for (int i = 0; i < keys.size(); ++i)
+            sheetRefs.append({QStringLiteral("Sheet %1").arg(i + 1), keys.at(i)});
+    }
+
+    for (int i = 0; i < sheetRefs.size() && i < kMaxSheets; ++i) {
+        const auto &ref = sheetRefs.at(i);
+        result.sheets.append(parseXlsxWorksheet(ref.name, entries.value(ref.target), sharedStrings, dateStyles));
+    }
+
+    if (result.sheets.isEmpty())
+        result.error = QStringLiteral("No worksheets found.");
+    return result;
+}
+
+SpreadsheetResult parseOds(const QString &path) {
+    SpreadsheetResult result;
+    QString err;
+    const auto entries = readZipEntries(
+        path,
+        [](const QString &name) { return name == QLatin1String("content.xml"); },
+        &err);
+    const QByteArray content = entries.value(QStringLiteral("content.xml"));
+    if (content.isEmpty()) {
+        result.error = err.isEmpty() ? QStringLiteral("Missing content.xml.") : err;
+        return result;
+    }
+
+    QXmlStreamReader xml(content);
+    while (!xml.atEnd()) {
+        xml.readNext();
+        if (xml.isStartElement() && xml.name() == u"table") {
+            if (result.sheets.size() >= kMaxSheets)
+                break;
+            SheetData sheet;
+            for (const auto &attr : xml.attributes()) {
+                if (attr.name() == u"name") {
+                    sheet.name = attr.value().toString();
+                    break;
+                }
+            }
+            if (sheet.name.isEmpty())
+                sheet.name = QStringLiteral("Sheet %1").arg(result.sheets.size() + 1);
+
+            int tableDepth = 1;
+            while (!xml.atEnd() && tableDepth > 0) {
+                xml.readNext();
+                if (xml.isStartElement()) {
+                    ++tableDepth;
+                    if (xml.name() == u"table-row") {
+                        int repeatRows = 1;
+                        for (const auto &attr : xml.attributes()) {
+                            if (attr.name() == u"number-rows-repeated")
+                                repeatRows = std::clamp(attr.value().toInt(), 1, 64);
+                        }
+                        QStringList row;
+                        int rowDepth = 1;
+                        while (!xml.atEnd() && rowDepth > 0) {
+                            xml.readNext();
+                            if (xml.isStartElement()) {
+                                ++rowDepth;
+                                if (xml.name() == u"table-cell" || xml.name() == u"covered-table-cell") {
+                                    int repeatCols = 1;
+                                    for (const auto &attr : xml.attributes()) {
+                                        if (attr.name() == u"number-columns-repeated")
+                                            repeatCols = std::clamp(attr.value().toInt(), 1, kMaxSheetCols);
+                                    }
+                                    QString cellText;
+                                    int cellDepth = 1;
+                                    while (!xml.atEnd() && cellDepth > 0) {
+                                        xml.readNext();
+                                        if (xml.isStartElement()) {
+                                            ++cellDepth;
+                                            if (xml.name() == u"p") {
+                                                if (!cellText.isEmpty())
+                                                    cellText.append('\n');
+                                                cellText.append(xml.readElementText(QXmlStreamReader::IncludeChildElements));
+                                                --cellDepth;
+                                            }
+                                        } else if (xml.isEndElement()) {
+                                            --cellDepth;
+                                        }
+                                    }
+                                    --rowDepth;
+
+                                    if (cellText.isEmpty() && repeatCols > 32)
+                                        continue;
+                                    for (int c = 0; c < repeatCols && row.size() < kMaxSheetCols; ++c)
+                                        row.append(cellText);
+                                }
+                            } else if (xml.isEndElement()) {
+                                --rowDepth;
+                            }
+                        }
+                        --tableDepth;
+
+                        while (!row.isEmpty() && row.last().isEmpty())
+                            row.removeLast();
+                        if (!row.isEmpty()) {
+                            for (int r = 0; r < repeatRows && sheet.rows.size() < kMaxSheetRows; ++r) {
+                                sheet.colCount = std::max<int>(sheet.colCount, row.size());
+                                sheet.rows.append(row);
+                            }
+                        } else if (!sheet.rows.isEmpty() && repeatRows <= 4 && sheet.rows.size() < kMaxSheetRows) {
+                            sheet.rows.append(QStringList{});
+                        }
+                    }
+                } else if (xml.isEndElement()) {
+                    --tableDepth;
+                }
+            }
+            while (!sheet.rows.isEmpty() && sheet.rows.last().isEmpty())
+                sheet.rows.removeLast();
+            for (QStringList &row : sheet.rows) {
+                if (row.size() < sheet.colCount)
+                    row.resize(sheet.colCount);
+            }
+            computeColWidths(sheet);
+            result.sheets.append(std::move(sheet));
+        }
+    }
+
+    if (result.sheets.isEmpty())
+        result.error = QStringLiteral("No worksheets found.");
+    return result;
+}
+
+bool isValidUtf8(const QByteArray &data) {
+    const uchar *bytes = reinterpret_cast<const uchar *>(data.constData());
+    const qsizetype len = data.size();
+    qsizetype i = 0;
+    while (i < len) {
+        const uchar c = bytes[i];
+        if (c < 0x80) {
+            ++i;
+        } else if ((c & 0xE0) == 0xC0) {
+            if (i + 1 >= len || (bytes[i + 1] & 0xC0) != 0x80 || c < 0xC2)
+                return false;
+            i += 2;
+        } else if ((c & 0xF0) == 0xE0) {
+            if (i + 2 >= len || (bytes[i + 1] & 0xC0) != 0x80 || (bytes[i + 2] & 0xC0) != 0x80)
+                return false;
+            i += 3;
+        } else if ((c & 0xF8) == 0xF0) {
+            if (i + 3 >= len || (bytes[i + 1] & 0xC0) != 0x80 || (bytes[i + 2] & 0xC0) != 0x80 ||
+                (bytes[i + 3] & 0xC0) != 0x80 || c > 0xF4)
+                return false;
+            i += 4;
+        } else {
+            return false;
+        }
+    }
+    return true;
+}
+
+QString decodeTextAuto(const QByteArray &raw) {
+    if (raw.startsWith("\xEF\xBB\xBF"))
+        return QString::fromUtf8(raw.mid(3));
+    if (isValidUtf8(raw))
+        return QString::fromUtf8(raw);
+    // Fallback for GB18030/GBK CSV exports common on Windows/Chinese systems.
+    iconv_t cd = iconv_open("UTF-8//IGNORE", "GB18030");
+    if (cd != reinterpret_cast<iconv_t>(-1)) {
+        QByteArray out(raw.size() * 2 + 16, Qt::Uninitialized);
+        char *inPtr = const_cast<char *>(raw.constData());
+        size_t inLeft = static_cast<size_t>(raw.size());
+        char *outPtr = out.data();
+        size_t outLeft = static_cast<size_t>(out.size());
+        if (iconv(cd, &inPtr, &inLeft, &outPtr, &outLeft) != static_cast<size_t>(-1)) {
+            iconv_close(cd);
+            out.resize(static_cast<qsizetype>(out.size() - outLeft));
+            return QString::fromUtf8(out);
+        }
+        iconv_close(cd);
+    }
+    return QString::fromUtf8(raw);
+}
+
+SpreadsheetResult parseCsv(const QString &path) {
+    SpreadsheetResult result;
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly)) {
+        result.error = file.errorString();
+        return result;
+    }
+    constexpr qint64 kCsvByteLimit = 4LL * 1024 * 1024;
+    const QByteArray raw = file.read(kCsvByteLimit + 1);
+    const bool byteTruncated = raw.size() > kCsvByteLimit;
+    const QString text = decodeTextAuto(byteTruncated ? raw.left(kCsvByteLimit) : raw);
+
+    QChar sep = ',';
+    if (extensionLower(path) == QLatin1String("tsv")) {
+        sep = '\t';
+    } else {
+        const qsizetype firstNl = text.indexOf('\n');
+        const QStringView firstLine = firstNl >= 0 ? QStringView(text).left(firstNl) : QStringView(text);
+        if (firstLine.count(',') == 0) {
+            if (firstLine.count('\t') > 0)
+                sep = '\t';
+            else if (firstLine.count(';') > 0)
+                sep = ';';
+        }
+    }
+
+    SheetData sheet;
+    sheet.name = QFileInfo(path).completeBaseName();
+    if (sheet.name.isEmpty())
+        sheet.name = QStringLiteral("CSV");
+    sheet.truncated = byteTruncated;
+
+    QStringList row;
+    QString field;
+    bool inQuotes = false;
+    const qsizetype n = text.size();
+    for (qsizetype i = 0; i < n; ++i) {
+        const QChar c = text.at(i);
+        if (inQuotes) {
+            if (c == '"') {
+                if (i + 1 < n && text.at(i + 1) == '"') {
+                    field.append('"');
+                    ++i;
+                } else {
+                    inQuotes = false;
+                }
+            } else {
+                field.append(c);
+            }
+        } else {
+            if (c == '"' && field.isEmpty()) {
+                inQuotes = true;
+            } else if (c == sep) {
+                if (row.size() < kMaxSheetCols)
+                    row.append(field);
+                else
+                    sheet.truncated = true;
+                field.clear();
+            } else if (c == '\n' || c == '\r') {
+                if (c == '\r' && i + 1 < n && text.at(i + 1) == '\n')
+                    ++i;
+                if (row.size() < kMaxSheetCols)
+                    row.append(field);
+                field.clear();
+                sheet.colCount = std::max<int>(sheet.colCount, row.size());
+                sheet.rows.append(std::move(row));
+                row.clear();
+                if (sheet.rows.size() >= kMaxSheetRows) {
+                    sheet.truncated = true;
+                    break;
+                }
+            } else {
+                field.append(c);
+            }
+        }
+    }
+    if (!field.isEmpty() || !row.isEmpty()) {
+        if (row.size() < kMaxSheetCols)
+            row.append(field);
+        sheet.colCount = std::max<int>(sheet.colCount, row.size());
+        sheet.rows.append(std::move(row));
+    }
+
+    while (!sheet.rows.isEmpty() && sheet.rows.last().isEmpty())
+        sheet.rows.removeLast();
+    for (QStringList &r : sheet.rows) {
+        if (r.size() < sheet.colCount)
+            r.resize(sheet.colCount);
+    }
+    computeColWidths(sheet);
+    result.sheets.append(std::move(sheet));
+    return result;
+}
+
+QString htmlEscape(const QString &s) {
+    QString out;
+    out.reserve(s.size() + 16);
+    for (QChar c : s) {
+        switch (c.unicode()) {
+        case '&': out.append(QStringLiteral("&amp;")); break;
+        case '<': out.append(QStringLiteral("&lt;")); break;
+        case '>': out.append(QStringLiteral("&gt;")); break;
+        case '"': out.append(QStringLiteral("&quot;")); break;
+        default: out.append(c); break;
+        }
+    }
+    return out;
+}
+
+int headingLevelFromStyle(const QString &styleId, const QHash<QString, QString> &styleNames) {
+    const QString lower = styleId.toLower();
+    const QString nameLower = styleNames.value(styleId).toLower();
+    auto check = [](const QString &s) -> int {
+        if (s == QLatin1String("title") || s == QLatin1String("标题"))
+            return 1;
+        if (s == QLatin1String("subtitle") || s == QLatin1String("副标题"))
+            return 2;
+        for (int lvl = 1; lvl <= 4; ++lvl) {
+            if (s == QStringLiteral("heading%1").arg(lvl) ||
+                s == QStringLiteral("heading %1").arg(lvl) ||
+                s == QStringLiteral("标题 %1").arg(lvl) ||
+                s == QStringLiteral("标题%1").arg(lvl))
+                return lvl;
+        }
+        return 0;
+    };
+    if (const int l = check(lower); l > 0)
+        return l;
+    return check(nameLower);
+}
+
+QHash<QString, QString> parseDocxStyleNames(const QByteArray &stylesXml) {
+    QHash<QString, QString> names;
+    if (stylesXml.isEmpty())
+        return names;
+    QXmlStreamReader xml(stylesXml);
+    QString currentId;
+    while (!xml.atEnd()) {
+        xml.readNext();
+        if (xml.isStartElement()) {
+            if (xml.name() == u"style") {
+                currentId = xml.attributes().value(u"styleId").toString();
+            } else if (!currentId.isEmpty() && xml.name() == u"name") {
+                names.insert(currentId, xml.attributes().value(u"val").toString());
+            }
+        } else if (xml.isEndElement() && xml.name() == u"style") {
+            currentId.clear();
+        }
+    }
+    return names;
+}
+
+QString parseDocxParagraph(QXmlStreamReader &xml,
+                           const QHash<QString, QString> &styleNames,
+                           int &charCount,
+                           bool inTableCell) {
+    QString styleId;
+    QString align;
+    bool isList = false;
+    QString innerHtml;
+
+    int depth = 1;
+    while (!xml.atEnd() && depth > 0) {
+        xml.readNext();
+        if (xml.isStartElement()) {
+            ++depth;
+            const QStringView name = xml.name();
+            if (name == u"pStyle") {
+                styleId = xml.attributes().value(u"val").toString();
+            } else if (name == u"jc") {
+                align = xml.attributes().value(u"val").toString().toLower();
+            } else if (name == u"numPr") {
+                isList = true;
+            } else if (name == u"r") {
+                bool bold = false;
+                bool italic = false;
+                bool underline = false;
+                bool strike = false;
+                QString runText;
+
+                int rDepth = 1;
+                while (!xml.atEnd() && rDepth > 0) {
+                    xml.readNext();
+                    if (xml.isStartElement()) {
+                        ++rDepth;
+                        const QStringView rn = xml.name();
+                        if (rn == u"b") {
+                            const QString val = xml.attributes().value(u"val").toString();
+                            bold = (val != QLatin1String("0") && val != QLatin1String("false"));
+                        } else if (rn == u"i") {
+                            const QString val = xml.attributes().value(u"val").toString();
+                            italic = (val != QLatin1String("0") && val != QLatin1String("false"));
+                        } else if (rn == u"u") {
+                            const QString val = xml.attributes().value(u"val").toString();
+                            underline = (val != QLatin1String("none"));
+                        } else if (rn == u"strike") {
+                            const QString val = xml.attributes().value(u"val").toString();
+                            strike = (val != QLatin1String("0") && val != QLatin1String("false"));
+                        } else if (rn == u"t") {
+                            const QString t = xml.readElementText();
+                            --rDepth;
+                            runText.append(htmlEscape(t));
+                            charCount += t.size();
+                        } else if (rn == u"tab") {
+                            runText.append(QStringLiteral("&nbsp;&nbsp;&nbsp;&nbsp;"));
+                        } else if (rn == u"br" || rn == u"cr") {
+                            runText.append(QStringLiteral("<br/>"));
+                        }
+                    } else if (xml.isEndElement()) {
+                        --rDepth;
+                    }
+                }
+                --depth;
+
+                if (!runText.isEmpty()) {
+                    if (bold)
+                        runText = QStringLiteral("<b>") + runText + QStringLiteral("</b>");
+                    if (italic)
+                        runText = QStringLiteral("<i>") + runText + QStringLiteral("</i>");
+                    if (underline)
+                        runText = QStringLiteral("<u>") + runText + QStringLiteral("</u>");
+                    if (strike)
+                        runText = QStringLiteral("<s>") + runText + QStringLiteral("</s>");
+                    innerHtml.append(runText);
+                }
+            }
+        } else if (xml.isEndElement()) {
+            --depth;
+        }
+    }
+
+    if (innerHtml.trimmed().isEmpty())
+        return inTableCell ? QString() : QStringLiteral("<p style='margin:6px 0;'>&nbsp;</p>");
+
+    QString alignStyle;
+    if (align == QLatin1String("center"))
+        alignStyle = QStringLiteral("text-align:center;");
+    else if (align == QLatin1String("right"))
+        alignStyle = QStringLiteral("text-align:right;");
+
+    if (inTableCell)
+        return QStringLiteral("<div style='margin:2px 0;%1'>%2</div>").arg(alignStyle, innerHtml);
+
+    const int heading = headingLevelFromStyle(styleId, styleNames);
+    if (heading == 1)
+        return QStringLiteral("<h1 style='font-size:20px;font-weight:600;margin:18px 0 10px 0;%1'>%2</h1>").arg(alignStyle, innerHtml);
+    if (heading == 2)
+        return QStringLiteral("<h2 style='font-size:17px;font-weight:600;margin:16px 0 8px 0;%1'>%2</h2>").arg(alignStyle, innerHtml);
+    if (heading == 3)
+        return QStringLiteral("<h3 style='font-size:15px;font-weight:600;margin:14px 0 6px 0;%1'>%2</h3>").arg(alignStyle, innerHtml);
+    if (heading == 4)
+        return QStringLiteral("<h4 style='font-size:14px;font-weight:600;margin:12px 0 4px 0;%1'>%2</h4>").arg(alignStyle, innerHtml);
+
+    if (isList)
+        return QStringLiteral("<p style='margin:4px 0 4px 18px;line-height:1.65;%1'>•&nbsp;%2</p>").arg(alignStyle, innerHtml);
+
+    return QStringLiteral("<p style='margin:6px 0;line-height:1.65;%1'>%2</p>").arg(alignStyle, innerHtml);
+}
+
+QString parseDocxTable(QXmlStreamReader &xml,
+                       const QHash<QString, QString> &styleNames,
+                       int &charCount,
+                       int &cellCount,
+                       bool &truncated) {
+    QString html = QStringLiteral("<table border='1' cellspacing='0' cellpadding='6' width='100%' "
+                                  "style='border-collapse:collapse;margin:12px 0;'>");
+    int rowIndex = 0;
+    int depth = 1;
+    while (!xml.atEnd() && depth > 0) {
+        xml.readNext();
+        if (xml.isStartElement()) {
+            ++depth;
+            if (xml.name() == u"tr") {
+                html.append(QStringLiteral("<tr>"));
+                int trDepth = 1;
+                while (!xml.atEnd() && trDepth > 0) {
+                    xml.readNext();
+                    if (xml.isStartElement()) {
+                        ++trDepth;
+                        if (xml.name() == u"tc") {
+                            int span = 1;
+                            QString cellBody;
+                            int tcDepth = 1;
+                            while (!xml.atEnd() && tcDepth > 0) {
+                                xml.readNext();
+                                if (xml.isStartElement()) {
+                                    ++tcDepth;
+                                    if (xml.name() == u"gridSpan") {
+                                        span = std::max(1, xml.attributes().value(u"val").toInt());
+                                    } else if (xml.name() == u"p") {
+                                        cellBody.append(parseDocxParagraph(xml, styleNames, charCount, true));
+                                        --tcDepth;
+                                    }
+                                } else if (xml.isEndElement()) {
+                                    --tcDepth;
+                                }
+                            }
+                            --trDepth;
+                            ++cellCount;
+                            const QString tag = (rowIndex == 0) ? QStringLiteral("th") : QStringLiteral("td");
+                            const QString spanAttr = span > 1 ? QStringLiteral(" colspan='%1'").arg(span) : QString();
+                            const QString weight = (rowIndex == 0) ? QStringLiteral(" style='font-weight:600;text-align:left;'") : QString();
+                            html.append(QStringLiteral("<%1%2%3>%4</%1>")
+                                            .arg(tag, spanAttr, weight, cellBody.isEmpty() ? QStringLiteral("&nbsp;") : cellBody));
+                        }
+                    } else if (xml.isEndElement()) {
+                        --trDepth;
+                    }
+                }
+                --depth;
+                html.append(QStringLiteral("</tr>"));
+                ++rowIndex;
+                if (cellCount >= kMaxDocTableCells || charCount >= kMaxDocChars) {
+                    truncated = true;
+                    // Drain remaining table XML cleanly.
+                    while (!xml.atEnd() && depth > 0) {
+                        xml.readNext();
+                        if (xml.isStartElement())
+                            ++depth;
+                        else if (xml.isEndElement())
+                            --depth;
+                    }
+                    break;
+                }
+            }
+        } else if (xml.isEndElement()) {
+            --depth;
+        }
+    }
+    html.append(QStringLiteral("</table>"));
+    return html;
+}
+
+DocumentResult parseDocx(const QString &path) {
+    DocumentResult result;
+    QString err;
+    const auto entries = readZipEntries(
+        path,
+        [](const QString &name) {
+            return name == QLatin1String("word/document.xml") || name == QLatin1String("word/styles.xml");
+        },
+        &err);
+    const QByteArray docXml = entries.value(QStringLiteral("word/document.xml"));
+    if (docXml.isEmpty()) {
+        result.error = err.isEmpty() ? QStringLiteral("Not a valid DOCX file.") : err;
+        return result;
+    }
+
+    const QHash<QString, QString> styleNames = parseDocxStyleNames(entries.value(QStringLiteral("word/styles.xml")));
+    QXmlStreamReader xml(docXml);
+    QString html;
+    html.reserve(16384);
+    int charCount = 0;
+    int cellCount = 0;
+
+    while (!xml.atEnd()) {
+        xml.readNext();
+        if (xml.isStartElement() && xml.name() == u"body") {
+            int bodyDepth = 1;
+            while (!xml.atEnd() && bodyDepth > 0) {
+                xml.readNext();
+                if (xml.isStartElement()) {
+                    ++bodyDepth;
+                    if (xml.name() == u"p") {
+                        html.append(parseDocxParagraph(xml, styleNames, charCount, false));
+                        --bodyDepth;
+                    } else if (xml.name() == u"tbl") {
+                        html.append(parseDocxTable(xml, styleNames, charCount, cellCount, result.truncated));
+                        --bodyDepth;
+                    }
+                    if (charCount >= kMaxDocChars || cellCount >= kMaxDocTableCells) {
+                        result.truncated = true;
+                        break;
+                    }
+                } else if (xml.isEndElement()) {
+                    --bodyDepth;
+                }
+            }
+            break;
+        }
+    }
+
+    result.html = html;
+    return result;
+}
+
+DocumentResult parsePptx(const QString &path) {
+    DocumentResult result;
+    QString err;
+    const auto entries = readZipEntries(
+        path,
+        [](const QString &name) {
+            return name.startsWith(QLatin1String("ppt/slides/slide")) && name.endsWith(QLatin1String(".xml"));
+        },
+        &err);
+    if (entries.isEmpty()) {
+        result.error = err.isEmpty() ? QStringLiteral("No slides found.") : err;
+        return result;
+    }
+
+    struct SlideEntry {
+        int number = 0;
+        QString key;
+    };
+    QVector<SlideEntry> slides;
+    for (auto it = entries.constBegin(); it != entries.constEnd(); ++it) {
+        const QString &k = it.key();
+        // ppt/slides/slide12.xml
+        const QString numStr = k.mid(16, k.size() - 20);
+        bool ok = false;
+        const int num = numStr.toInt(&ok);
+        if (ok)
+            slides.append({num, k});
+    }
+    std::sort(slides.begin(), slides.end(), [](const SlideEntry &a, const SlideEntry &b) {
+        return a.number < b.number;
+    });
+
+    QString html;
+    int charCount = 0;
+    for (const auto &s : slides) {
+        QXmlStreamReader xml(entries.value(s.key));
+        QStringList paragraphs;
+        while (!xml.atEnd()) {
+            xml.readNext();
+            if (xml.isStartElement() && xml.name() == u"p") {
+                QString pText;
+                int pDepth = 1;
+                while (!xml.atEnd() && pDepth > 0) {
+                    xml.readNext();
+                    if (xml.isStartElement()) {
+                        ++pDepth;
+                        if (xml.name() == u"t") {
+                            pText.append(xml.readElementText());
+                            --pDepth;
+                        }
+                    } else if (xml.isEndElement()) {
+                        --pDepth;
+                    }
+                }
+                if (!pText.trimmed().isEmpty()) {
+                    paragraphs.append(pText.trimmed());
+                    charCount += pText.size();
+                }
+            }
+        }
+        html.append(QStringLiteral("<h3 style='font-size:13px;font-weight:600;margin:18px 0 6px 0;opacity:0.65;'>Slide %1</h3>")
+                        .arg(s.number));
+        if (paragraphs.isEmpty()) {
+            html.append(QStringLiteral("<p style='margin:4px 0 12px 0;opacity:0.5;'>(Visual slide)</p>"));
+        } else {
+            html.append(QStringLiteral("<h2 style='font-size:17px;font-weight:600;margin:4px 0 8px 0;'>%1</h2>")
+                            .arg(htmlEscape(paragraphs.first())));
+            for (int i = 1; i < paragraphs.size(); ++i) {
+                html.append(QStringLiteral("<p style='margin:4px 0 4px 14px;line-height:1.6;'>•&nbsp;%1</p>")
+                                .arg(htmlEscape(paragraphs.at(i))));
+            }
+        }
+        html.append(QStringLiteral("<hr/>"));
+        if (charCount >= kMaxDocChars) {
+            result.truncated = true;
+            break;
+        }
+    }
+
+    result.html = html;
+    return result;
+}
+
+DocumentResult parseOdt(const QString &path) {
+    DocumentResult result;
+    QString err;
+    const auto entries = readZipEntries(
+        path,
+        [](const QString &name) { return name == QLatin1String("content.xml"); },
+        &err);
+    const QByteArray content = entries.value(QStringLiteral("content.xml"));
+    if (content.isEmpty()) {
+        result.error = err.isEmpty() ? QStringLiteral("Missing content.xml.") : err;
+        return result;
+    }
+
+    QXmlStreamReader xml(content);
+    QString html;
+    int charCount = 0;
+    while (!xml.atEnd()) {
+        xml.readNext();
+        if (xml.isStartElement()) {
+            if (xml.name() == u"h") {
+                int level = 2;
+                for (const auto &attr : xml.attributes()) {
+                    if (attr.name() == u"outline-level")
+                        level = std::clamp(attr.value().toInt(), 1, 4);
+                }
+                const QString text = xml.readElementText(QXmlStreamReader::IncludeChildElements).trimmed();
+                if (!text.isEmpty()) {
+                    charCount += text.size();
+                    html.append(QStringLiteral("<h%1 style='font-weight:600;margin:14px 0 6px 0;'>%2</h%1>")
+                                    .arg(level)
+                                    .arg(htmlEscape(text)));
+                }
+            } else if (xml.name() == u"p") {
+                const QString text = xml.readElementText(QXmlStreamReader::IncludeChildElements);
+                if (!text.trimmed().isEmpty()) {
+                    charCount += text.size();
+                    html.append(QStringLiteral("<p style='margin:6px 0;line-height:1.65;'>%1</p>").arg(htmlEscape(text)));
+                }
+            }
+            if (charCount >= kMaxDocChars) {
+                result.truncated = true;
+                break;
+            }
+        }
+    }
+    result.html = html;
+    return result;
+}
