+    void gridRightClickHitsItemUnderCursorWhenScrolled()
+    {
+        QTemporaryDir dir;
+        for (int i = 0; i < 30; ++i)
+            write(dir.filePath(QString("file-%1.txt").arg(i, 2, 10, QChar('0'))), "x");
+
+        Backend backend(dir.path());
+        backend.navigate(dir.path());
+        QTRY_COMPARE(backend.folder()->rowCount(), 30);
+        Theme theme(dir.filePath("theme"));
+        FileOps fileOps;
+        Translator translator;
+        Plugins plugins({});
+
+        QQmlEngine engine;
+        engine.rootContext()->setContextProperty("backend", &backend);
+        engine.rootContext()->setContextProperty("theme", &theme);
+        engine.rootContext()->setContextProperty("fileOps", &fileOps);
+        engine.rootContext()->setContextProperty("translator", &translator);
+        engine.rootContext()->setContextProperty("plugins", &plugins);
+        QQmlComponent component(&engine);
+        component.setData(R"(
+            import QtQuick
+            Window {
+                width: 560; height: 260; visible: true
+                property string menuPath: ""
+                property int menuCount: 0
+                property alias grid: gridView
+                FolderGrid {
+                    id: gridView
+                    anchors.fill: parent
+                    onContextMenu: (item, folder, at) => {
+                        menuPath = item ? item.path : ""
+                        menuCount++
+                    }
+                }
+            }
+        )", QUrl::fromLocalFile(sourceFolder() + "/ListRightClickTest.qml"));
+        QVERIFY2(component.isReady(), qPrintable(component.errorString()));
+        std::unique_ptr<QQuickWindow> window(qobject_cast<QQuickWindow *>(component.create()));
+        QVERIFY(window);
+        QVERIFY(QTest::qWaitForWindowExposed(window.get()));
+        auto *grid = window->property("grid").value<QQuickItem *>();
+        QVERIFY(grid);
+
+        const int columns = grid->property("columns").toInt();
+        const int cellWidth = grid->property("cellWidth").toInt();
+        const int cellHeight = grid->property("cellHeight").toInt();
+        QVERIFY(columns >= 2);
+        QVERIFY(cellHeight > 0);
+
+        // Scroll down by two full rows, then right-click column 1 of the top visible row.
+        grid->setProperty("contentY", qreal(cellHeight * 2));
+        const int expectedIndex = columns * 2 + 1;
+        const QPoint clickPos(cellWidth + cellWidth / 2, cellHeight / 2);
+        QTest::mouseClick(window.get(), Qt::RightButton, {}, clickPos);
+        QTRY_COMPARE(window->property("menuCount").toInt(), 1);
+        QCOMPARE(window->property("menuPath").toString(),
+                 dir.filePath(QString("file-%1.txt").arg(expectedIndex, 2, 10, QChar('0'))));
+        QVERIFY(backend.folder()->isSelected(expectedIndex));
+    }
