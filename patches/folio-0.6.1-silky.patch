+void Places::mountDevice(const QString &device) {
+    if (device.isEmpty())
+        return;
+    static GVolumeMonitor *const monitor = g_volume_monitor_get();
+    GList *volumes = g_volume_monitor_get_volumes(monitor);
+    GVolume *found = nullptr;
+    for (GList *l = volumes; l && !found; l = l->next) {
+        GVolume *vol = G_VOLUME(l->data);
+        char *devRaw = g_volume_get_identifier(vol, G_VOLUME_IDENTIFIER_KIND_UNIX_DEVICE);
+        if (devRaw && QString::fromUtf8(devRaw) == device)
+            found = G_VOLUME(g_object_ref(vol));
+        g_free(devRaw);
+    }
+    g_list_free_full(volumes, g_object_unref);
+    if (!found) {
+        emit failed(tr("Couldn't find %1 to mount.").arg(device));
+        return;
+    }
+    if (const QString existing = volumeMountPath(found); !existing.isEmpty()) {
+        g_object_unref(found);
+        refresh();
+        emit deviceMounted(existing);
+        return;
+    }
+    char *nameRaw = g_volume_get_name(found);
+    const QString name = QString::fromUtf8(nameRaw ? nameRaw : "").trimmed();
+    g_free(nameRaw);
+    auto *context = new VolumeMount{this, name.isEmpty() ? device : name};
+    GMountOperation *op = g_mount_operation_new();
+    g_volume_mount(found, G_MOUNT_MOUNT_NONE, op, nullptr, volumeMounted, context);
+    g_object_unref(op);
+    g_object_unref(found);
+}
