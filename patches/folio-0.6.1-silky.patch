+QVariantMap FileOps::propertiesFor(const QString &path) const {
+    QVariantMap out;
+    if (path.isEmpty())
+        return out;
+    const QFileInfo info(path);
+    const QString mime = mimeFor(path);
+    const QMimeType mimeType = QMimeDatabase().mimeTypeForName(mime);
+    const bool isDir = info.isDir();
+
+    out.insert("name", info.fileName().isEmpty() ? path : info.fileName());
+    out.insert("path", path);
+    out.insert("parent", info.path());
+    out.insert("isDir", isDir);
+    out.insert("isSymlink", info.isSymLink());
+    out.insert("symlinkTarget", info.isSymLink() ? info.symLinkTarget() : QString());
+    out.insert("mime", mime);
+    out.insert("kind", isDir ? tr("Folder") : (!mimeType.comment().isEmpty() ? mimeType.comment() : mime));
+    out.insert("extension", isDir ? QString() : info.suffix().toLower());
+    out.insert("size", isDir ? qint64(-1) : info.size());
+    out.insert("itemCount", isDir ? static_cast<int>(QDir(path).entryList(QDir::AllEntries | QDir::NoDotAndDotDot | QDir::Hidden | QDir::System).size()) : 0);
+    out.insert("modified", info.lastModified());
+    out.insert("created", info.birthTime().isValid() ? info.birthTime() : QDateTime());
+
+    struct stat st{};
+    if (lstat(path.toUtf8().constData(), &st) == 0) {
+        const mode_t m = st.st_mode;
+        auto triad = [](mode_t bits, mode_t r, mode_t w, mode_t x) {
+            const char buf[3] = {(bits & r) ? 'r' : '-', (bits & w) ? 'w' : '-', (bits & x) ? 'x' : '-'};
+            return QString::fromLatin1(buf, 3);
+        };
+        const QString symbolic = triad(m, S_IRUSR, S_IWUSR, S_IXUSR)
+                               + triad(m, S_IRGRP, S_IWGRP, S_IXGRP)
+                               + triad(m, S_IROTH, S_IWOTH, S_IXOTH);
+        const QString octal = QStringLiteral("%1").arg(m & 07777, 4, 8, QLatin1Char('0'));
+        out.insert("permissions", QStringLiteral("%1 (%2)").arg(symbolic, octal));
+    }
+
+    const QString owner = info.owner();
+    const QString group = info.group();
+    if (!owner.isEmpty() || !group.isEmpty())
+        out.insert("owner", group.isEmpty() ? owner : (owner + QLatin1Char(':') + group));
+    return out;
+}
