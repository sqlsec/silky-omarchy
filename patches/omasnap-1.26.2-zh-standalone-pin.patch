+      std::max(original.width(), original.height()));
+  const qreal scale = std::clamp(zoom, std::min(minimum, limit), limit);
+  return {std::max(1, qRound(original.width() * scale)),
+          std::max(1, qRound(original.height() * scale))};
 }
 
