+const Annotation *CaptureEditor::selectedRedaction() const {
+  if (selectedAnnotation_ < 0 || selectedAnnotation_ >= annotations_.size())
+    return nullptr;
+  const auto &annotation = annotations_.at(selectedAnnotation_);
+  return annotation.kind == Annotation::Kind::Redaction ? &annotation : nullptr;
+}
+
+RedactionStyle CaptureEditor::currentRedactionStyle() const {
+  const auto *annotation = selectedRedaction();
+  return annotation ? annotation->redactionStyle : redactionStyle_;
+}
+
+int CaptureEditor::currentRedactionLevel() const {
+  if (const auto *annotation = selectedRedaction())
+    return annotation->redactionLevel;
+  return redactionStyle_ == RedactionStyle::Mosaic ? mosaicLevel_ : blurLevel_;
+}
+
+QString CaptureEditor::redactionStatus() const {
+  const auto style = currentRedactionStyle();
+  return hasRedactionLevels(style)
+      ? QCoreApplication::translate("Omasnap", "Redact · %1 · %2 · Wheel")
+            .arg(redactionStyleName(style),
+                 redactionLevelName(currentRedactionLevel()))
+      : QCoreApplication::translate("Omasnap", "Redact · %1")
+            .arg(redactionStyleName(style));
+}
+
+void CaptureEditor::applyRedactionOption(RedactionStyle style, int level) {
+  int &preference = style == RedactionStyle::Mosaic ? mosaicLevel_ : blurLevel_;
+  if (hasRedactionLevels(style) && level > 0)
+    preference = std::clamp(level, kMinimumRedactionLevel, kMaximumRedactionLevel);
+  const int nextLevel = hasRedactionLevels(style) ? preference
+                                                 : kDefaultRedactionLevel;
+  redactionStyle_ = style;
+  if (const auto *annotation = selectedRedaction()) {
+    if (annotation->redactionStyle != style ||
+        annotation->redactionLevel != nextLevel) {
+      annotations_[selectedAnnotation_].redactionStyle = style;
+      annotations_[selectedAnnotation_].redactionLevel = nextLevel;
+      commitPatch({selectedAnnotation_});
+    }
+  } else {
+    tool_ = Tool::Redact;
+    selectedAnnotation_ = -1;
+  }
+  setStatus(redactionStatus());
+}
+
+void CaptureEditor::activateRedaction() {
+  if (tool_ != Tool::Redact && !selectedRedaction()) {
+    applyRedactionOption(redactionStyle_);
+    return;
+  }
+
+  const auto style = currentRedactionStyle();
+  applyRedactionOption(style == RedactionStyle::Blur ? RedactionStyle::Solid
+                       : style == RedactionStyle::Solid ? RedactionStyle::Mosaic
+                                                         : RedactionStyle::Blur);
+}
