+QImage sampleRedaction(const QImage &image, const QRect &region,
+                       RedactionStyle style, int level, qreal scaleX,
+                       qreal scaleY) {
+  constexpr std::array mosaicCellSizes{6, 14, 28};
+  constexpr std::array blurSampleSpacing{5, 12, 24};
+  const auto &steps = style == RedactionStyle::Blur ? blurSampleSpacing
+                                                    : mosaicCellSizes;
+  const auto spacing = steps.at(static_cast<std::size_t>(
+      std::clamp(level, kMinimumRedactionLevel, kMaximumRedactionLevel) - 1));
+  const auto sampleCount = [spacing](int pixels, qreal scale) {
+    // Always reduce detail even in a tiny region. Bound the thumbnail in a
+    // zoomed preview or a very long scroll capture.
+    return std::clamp(qCeil(pixels / std::max(2.0, spacing * scale)), 1, 512);
+  };
+  const QSize size(sampleCount(region.width(), scaleX),
+                   sampleCount(region.height(), scaleY));
+  QImage samples = image.copy(region).scaled(size, Qt::IgnoreAspectRatio,
+                                              Qt::SmoothTransformation)
+                       .convertToFormat(QImage::Format_RGB32);
+  if (style != RedactionStyle::Blur)
+    return samples;
+
+  // Binomial filtering softens the remaining cell transitions before
+  // bilinear interpolation spreads the colors back over the region.
+  for (const bool horizontal : {true, false}) {
+    QImage blurred(size, QImage::Format_RGB32);
+    for (int y = 0; y < size.height(); ++y) {
+      auto *output = reinterpret_cast<QRgb *>(blurred.scanLine(y));
+      for (int x = 0; x < size.width(); ++x) {
+        const QRgb center = samples.pixel(x, y);
+        const QRgb before = horizontal
+            ? samples.pixel(std::max(0, x - 1), y)
+            : samples.pixel(x, std::max(0, y - 1));
+        const QRgb after = horizontal
+            ? samples.pixel(std::min(size.width() - 1, x + 1), y)
+            : samples.pixel(x, std::min(size.height() - 1, y + 1));
+        output[x] = qRgb((qRed(before) + 2 * qRed(center) + qRed(after)) / 4,
+                         (qGreen(before) + 2 * qGreen(center) + qGreen(after)) / 4,
+                         (qBlue(before) + 2 * qBlue(center) + qBlue(after)) / 4);
+      }
+    }
+    samples = std::move(blurred);
+  }
+  return samples;
+}
