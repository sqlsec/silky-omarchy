+
+// Pointer positions arrive in fractional logical pixels (a touchpad on a 2x
+// output reports e.g. 100.37). An unsnapped edge makes the edit view crop one
+// extra native pixel, smooth-scale it back down and draw it off the device
+// grid, so the whole region visibly softens the moment the drag is released.
+qreal CaptureEditor::snapSourceX(qreal x) const {
+  if (capture_.source.isNull() || capture_.previewSize.width() <= 0)
+    return x;
+  const qreal scale =
+      capture_.source.width() / static_cast<qreal>(capture_.previewSize.width());
+  return scale > 0 ? std::round(x * scale) / scale : x;
+}
+
+qreal CaptureEditor::snapSourceY(qreal y) const {
+  if (capture_.source.isNull() || capture_.previewSize.height() <= 0)
+    return y;
+  const qreal scale = capture_.source.height() /
+                      static_cast<qreal>(capture_.previewSize.height());
+  return scale > 0 ? std::round(y * scale) / scale : y;
+}
+
+QRectF CaptureEditor::snapSelectionToSource(const QRectF &rect) const {
+  if (rect.isNull())
+    return rect;
+  return QRectF(QPointF(snapSourceX(rect.left()), snapSourceY(rect.top())),
+                QPointF(snapSourceX(rect.right()), snapSourceY(rect.bottom())));
 }
 
