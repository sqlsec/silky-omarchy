+/** Fractional pointer drags on a 2x capture land on whole native pixels. */
+bool runFractionalSelectionSnapCheck(QString &error) {
+  CaptureData capture;
+  capture.monitor.geometry = QRect(0, 0, 400, 300);
+  capture.monitor.pixelSize = QSize(800, 600);
+  capture.monitor.scale = 2.0;
+  capture.source = QImage(800, 600, QImage::Format_ARGB32_Premultiplied);
+  for (int y = 0; y < capture.source.height(); ++y)
+    for (int x = 0; x < capture.source.width(); ++x)
+      capture.source.setPixelColor(x, y, (x + y) % 2 ? Qt::white : Qt::black);
+  capture.previewSize = QSize(400, 300);
+
+  CaptureEditor editor(capture);
+  editor.resize(400, 300);
+  editor.show();
+  QApplication::processEvents();
+  const auto send = [&](QEvent::Type type, QPointF position,
+                        Qt::MouseButtons buttons) {
+    QMouseEvent event(type, position, editor.mapToGlobal(position),
+                      Qt::LeftButton, buttons, Qt::NoModifier);
+    QApplication::sendEvent(&editor, &event);
+  };
+  send(QEvent::MouseButtonPress, {50.37, 40.81}, Qt::LeftButton);
+  send(QEvent::MouseMove, {150.13, 120.62}, Qt::LeftButton);
+  send(QEvent::MouseMove, {250.29, 200.18}, Qt::LeftButton);
+  send(QEvent::MouseButtonRelease, {250.29, 200.18}, Qt::NoButton);
+  QApplication::processEvents();
+
+  const QRectF selection = editor.currentSelection();
+  for (const qreal edge : {selection.left(), selection.top(), selection.right(),
+                           selection.bottom()}) {
+    if (std::abs(edge * 2.0 - std::round(edge * 2.0)) > 1e-6) {
+      error = QStringLiteral("Selection edge %1 is off the native pixel grid")
+                  .arg(edge);
+      return false;
+    }
+  }
+  if (selection != QRectF(QPointF(50.5, 41.0), QPointF(250.5, 200.0))) {
+    error = QStringLiteral("Fractional selection snapped to the wrong pixels");
+    return false;
+  }
+  return true;
+}
