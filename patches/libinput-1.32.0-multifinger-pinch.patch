+/* Collect real MT slots participating in a 4- or 5-finger whole-hand gesture.
+ * A resting/anchoring thumb in the bottom software-button stripe or a wide
+ * thumb/pinky pad contact (PALM_TOUCH_SIZE / PALM_PRESSURE / PALM_EDGE) is
+ * part of the hand when >= 2 normal active fingers and 4-5 total real slots
+ * assemble within 350 ms (or are already tracked as a multifinger gesture).
+ */
+static unsigned int
+tp_gesture_collect_multifinger_touches(const struct tp_dispatch *tp,
+				       struct tp_touch **touches)
+{
+	unsigned int n = 0, normal_active = 0;
+	usec_t min_time = { 0 }, max_time = { 0 };
+
+	if (!tp->gesture.enabled || tp->num_slots < 4 ||
+	    (tp->buttons.is_clickpad && tp->buttons.state))
+		return 0;
+
+	for (unsigned int i = 0; i < tp->num_slots; i++) {
+		struct tp_touch *t = &tp->touches[i];
+
+		if (t->state != TOUCH_BEGIN && t->state != TOUCH_UPDATE)
+			continue;
+		if (t->palm.state == PALM_TYPING ||
+		    t->palm.state == PALM_TRACKPOINT ||
+		    t->palm.state == PALM_ARBITRATION ||
+		    t->palm.state == PALM_TOOL_PALM)
+			continue;
+		if (!tp_edge_scroll_touch_active(tp, t) ||
+		    !tp_circular_scroll_touch_active(tp, t))
+			continue;
+
+		if (n >= 5)
+			return 0;
+		touches[n++] = t;
+		if (tp_touch_active_for_gesture(tp, t))
+			normal_active++;
+		if (n == 1 || usec_cmp(t->initial_time, min_time) < 0)
+			min_time = t->initial_time;
+		if (n == 1 || usec_cmp(t->initial_time, max_time) > 0)
+			max_time = t->initial_time;
+	}
+
+	if (n < 4 || n > 5 || n > tp->num_slots)
+		return 0;
+	if (normal_active == n)
+		return n;
+	if (normal_active >= 2 &&
+	    (tp->gesture.multifinger_count >= 4 ||
+	     usec_cmp(usec_delta(max_time, min_time), usec_from_millis(350)) < 0))
+		return n;
+	return 0;
+}
+
+/* Compute radial dispersion and opposing (lowest-thumb vs upper-finger-cluster)
+ * span in mm. Both terms are strictly translation-invariant on rigid swipes,
+ * while opposing_mm preserves full vertical contraction on a 5-finger grab
+ * where 4 wide upper fingers would otherwise dilute the centroid spread.
+ */
+static double
+tp_gesture_multifinger_metrics(struct tp_dispatch *tp,
+			       struct device_float_coords *center,
+			       double *radial_out,
+			       double *opposing_out)
+{
+	const unsigned int n = tp->gesture.multifinger_count;
+	const struct tp_touch *thumb = tp->gesture.multifinger_thumb;
+	double radial = 0.0, opposing = 0.0;
+	struct device_float_coords upper = { 0.0, 0.0 };
+	unsigned int upper_n = 0;
+
+	*center = (struct device_float_coords){ 0.0, 0.0 };
+	for (unsigned int i = 0; i < n; i++) {
+		const struct device_coords point = tp->gesture.multifinger_touches[i]->point;
+		center->x += point.x;
+		center->y += point.y;
+		if (tp->gesture.multifinger_touches[i] != thumb) {
+			upper.x += point.x;
+			upper.y += point.y;
+			upper_n++;
+		}
+	}
+	center->x /= n;
+	center->y /= n;
+
+	for (unsigned int i = 0; i < n; i++) {
+		const struct device_coords point = tp->gesture.multifinger_touches[i]->point;
+		const struct device_float_coords delta = { point.x - center->x,
+							   point.y - center->y };
+		const struct phys_coords mm = tp_phys_delta(tp, delta);
+		radial += hypot(mm.x, mm.y);
+	}
+	radial /= n;
+
+	if (thumb && upper_n > 0) {
+		upper.x /= upper_n;
+		upper.y /= upper_n;
+		const struct device_float_coords opp_delta = {
+			upper.x - thumb->point.x,
+			upper.y - thumb->point.y,
+		};
+		const struct phys_coords opp_mm = tp_phys_delta(tp, opp_delta);
+		opposing = hypot(opp_mm.x, opp_mm.y);
+	} else {
+		opposing = radial;
+	}
+
+	if (radial_out)
+		*radial_out = radial;
+	if (opposing_out)
+		*opposing_out = opposing;
+	return 0.5 * radial + 0.5 * opposing;
+}
+
+static double
+tp_gesture_multifinger_spread(struct tp_dispatch *tp, struct device_float_coords *center)
+{
+	return tp_gesture_multifinger_metrics(tp, center, NULL, NULL);
+}
+
+static bool
+tp_gesture_record_multifinger_baseline(struct tp_dispatch *tp,
+				       struct tp_touch *const *touches,
+				       unsigned int ntouches,
+				       double current_scale)
+{
+	struct tp_touch *thumb = touches[0];
+	double radial = 0.0, opposing = 0.0, spread;
+
+	for (unsigned int i = 1; i < ntouches; i++) {
+		if (touches[i]->point.y >= thumb->point.y)
+			thumb = touches[i];
+	}
+	memcpy(tp->gesture.multifinger_touches, touches, ntouches * sizeof(touches[0]));
+	tp->gesture.multifinger_thumb = thumb;
+	tp->gesture.multifinger_count = ntouches;
+	spread = tp_gesture_multifinger_metrics(tp,
+						&tp->gesture.multifinger_initial_center,
+						&radial,
+						&opposing);
+	if (spread <= 0.0) {
+		tp->gesture.multifinger_count = 0;
+		tp->gesture.multifinger_thumb = NULL;
+		return false;
+	}
+	if (current_scale > 0.05 && current_scale != 1.0) {
+		tp->gesture.multifinger_initial_spread = spread / current_scale;
+		tp->gesture.multifinger_initial_radial = radial / current_scale;
+		tp->gesture.multifinger_initial_opposing = opposing / current_scale;
+		tp->gesture.initial_distance = tp->gesture.multifinger_initial_spread;
+		tp->gesture.center = tp->gesture.multifinger_initial_center;
+	} else {
+		tp->gesture.multifinger_initial_spread = spread;
+		tp->gesture.multifinger_initial_radial = radial;
+		tp->gesture.multifinger_initial_opposing = opposing;
+	}
+	return true;
+}
