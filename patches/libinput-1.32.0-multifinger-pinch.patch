+/* Four or more fingers: tell a pinch from a swipe by looking at all of them.
+ *
+ * The generic detection below only tracks the top-most and the bottom-most
+ * touch. With a whole hand pinching, the thumb usually travels much less than
+ * the fingers: that looked like a resting thumb (the thumb was suppressed and
+ * the gesture cancelled), or the two tracked touches happened to move in
+ * neighbouring directions and the pinch became a swipe.
+ *
+ * Here the spread of the hand (the mean distance of the touches from their
+ * common centre) is compared with the distance that centre has travelled.
+ * A swipe moves the centre and keeps the spread; a pinch changes the spread,
+ * even when its centre drifts towards the thumb.
+ *
+ * Returns 1 for a pinch, 0 for a swipe, -1 if it is too early to tell and
+ * -2 if the touches cannot be judged this way.
+ */
+#define MULTIFINGER_MAX_TOUCHES 5
+#define MULTIFINGER_PINCH_MM 2.5    /* spread change that makes a pinch */
+#define MULTIFINGER_SWIPE_MM 3.0    /* centre travel that makes a swipe */
+#define MULTIFINGER_PINCH_RATIO 0.35 /* spread change / centre travel */
+
+static int
+tp_gesture_classify_multifinger(struct tp_dispatch *tp)
+{
+	struct tp_touch *touches[MULTIFINGER_MAX_TOUCHES];
+	struct phys_coords initial[MULTIFINGER_MAX_TOUCHES];
+	struct phys_coords current[MULTIFINGER_MAX_TOUCHES];
+	struct phys_coords c0 = { 0.0, 0.0 }, c1 = { 0.0, 0.0 };
+	double spread0 = 0.0, spread1 = 0.0, change, travel;
+	unsigned int n, i;
+
+	n = tp_gesture_get_active_touches(tp, touches, MULTIFINGER_MAX_TOUCHES);
+	if (n < 4 || n != tp->gesture.multifinger_initial_count)
+		return -2;
+
+	for (i = 0; i < n; i++) {
+		struct device_coords p0 = touches[i]->gesture.initial;
+		struct device_coords p1 = touches[i]->point;
+
+		initial[i] = evdev_device_unit_delta_to_mm(tp->device, &p0);
+		current[i] = evdev_device_unit_delta_to_mm(tp->device, &p1);
+		c0.x += initial[i].x / n;
+		c0.y += initial[i].y / n;
+		c1.x += current[i].x / n;
+		c1.y += current[i].y / n;
+	}
+
+	for (i = 0; i < n; i++) {
+		spread0 += hypot(initial[i].x - c0.x, initial[i].y - c0.y) / n;
+		spread1 += hypot(current[i].x - c1.x, current[i].y - c1.y) / n;
+	}
+
+	change = fabs(spread1 - spread0);
+	travel = hypot(c1.x - c0.x, c1.y - c0.y);
+
+	if (change >= MULTIFINGER_PINCH_MM && change >= MULTIFINGER_PINCH_RATIO * travel)
+		return 1;
+	if (travel >= MULTIFINGER_SWIPE_MM && change < MULTIFINGER_PINCH_RATIO * travel)
+		return 0;
+
+	return -1;
+}
