diff --git i/MacShell/assets/tone-wall.sh w/MacShell/assets/tone-wall.sh
new file mode 100755
index 0000000..6652dc3
--- /dev/null
+++ w/MacShell/assets/tone-wall.sh
@@ -0,0 +1,17 @@
+#!/bin/sh
+# Prints "<brightness> <spread>" (same scale as tone.sh) of the strip of the wallpaper that sits behind the menu bar,
+# read from the image file. Unlike tone.sh it never grabs the screen, so the compositor is not stalled; MacBar.qml uses it
+# whenever nothing but the wallpaper is behind the bar.
+#   tone-wall.sh IMAGE SCREEN_W SCREEN_H BAR_H        (logical px; the wallpaper is assumed to cover the screen, centred)
+img=$1; W=$2; H=$3; B=$4
+[ -f "$img" ] && [ "$W" -gt 0 ] 2>/dev/null && [ "$H" -gt 0 ] 2>/dev/null && [ "$B" -gt 0 ] 2>/dev/null || exit 1
+# a quarter of the size is plenty for an average
+w=$((W / 4)); h=$((H / 4)); b=$((B / 4)); [ "$b" -ge 3 ] || b=3
+t=$(mktemp /tmp/macshell-tone.XXXXXX) || exit 1
+trap 'rm -f "$t"' EXIT
+magick "${img}[0]" -resize "${w}x${h}^" -gravity center -extent "${w}x${h}" -gravity north -crop "${w}x${b}+0+0" +repage "ppm:$t" 2>/dev/null || exit 1
+L='0.299*mean.r+0.587*mean.g+0.114*mean.b'
+D='0.299*standard_deviation.r+0.587*standard_deviation.g+0.114*standard_deviation.b'
+mo=$(magick "ppm:$t" -statistic Median 3x3 -format "%[fx:$L]" info: 2>/dev/null) || exit 1
+sd=$(magick "ppm:$t" -format "%[fx:$D]" info: 2>/dev/null) || exit 1
+echo "$mo $sd"
