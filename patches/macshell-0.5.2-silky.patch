+// drops one that comes from a touch ("Ignoring xdg_toplevel.move with an invalid serial"). So for touch the window is moved
+// through Hyprland's IPC instead. Hyprland fixes the touch origin at touch-down, so the finger's scene position keeps
+// growing while the window follows it and the offset from the press point is exactly how far the window has to travel.
+// Put it next to the pointer DragHandler, which must not accept PointerDevice.TouchScreen.
+DragHandler {
+    id: h
+    required property var win
+    target: null
+    acceptedDevices: PointerDevice.TouchScreen
+    property int sentX: 0          // how much of the offset Hyprland has already been told to move
+    property int sentY: 0
+    readonly property string sel: 'window = "title:^(' + win.title + ')$"'
+    function prop(value) { Hyprland.dispatch('hl.dsp.window.set_prop({ prop = "no_anim", value = "' + value + '", ' + sel + ' })'); }
+    function follow() {
+        var dx = Math.round(centroid.scenePosition.x - centroid.scenePressPosition.x) - sentX;
+        var dy = Math.round(centroid.scenePosition.y - centroid.scenePressPosition.y) - sentY;
+        if (dx === 0 && dy === 0) return;
+        sentX += dx; sentY += dy;
+        Hyprland.dispatch('hl.dsp.window.move({ x = ' + dx + ', y = ' + dy + ', relative = true, ' + sel + ' })');
+    }
+    onActiveChanged: {
+        if (active) { sentX = 0; sentY = 0; prop("1"); follow(); }      // no move animation: the window sticks to the finger
+        else prop("unset");
+    }
+    onCentroidChanged: if (active) follow()
+}
