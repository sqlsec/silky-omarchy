diff --git i/MacShell/macshell.lua w/MacShell/macshell.lua
index c0c1e72..424f9be 100644
--- i/MacShell/macshell.lua
+++ w/MacShell/macshell.lua
@@ -18,7 +18,9 @@ hl.bind("SUPER + period",     hl.dsp.exec_cmd(qs .. "spotlight emoji"))
 hl.bind("SUPER + Space",      hl.dsp.exec_cmd(qs .. "spotlight toggle"))
 hl.bind("ALT + TAB",          hl.dsp.exec_cmd(qs .. "switcher next"))
 hl.bind("CTRL + ALT + W",     hl.dsp.exec_cmd(qs .. "wallpapers toggle"))
-hl.bind("PRINT",              hl.dsp.exec_cmd(qs .. "screenshot region"))
+-- Silky Omarchy: PRINT stays with Omarchy's omasnap. Binding it here as well made one key press start two
+-- capture overlays that cancelled each other (first press seemed dead, then a second capture popped up).
+-- MacShell's own capture is still in the Control Center: qs -c MacShell ipc call screenshot region
 
 -- Hardware keys (laptop buttons too): volume, mute, brightness, media. MacShell handles them itself and shows its
 -- on-screen display. If the shell is not running, wpctl / brightnessctl do the work instead.
diff --git i/MacShell/shell.qml w/MacShell/shell.qml
index 9bb2572..069a6cf 100644
--- i/MacShell/shell.qml
+++ w/MacShell/shell.qml
@@ -44,10 +44,12 @@ ShellRoot {
         property var clock: clockApp
         property var about: aboutApp
         function openSettings(pane) { macDock.openPrefs(pane); }
+        function minimizeWindow(title) { macDock.minimizeWindow(title); }
 
         // set by MacBar / MacDock (Binding elements) when their glass needs live data
         property bool barWantsGeo: false
         property bool dockWantsGeo: false
+        property bool winBarWantsGeo: false
         property bool barWantsWallpaper: false
         property bool dockWantsWallpaper: false
         property bool widgetsWantWallpaper: false
@@ -163,7 +165,9 @@ ShellRoot {
         property bool geoHot: true
         property string lastActive: ""
         property string geoLast: ""
-        Timer { id: geoCool; interval: 1500; onTriggered: sharedHub.geoHot = false }
+        // A dragged window is composited directly by Hyprland; the glass geometry does not
+        // need to keep the GUI thread hot for another 1.5 seconds after every movement.
+        Timer { id: geoCool; interval: 700; onTriggered: sharedHub.geoHot = false }
         Connections {
             target: Hyprland
             function onRawEvent(event) {
@@ -240,7 +244,7 @@ ShellRoot {
         Timer {
             interval: sharedHub.geoHot ? 90 : 250
             repeat: true
-            running: (sharedHub.barWantsGeo || sharedHub.dockWantsGeo) && !sharedHub.ipcOk
+            running: (sharedHub.barWantsGeo || sharedHub.dockWantsGeo || sharedHub.winBarWantsGeo) && !sharedHub.ipcOk
             triggeredOnStart: true
             onTriggered: if (!geoProc.running) geoProc.running = true
         }
@@ -259,8 +263,9 @@ ShellRoot {
                 for (i = 0; i < ts.length; i++) { o = ts[i].lastIpcObject; if (o && o.address !== undefined) cl.push(o); }
                 for (i = 0; i < ms.length; i++) { m = ms[i].lastIpcObject; if (m && m.name !== undefined) mo.push(m); }
                 Hyprland.refreshToplevels();      // the answer lands in lastIpcObject and is read on the next tick
-                // monitors only change on workspace / monitor events (those refresh them right away, see onRawEvent): every 6th tick is plenty
-                if ((++monTick % 6) === 0) Hyprland.refreshMonitors();
+                // Monitor geometry is also refreshed immediately by the relevant raw events.
+                // Keep this only as a slow reconciliation path while a window is being dragged.
+                if ((++monTick % 12) === 0) Hyprland.refreshMonitors();
             } catch (err) { ipcBroken = true; ipcOk = false; return; }
             if (mo.length === 0 || (ts.length > 0 && cl.length === 0)) { ipcOk = false; return; }
             ipcOk = true;
@@ -304,10 +309,13 @@ ShellRoot {
             }
         }
         Timer {
-            // fast (60 Hz) for 1.5 s after any window event, otherwise a relaxed 2.5 Hz check (idle CPU)
-            interval: sharedHub.geoHot ? 16 : 400
+            // Hyprland itself moves the real window at the display refresh rate. This poll only
+            // updates the synthetic glass backdrop, so running it at 60 Hz competed with the
+            // compositor and caused an occasional hitch during circular window drags. Live glass
+            // gets 30 Hz; the current snapshot-based glass needs only 12.5 Hz while moving.
+            interval: sharedHub.geoHot ? ((macBar.glassRealtime || macDock.glassLive) ? 33 : 80) : 500
             repeat: true
-            running: (sharedHub.barWantsGeo || sharedHub.dockWantsGeo) && !sharedHub.ipcBroken
+            running: (sharedHub.barWantsGeo || sharedHub.dockWantsGeo || sharedHub.winBarWantsGeo) && !sharedHub.ipcBroken
             triggeredOnStart: true
             onTriggered: sharedHub.ipcPoll()
         }
@@ -318,6 +326,10 @@ ShellRoot {
             command: ["sh", "-c",
                 ""
                 + "out=\"\"\n"
+                // Omarchy 4.x owns the desktop wallpaper and stores the current choice here.
+                // Read it first so Liquid Glass follows the same image without a second daemon.
+                + "p=$(readlink -f \"$HOME/.local/state/omarchy/current/background\" 2>/dev/null)\n"
+                + "[ -f \"$p\" ] && out=\"wallpaper.default$(printf '\\t')$p\"\n"
                 + "st=\"${XDG_STATE_HOME:-$HOME/.local/state}/noctalia\"; ns=\"${NOCTALIA_STATE_HOME:-/nonexistent}\"\n"
                 + "for f in \"$ns/settings.toml\" \"$st/settings.toml\" \"$HOME/.config/noctalia/settings.toml\" \"$HOME/.config/noctalia/config.toml\"; do\n"
                 + "  [ -f \"$f\" ] || continue\n"
@@ -363,8 +375,12 @@ ShellRoot {
         }
     }
 
+    MinimizeFx { id: minimizeFx; hub: sharedHub }
     MacBar { id: macBar; hub: sharedHub }
-    MacDock { id: macDock; hub: sharedHub; bar: macBar }
+    MacDock { id: macDock; hub: sharedHub; bar: macBar; minimizeFx: minimizeFx }
+    // Client-side minimize requests are ignored by Hyprland. This small click-through overlay replaces only
+    // the traffic-light cluster, so Electron/GTK/Qt apps get the same reliable controls as server-decorated apps.
+    WindowBar { id: windowBar; hub: sharedHub }
     // Keep the desktop layer below widgets; desktop placement also reserves each widget's live footprint.
     Desktop { id: desktopIcons; hub: sharedHub }
     MacWidgets { id: macWidgets; hub: sharedHub }
@@ -423,4 +439,10 @@ ShellRoot {
         target: "glass"
         function captures(on: bool): void { macDock.windowCapture = on; }
     }
+    // Used by hyprbars and any external titlebar: every minimize path goes through the same capture + genie effect.
+    IpcHandler {
+        target: "window"
+        function minimize(address: string): void { macDock.minimizeAddress(address); }
+        function restore(address: string): void { macDock.restoreAddress(address); }
+    }
 }
