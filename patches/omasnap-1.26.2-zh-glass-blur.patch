+QImage sampleFrostedBlur(const QImage &image, const QRect &region, int level,
+                         qreal scaleX, qreal scaleY) {
+  constexpr std::array deviations{8.0, 17.0, 31.0};
+  const qreal sigma = deviations.at(static_cast<std::size_t>(level - 1));
+  const qreal logicalWidth = region.width() / scaleX;
+  const qreal logicalHeight = region.height() / scaleY;
+  // Keep several samples per standard deviation and bound the working set
+  // during a drag, including fullscreen selections and long scroll captures.
+  constexpr qreal pixelBudget = 180000.0;
+  const qreal spacing = std::max(
+      {1.0, sigma / 7.0, std::sqrt(logicalWidth * logicalHeight / pixelBudget),
+       logicalWidth / 1280.0, logicalHeight / 1280.0});
+  const QSize size(std::clamp(qRound(logicalWidth / spacing), 1, region.width()),
+                   std::clamp(qRound(logicalHeight / spacing), 1, region.height()));
+  QImage field = image.copy(region).scaled(size, Qt::IgnoreAspectRatio,
+                                          Qt::SmoothTransformation)
+                     .convertToFormat(QImage::Format_RGB32);
+  QImage scratch(size, QImage::Format_RGB32);
+  if (field.isNull() || scratch.isNull())
+    return {};
+
+  // Three box convolutions approximate a Gaussian. A box has variance
+  // radius * (radius + 1) / 3, so three passes give the desired variance.
+  const auto boxRadius = [sigma](qreal pixelsPerLogicalPixel) {
+    const qreal deviation = sigma * pixelsPerLogicalPixel;
+    return qRound(std::sqrt(deviation * deviation + 0.25) - 0.5);
+  };
+  const int radiusX = boxRadius(size.width() / logicalWidth);
+  const int radiusY = boxRadius(size.height() / logicalHeight);
+  for (int pass = 0; pass < 3; ++pass) {
+    glassBlurPass(field, scratch, radiusX, true);
+    glassBlurPass(scratch, field, radiusY, false);
+  }
+
+  // An even veil softens saturation and lifts shadows across the filtered
+  // image. The alpha stays opaque when the result replaces the source pixels.
+  for (int y = 0; y < size.height(); ++y) {
+    auto *row = reinterpret_cast<QRgb *>(field.scanLine(y));
+    for (int x = 0; x < size.width(); ++x) {
+      const QRgb pixel = row[x];
+      const int luma = (54 * qRed(pixel) + 183 * qGreen(pixel) +
+                        19 * qBlue(pixel) + 128) / 256;
+      const int veil = 21 * luma + 10 * 255 + 100;
+      row[x] = qRgb((169 * qRed(pixel) + veil) / 200,
+                    (169 * qGreen(pixel) + veil) / 200,
+                    (169 * qBlue(pixel) + veil) / 200);
+    }
+  }
+  return field;
 }
 
