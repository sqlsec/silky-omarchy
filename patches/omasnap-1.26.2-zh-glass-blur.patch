+void glassBlurPass(const QImage &input, QImage &output, int radius,
+                   bool horizontal) {
+  const int length = horizontal ? input.width() : input.height();
+  const int count = horizontal ? input.height() : input.width();
+  const qsizetype pitch = input.bytesPerLine() / sizeof(QRgb);
+  const qsizetype step = horizontal ? 1 : pitch;
+  const qsizetype stride = horizontal ? pitch : 1;
+  const auto *src = reinterpret_cast<const QRgb *>(input.constBits());
+  auto *dst = reinterpret_cast<QRgb *>(output.bits());
+  const int diameter = 2 * radius + 1;
+  // Fixed-point reciprocal keeps division out of the pixel loop.
+  constexpr int reciprocalScale = 1 << 20;
+  const int multiplier = (reciprocalScale + diameter / 2) / diameter;
+  const auto average = [multiplier](int sum) {
+    return (sum * multiplier + reciprocalScale / 2) / reciprocalScale;
+  };
+
+  // Reflect only pixels inside the selection. Samples beyond either edge
+  // share the same kernel as the interior without repeating the border row.
+  const auto reflect = [length](int position) {
+    if (length == 1)
+      return 0;
+    const int period = 2 * (length - 1);
+    const int offset = std::abs(position) % period;
+    return std::min(offset, period - offset);
+  };
+  QVector<qsizetype> indices(length + 2 * radius);
+  for (int i = 0; i < indices.size(); ++i)
+    indices[i] = reflect(i - radius) * step;
+  const auto *offsets = indices.constData();
+
+  for (int line = 0; line < count; ++line) {
+    const auto *sourceLine = src + line * stride;
+    auto *targetLine = dst + line * stride;
+    int red = 0;
+    int green = 0;
+    int blue = 0;
+    for (int i = 0; i < diameter; ++i) {
+      const QRgb pixel = sourceLine[offsets[i]];
+      red += qRed(pixel);
+      green += qGreen(pixel);
+      blue += qBlue(pixel);
+    }
+    for (int i = 0; i < length; ++i) {
+      targetLine[i * step] = qRgb(average(red), average(green), average(blue));
+      if (i + 1 == length)
+        break;
+      const QRgb leaving = sourceLine[offsets[i]];
+      const QRgb entering = sourceLine[offsets[i + diameter]];
+      red += qRed(entering) - qRed(leaving);
+      green += qGreen(entering) - qGreen(leaving);
+      blue += qBlue(entering) - qBlue(leaving);
+    }
+  }
+}
