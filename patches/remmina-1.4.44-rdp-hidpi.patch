HiDPI rendering for Remmina 1.4.44 RDP dynamic resolution (silky-omarchy).
Applies with: patch -p1 in the Remmina-v1.4.44 source tree.

--- a/plugins/rdp/rdp_event.c
+++ b/plugins/rdp/rdp_event.c
@@ -263,6 +263,22 @@
 }
 
 
+/* HiDPI (silky-omarchy): in dynamic resolution mode, ask the server for the
+ * widget size in device pixels and draw the remote desktop through the
+ * scaled path at 1 / scale factor, so a scale-2 Wayland output shows the
+ * remote screen 1:1 and sharp instead of every remote pixel doubled.
+ * The remote UI size is then chosen with "Desktop scale factor %". */
+static gint remmina_rdp_event_hidpi_factor(RemminaProtocolWidget *gp, rfContext *rfi)
+{
+	if (rfi->scale != REMMINA_PROTOCOL_WIDGET_SCALE_MODE_DYNRES)
+		return 1;
+	return MAX(1, gtk_widget_get_scale_factor(GTK_WIDGET(gp)));
+}
+
+#define REMMINA_RDP_DRAW_SCALED(rfi) \
+	((rfi)->scale == REMMINA_PROTOCOL_WIDGET_SCALE_MODE_SCALED || \
+	 ((rfi)->scale == REMMINA_PROTOCOL_WIDGET_SCALE_MODE_DYNRES && (rfi)->scale_width >= 1 && (rfi)->scale_height >= 1))
+
 static void remmina_rdp_event_scale_area(RemminaProtocolWidget *gp, gint *x, gint *y, gint *w, gint *h)
 {
 	TRACE_CALL(__func__);
@@ -333,7 +349,7 @@
 		w = ui->reg.ureg[i].w;
 		h = ui->reg.ureg[i].h;
 
-		if (rfi->scale == REMMINA_PROTOCOL_WIDGET_SCALE_MODE_SCALED)
+		if (REMMINA_RDP_DRAW_SCALED(rfi))
 			remmina_rdp_event_scale_area(gp, &x, &y, &w, &h);
 		else
 			remmina_rdp_event_pad_redraw_area(gp, &x, &y, &w, &h);
@@ -374,7 +390,8 @@
 	gpwidth = a.width;
 	gpheight = a.height;
 
-	if (rfi->scale == REMMINA_PROTOCOL_WIDGET_SCALE_MODE_SCALED) {
+	if (rfi->scale == REMMINA_PROTOCOL_WIDGET_SCALE_MODE_SCALED ||
+	    remmina_rdp_event_hidpi_factor(gp, rfi) > 1) {
 		if ((gpwidth > 1) && (gpheight > 1)) {
 			rdwidth = remmina_plugin_service->protocol_plugin_get_width(gp);
 			rdheight = remmina_plugin_service->protocol_plugin_get_height(gp);
@@ -409,7 +426,7 @@
 	if (!rfi->surface)
 		return FALSE;
 
-	if (rfi->scale == REMMINA_PROTOCOL_WIDGET_SCALE_MODE_SCALED)
+	if (REMMINA_RDP_DRAW_SCALED(rfi))
 		cairo_scale(context, rfi->scale_x, rfi->scale_y);
 
 	gint n_monitors = remmina_plugin_service->plugin_multimon_monitor_count(gp);
@@ -473,7 +490,7 @@
 		if (!rfi->surface)
 			return FALSE;
 
-		if (rfi->scale == REMMINA_PROTOCOL_WIDGET_SCALE_MODE_SCALED)
+		if (REMMINA_RDP_DRAW_SCALED(rfi))
 			cairo_scale(context, rfi->scale_x, rfi->scale_y);
 
 		cairo_surface_flush(rfi->surface);
@@ -521,8 +538,8 @@
 	if (rfi->dispcontext != NULL) {
 		remmina_rdp_settings_get_orientation_scale_prefs(&desktopOrientation, &desktopScaleFactor, &deviceScaleFactor);
 		gtk_widget_get_allocation(GTK_WIDGET(gp), &a);
-		gpwidth = a.width;
-		gpheight = a.height;
+		gpwidth = a.width * remmina_rdp_event_hidpi_factor(gp, rfi);
+		gpheight = a.height * remmina_rdp_event_hidpi_factor(gp, rfi);
 		prevwidth = remmina_plugin_service->protocol_plugin_get_width(gp);
 		prevheight = remmina_plugin_service->protocol_plugin_get_height(gp);
 		gint num_monitors = freerdp_settings_get_uint32(rfi->clientContext.context.settings, FreeRDP_MonitorCount);
@@ -641,7 +658,7 @@
 		remmina_rdp_event_apply_cursor(rfi, w);
 	}
 
-	if ((rfi->scale == REMMINA_PROTOCOL_WIDGET_SCALE_MODE_SCALED) && (rfi->scale_width >= 1) && (rfi->scale_height >= 1)) {
+	if (REMMINA_RDP_DRAW_SCALED(rfi) && (rfi->scale_width >= 1) && (rfi->scale_height >= 1)) {
 		*ox = (UINT16)(ix * remmina_plugin_service->protocol_plugin_get_width(gp) / rfi->scale_width) + delta_x - rfi->orig_shift_x;
 		*oy = (UINT16)(iy * remmina_plugin_service->protocol_plugin_get_height(gp) / rfi->scale_height) + delta_y - rfi->orig_shift_y;
 	} else {
@@ -663,7 +680,7 @@
 	if (!rfi || !rfi->connected || rfi->is_reconnecting)
 		return;
 
-	if ((rfi->scale == REMMINA_PROTOCOL_WIDGET_SCALE_MODE_SCALED) && (rfi->scale_width >= 1) && (rfi->scale_height >= 1)) {
+	if (REMMINA_RDP_DRAW_SCALED(rfi) && (rfi->scale_width >= 1) && (rfi->scale_height >= 1)) {
 		*ox = (ix * rfi->scale_width) / remmina_plugin_service->protocol_plugin_get_width(gp);
 		*oy = (iy * rfi->scale_height) / remmina_plugin_service->protocol_plugin_get_height(gp);
 	} else {
@@ -1449,6 +1466,8 @@
 	gtk_widget_queue_draw_area(rfi->drawing_area, 0, 0, gdi->width, gdi->height);
 
 	remmina_rdp_event_update_scale(gp);
+	/* The first resolution comes from the logical window size; correct it for HiDPI. */
+	remmina_rdp_event_send_delayed_monitor_layout(gp);
 
 	remmina_plugin_service->protocol_plugin_signal_connection_opened(gp);
 	const gchar *host = freerdp_settings_get_string (rfi->clientContext.context.settings, FreeRDP_ServerHostname);
@@ -1489,7 +1508,16 @@
 	cairo_surface_mark_dirty(surface);
 	cairo_surface_destroy(surface);
 	free(data);
-	((rfPointer *)ui->cursor.pointer)->cursor = gdk_cursor_new_from_pixbuf(rfi->display, pixbuf, pointer->xPos, pointer->yPos);
+	gint hidpi = remmina_rdp_event_hidpi_factor(gp, rfi);
+	if (hidpi > 1) {
+		/* Remote pointer bitmaps are in remote (device) pixels too. */
+		cairo_surface_t *cursor_surface = gdk_cairo_surface_create_from_pixbuf(pixbuf, hidpi, NULL);
+		((rfPointer *)ui->cursor.pointer)->cursor = gdk_cursor_new_from_surface(rfi->display, cursor_surface,
+											(gdouble)pointer->xPos / hidpi, (gdouble)pointer->yPos / hidpi);
+		cairo_surface_destroy(cursor_surface);
+	} else {
+		((rfPointer *)ui->cursor.pointer)->cursor = gdk_cursor_new_from_pixbuf(rfi->display, pixbuf, pointer->xPos, pointer->yPos);
+	}
 	g_object_unref(pixbuf);
 
 	return TRUE;
