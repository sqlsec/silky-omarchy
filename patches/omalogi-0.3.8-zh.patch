diff --git i/install.sh w/install.sh
index c116c4a..6ada5fa 100755
--- i/install.sh
+++ w/install.sh
@@ -32,6 +32,11 @@ die() { printf 'omalogi install: %s\n' "$*" >&2; exit 1; }
 [ "$(uname -s)" = Linux ] || die "Omalogi runs on Linux"
 case "$(uname -m)" in
   x86_64) target=x86_64-unknown-linux-gnu ;;
+  aarch64)
+    # Silky Omarchy：ARM 没有官方预编译助手，交给 silky-omarchy 的源码构建脚本（它会登记自己的位置）
+    silky=${XDG_DATA_HOME:-$HOME/.local/share}/silky-omarchy/install-omalogi.sh
+    [ -x "$silky" ] && exec "$silky" "$@"
+    die "ARM（aarch64）没有官方预编译助手：在 silky-omarchy 仓库运行 ./scripts/install-omalogi.sh，从源码构建并安装汉化版" ;;
   *) die "there is no prebuilt binary for $(uname -m) yet; install from the AUR (omalogi) or with cargo" ;;
 esac
 for tool in curl tar sha256sum install; do
