diff --git a/MacShell/assets/about-info.sh b/MacShell/assets/about-info.sh
index 16e0f12..cd775bd 100755
--- a/MacShell/assets/about-info.sh
+++ b/MacShell/assets/about-info.sh
@@ -45,11 +45,23 @@ printf 'sub=%s\n' "$kind${vend:+ · $vend}"
 cpu=$(awk -F: '/^model name/ {print $2; exit}' /proc/cpuinfo 2>/dev/null)
 [ -n "$cpu" ] || cpu=$(lscpu 2>/dev/null | sed -n 's/^Model name: *//p' | head -n1)
 [ -n "$cpu" ] || cpu=$(awk -F: '/^(Hardware|Processor|cpu model)/ {print $2; exit}' /proc/cpuinfo 2>/dev/null)
+# On ARM64, /proc/cpuinfo may omit a marketing name and sandboxed GUI launches may
+# not get lscpu's translated field names. The platform compatible is always available.
+if [ -z "$cpu" ]; then
+    platform_compat=$(tr '\0' ',' </proc/device-tree/compatible 2>/dev/null)
+    case "$platform_compat" in *qcom,x1e80100*) cpu="Qualcomm Oryon" ;; esac
+fi
 cpu=$(printf %s "$cpu" | sed -e 's/(R)//g; s/(TM)//g; s/ CPU / /; s/ CPU$//; s/ @ .*//; s/ with Radeon.*//; s/ w\/ .*//; s/  */ /g; s/^ //; s/ $//')
+cpu_vendor=$(lscpu 2>/dev/null | sed -n 's/^Vendor ID: *//p' | head -n1)
+# ARM machines often expose only the microarchitecture name. Keep it useful and human-readable.
+case "$cpu_vendor:$cpu" in
+    Qualcomm:Oryon|Qualcomm:"Qualcomm Oryon") cpu="Qualcomm Oryon" ;;
+esac
 threads=$(nproc --all 2>/dev/null || grep -c '^processor' /proc/cpuinfo)
 cores=$(lscpu -p=CORE,SOCKET 2>/dev/null | grep -v '^#' | sort -u | wc -l)
 printf 'cpu=%s\n' "${cpu:-Unknown}"
 if [ "${cores:-0}" -gt 0 ] 2>/dev/null && [ "${threads:-0}" -gt 0 ] 2>/dev/null; then
+    printf 'cpucount=%s\nthreadcount=%s\n' "$cores" "$threads"
     if [ "$cores" = "$threads" ]; then printf 'cpusub=%s cores\n' "$cores"; else printf 'cpusub=%s cores, %s threads\n' "$cores" "$threads"; fi
 fi
 
@@ -70,6 +82,20 @@ if [ -z "$gpu" ]; then
         [ -n "$n" ] && gpu="${gpu:+$gpu|}$n"
     done
 fi
+# Integrated Qualcomm GPUs are platform devices, not PCI devices. Identify the stable
+# device-tree compatible used by Snapdragon X Elite / X1E80100 systems.
+if [ -z "$gpu" ]; then
+    gpu_compat=""
+    for f in /proc/device-tree/soc@0/gpu@*/compatible /sys/firmware/devicetree/base/soc@0/gpu@*/compatible; do
+        [ -r "$f" ] || continue
+        gpu_compat=$(tr '\0' ',' < "$f" 2>/dev/null)
+        [ -n "$gpu_compat" ] && break
+    done
+    case "$gpu_compat" in
+        *qcom,adreno-43050c01*) gpu="Qualcomm Adreno X1-85" ;;
+        *qcom,adreno*) gpu="Qualcomm Adreno" ;;
+    esac
+fi
 printf 'gpu=%s\n' "${gpu:-Unknown}"
 
