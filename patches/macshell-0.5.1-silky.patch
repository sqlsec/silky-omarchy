     for (i = 1; i <= n; i++) if (s[i] >= g) { r = s[i]; break }
     printf "mem=%d GB\n", r }' /proc/meminfo
+# Prefer the speed reported by the running machine. Some ARM64 firmware exposes
+# this through DMI/inxi but not through the usual sysfs memory attributes.
+memspeed=""
+if command -v inxi >/dev/null 2>&1; then
+    memspeed=$(inxi -m -c 0 2>/dev/null | sed -n 's/.* speed: \([0-9][0-9]* MT\/s\).*/\1/p' | head -n1)
+fi
+# Lenovo's PSREF specifies LPDDR5X-8448 for this exact model. Keep this narrow
+# fallback for launches where the desktop process cannot read the DMI memory data.
+if [ -z "$memspeed" ]; then
+    case "$model" in *"Yoga Slim 7 14Q8X9"*) memspeed="8448 MT/s" ;; esac
+fi
+printf 'memspeed=%s\n' "$memspeed"
 # ── storage: the disk holding / ──
 df -B1 --output=size,avail / 2>/dev/null | awk 'NR==2 {
     t=$1; a=$2
